<footer style="border-top: 1px solid rgba(212, 175, 55, 0.3); padding: 3rem 0 2rem 0; margin-top: auto; text-align: center; background-color: #000;">
    <div class="container">
        
        {# La boucle qui génère les liens dynamiquement #}
        <div class="d-flex justify-content-center flex-wrap gap-4 mb-3">
            {% for page in pages %}
                <a href="{{ path('app_page_show', {'slug': page.slug}) }}" class="footer-link">
                    {{ page.titre }}
                </a>
            {% endfor %}
            {# Tu peux aussi ajouter un lien statique vers la page contact ici si besoin #}
        </div>

        <p style="color: #666; font-size: 0.85rem; font-weight: 300; margin-bottom: 0;">
            &copy; {{ 'now'|date('Y') }} Metamorphysis. Tous droits réservés.
        </p>
    </div>
</footer>

<style>
    .footer-link {
        color: #999;
        text-decoration: none;
        font-weight: 300;
        font-size: 0.95rem;
        transition: color 0.3s ease;
    }
    .footer-link:hover {
        color: #D4AF37; /* Devient or au survol */
    }
</style>