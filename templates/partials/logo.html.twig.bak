<script>
    // Ce script cible tous les tracés de ta libellule
    const paths = document.querySelectorAll('svg path');
    
    paths.forEach((path, index) => {
        // 1. Il donne une couleur aléatoire à CHAQUE morceau
        path.style.fill = `hsl(${index * 137.5}, 70%, 50%)`; 
        path.style.cursor = 'pointer';

        // 2. Il crée une alerte avec le numéro exact quand tu cliques dessus
        path.addEventListener('click', () => {
            alert("C'est le <path> numéro : " + index);
            path.style.fill = 'black'; // Devient noir pour repérer ce que tu as déjà cliqué
        });
    });
</script>