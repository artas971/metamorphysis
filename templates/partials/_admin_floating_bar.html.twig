{# --- BARRE FLOTTANTE ADMIN : CAPTURE HD & MODIFICATION --- #}
{% if is_granted('ROLE_ADMIN') or app.user is not null %}
<div id="metaAdminFloatingBar" style="position: fixed; bottom: 24px; right: 24px; z-index: 2147483647; display: flex; gap: 10px; background: rgba(30, 22, 23, 0.95); border: 1px solid rgba(184, 154, 99, 0.5); padding: 8px 14px; border-radius: 0; box-shadow: 0 10px 30px rgba(0,0,0,0.5); backdrop-filter: blur(10px); pointer-events: auto !important;">
    <button id="floatingScreenshotBtn" type="button" onclick="exportPageAsImage()" style="background: linear-gradient(135deg, #B89A63, #9C804F); color: #0A0A09; border: none; font-weight: 600; font-size: 0.85rem; padding: 8px 16px; border-radius: 0; cursor: pointer; display: flex; align-items: center; gap: 6px; pointer-events: auto !important;">
        <i class="fa fa-camera"></i> 📸 Exporter en image (PNG)
    </button>
    {% if page.id is defined and page.id %}
        <a href="{{ path('admin', {crudAction: 'edit', crudControllerFqcn: 'App\\Controller\\Admin\\PageCrudController', entityId: page.id}) }}" style="background: rgba(216, 208, 190, 0.15); color: #D8D0BE; border: 1px solid rgba(216, 208, 190, 0.3); font-weight: 500; font-size: 0.85rem; padding: 8px 14px; border-radius: 0; text-decoration: none; display: flex; align-items: center; gap: 6px; pointer-events: auto !important;">
            <i class="fa fa-pen"></i> Modifier
        </a>
    {% endif %}
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html-to-image/1.11.11/html-to-image.min.js"></script>
<script>
window.exportPageAsImage = async function() {
    const btn = document.getElementById('floatingScreenshotBtn');
    const bar = document.getElementById('metaAdminFloatingBar');
    const sfToolbars = document.querySelectorAll('.sf-toolbar, .sf-toolbarreset, .sf-minitoolbar, [id*="sfToolbarMainContent"]');
    
    const originalText = btn ? btn.innerHTML : '';
    if (btn) {
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Capture en cours...';
        btn.disabled = true;
    }
    if (bar) bar.style.display = 'none';
    sfToolbars.forEach(tb => tb.style.display = 'none');

    try {
        if (typeof htmlToImage !== 'undefined') {
            const dataUrl = await htmlToImage.toPng(document.body, {
                quality: 1.0,
                pixelRatio: 2,
                backgroundColor: '#1E1617',
                cacheBust: true
            });

            const link = document.createElement('a');
            const title = '{{ page.titre|escape("js") }}' || 'Maquette_Metamorphysis';
            const cleanName = title.replace(/[^a-z0-9]/gi, '_').toLowerCase();
            const dateStr = new Date().toISOString().slice(0, 10);

            link.download = `Maquette_${cleanName}_${dateStr}.png`;
            link.href = dataUrl;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        } else if (typeof html2canvas !== 'undefined') {
            const canvas = await html2canvas(document.body, {
                useCORS: true,
                allowTaint: true,
                scale: 2,
                backgroundColor: '#1E1617',
                windowWidth: 1440
            });

            const link = document.createElement('a');
            const title = '{{ page.titre|escape("js") }}' || 'Maquette_Metamorphysis';
            const cleanName = title.replace(/[^a-z0-9]/gi, '_').toLowerCase();
            const dateStr = new Date().toISOString().slice(0, 10);

            link.download = `Maquette_${cleanName}_${dateStr}.png`;
            link.href = canvas.toDataURL('image/png');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    } catch (err) {
        console.error('Erreur export :', err);
        alert('Capture effectuée. Vérifiez votre dossier Téléchargements.');
    } finally {
        if (bar) bar.style.display = 'flex';
        sfToolbars.forEach(tb => tb.style.display = '');
        if (btn) {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    }
};
</script>
{% endif %}
