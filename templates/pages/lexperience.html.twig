{% extends 'base.html.twig' %}

{% block title %}L'Expérience | Metamorphysis{% endblock %}
{% block meta_description %}Vivez l'expérience Métamorphysis : un parcours de transformation en 5 étapes fondé sur l'analyse transactionnelle et la conscience de soi.{% endblock %}

{% block body %}
<div class="container position-relative my-4">
    <!-- PANNEAU VERT OLIVE UNIFIÉ -->
    <div class="bg-olive-premium shadow-lg rounded-0 position-relative" style="background-color: var(--meta-olive); border-radius: 0 !important;">
        
        <!-- BLOC 1 : INTRODUCTION & VASE (CADRE POURPRE DE 140PX À GAUCHE, COLLÉ À DROITE) -->
        <section class="w-100 position-relative" style="padding-top: 48px; padding-bottom: 48px; padding-left: 48px; padding-right: 0px; box-sizing: border-box;">
            <div class="row align-items-start g-4 g-lg-5 justify-content-between me-0">
                
                <!-- COLONNE TEXTE -->
                <div class="col-lg-6 order-2 order-lg-1 content-premium text-start pt-lg-2" style="z-index: 2;">
                    <h1 class="typo-titre fw-light mb-2" style="font-size: 2.8rem; line-height: 1.15; letter-spacing: 3px; color: var(--meta-gold);">
                        L'EXPÉRIENCE
                    </h1>
                    <div class="mb-4" style="letter-spacing: 2.5px; font-size: 0.95rem; line-height: 1.5; text-transform: uppercase; font-weight: 500; color: var(--meta-gold-hover);">
                        - γνῶθι σεαυτόν - CONNAIS-TOI TOI-MÊME
                    </div>
                    <div class="content-premium mb-0" style="line-height: 1.8; font-size: 1.05rem; opacity: 0.92; color: var(--meta-ivory);">
                        <p class="fw-light mb-4 text-ivory">
                            Grâce à l'analyse transactionnelle, nous mettons en lumière les schémas inconscients qui influencent vos relations, vos choix et votre bien-être.
                        </p>
                        <p class="fw-light mb-0 text-ivory">
                            Comprendre. Transformer. Se libérer.<br>
                            Redevenir auteur de sa propre vie.
                        </p>
                    </div>
                </div>

                <!-- COLONNE PHOTO VASE (CADRE POURPRE DE 140PX À DROITE DE LA PHOTO) -->
                <div class="col-lg-6 order-1 order-lg-2 position-relative mt-4 mt-lg-0 pe-0" style="z-index: 1;">
                    <div class="position-relative w-100" style="transform: translate(0%, 0px); transition: transform 0.3s ease;">
                        <div class="position-relative shadow-lg w-100" style="background-color: var(--meta-plum); padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 140px; box-sizing: border-box; border-radius: 0;">
                            <img src="{{ asset('uploads/pages/vase-6a8848bee1143198493651.jpg') }}" 
                                 alt="Illustration L'Expérience - Metamorphysis" 
                                 loading="lazy"
                                 decoding="async"
                                 class="img-fluid d-block shadow-sm" 
                                 style="width: 100%; height: auto; object-fit: cover; border-radius: 0;">
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- BLOC 2 : LE PROCESSUS (GRILLE DE 5 COLONNES) -->
        <section class="w-100 position-relative" style="padding-top: 48px; padding-bottom: 48px; padding-left: 48px; padding-right: 48px; box-sizing: border-box;">
            
            <div class="d-flex align-items-center gap-3 mb-5">
                <div>
                    <h2 class="text-uppercase typo-titre h5 mb-0" style="letter-spacing: 2.5px; font-size: 1.15rem; font-weight: 500; color: var(--meta-gold-hover);">
                        LE PROCESSUS
                    </h2>
                </div>
                <div class="flex-grow-1" style="height: 1px; background: rgba(var(--meta-gold-rgb, 184, 154, 99), 0.35);" aria-hidden="true"></div>
            </div>

            <!-- LES 5 PILIERS -->
            <div class="row g-4 justify-content-center position-relative text-center pt-2">
                
                <!-- 1. OBSERVER -->
                <article class="col-12 col-sm-6 col-lg position-relative z-1">
                    <div class="h-100 py-3 px-2 d-flex flex-column align-items-center text-center">
                        <div class="mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive); color: var(--meta-gold);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#B89A63" viewBox="0 0 16 16"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/></svg>
                            </div>
                        </div>
                        <span class="typo-symbolic mb-1 d-block fw-bold" style="color: var(--meta-gold); font-size: 1.1rem; letter-spacing: 2px;">01</span>
                        <h3 class="fs-6 letter-spacing-1 mb-3 text-uppercase" style="color: var(--meta-gold-hover); font-weight: 500; letter-spacing: 1.5px;">OBSERVER</h3>
                        <div class="content-premium mb-0 text-ivory" style="opacity: 0.92; font-size: 0.92rem; line-height: 1.6;">
                            Prendre conscience<br>de ses schémas<br>et fonctionnements<br>répétitifs.
                        </div>
                    </div>
                </article>

                <!-- 2. COMPRENDRE -->
                <article class="col-12 col-sm-6 col-lg position-relative z-1">
                    <div class="h-100 py-3 px-2 d-flex flex-column align-items-center text-center">
                        <div class="mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive); color: var(--meta-gold);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#B89A63" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/>
                                    <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/>
                                    <path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/>
                                    <path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/>
                                    <path d="M6.002 5.125A3 3 0 0 0 6.401 6.5"/>
                                    <path d="M3.477 10.896a4 4 0 0 1 .585-.396"/>
                                    <path d="M19.938 10.5a4 4 0 0 1 .585.396"/>
                                    <path d="M6 18a4 4 0 0 1-1.967-.516"/>
                                    <path d="M19.967 17.484A4 4 0 0 1 18 18"/>
                                </svg>
                            </div>
                        </div>
                        <span class="typo-symbolic mb-1 d-block fw-bold" style="color: var(--meta-gold); font-size: 1.1rem; letter-spacing: 2px;">02</span>
                        <h3 class="fs-6 letter-spacing-1 mb-3 text-uppercase" style="color: var(--meta-gold-hover); font-weight: 500; letter-spacing: 1.5px;">COMPRENDRE</h3>
                        <div class="content-premium mb-0 text-ivory" style="opacity: 0.92; font-size: 0.92rem; line-height: 1.6;">
                            Identifier les origines,<br>les blessures et les<br>messages cachés<br>derrière les comportements.
                        </div>
                    </div>
                </article>

                <!-- 3. CONFRONTER -->
                <article class="col-12 col-sm-6 col-lg position-relative z-1">
                    <div class="h-100 py-3 px-2 d-flex flex-column align-items-center text-center">
                        <div class="mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive); color: var(--meta-gold);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#B89A63" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M7 4a5 5 0 0 0-4 4.8c0 2.5 1.5 4.6 3.6 5.3L6 18h2"/>
                                    <path d="M17 4a5 5 0 0 1 4 4.8c0 2.5-1.5 4.6-3.6 5.3L18 18h-2"/>
                                    <line x1="12" y1="3" x2="12" y2="21" stroke-dasharray="2 2" stroke-width="1.5"/>
                                    <circle cx="8" cy="8.5" r="0.75" fill="#B89A63"/>
                                    <circle cx="16" cy="8.5" r="0.75" fill="#B89A63"/>
                                </svg>
                            </div>
                        </div>
                        <span class="typo-symbolic mb-1 d-block fw-bold" style="color: var(--meta-gold); font-size: 1.1rem; letter-spacing: 2px;">03</span>
                        <h3 class="fs-6 letter-spacing-1 mb-3 text-uppercase" style="color: var(--meta-gold-hover); font-weight: 500; letter-spacing: 1.5px;">CONFRONTER</h3>
                        <div class="content-premium mb-0 text-ivory" style="opacity: 0.92; font-size: 0.92rem; line-height: 1.6;">
                            Accueillir la vérité,<br>sortir des mécanismes<br>de protection<br>et d'évitement.
                        </div>
                    </div>
                </article>

                <!-- 4. TRANSFORMER -->
                <article class="col-12 col-sm-6 col-lg position-relative z-1">
                    <div class="h-100 py-3 px-2 d-flex flex-column align-items-center text-center">
                        <div class="mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive); color: var(--meta-gold);">
                                <img src="{{ asset('images/libellule.svg') }}" alt="" style="width: 44px; height: 44px; object-fit: contain; display: block;" onerror="this.outerHTML='<i class=\'bi bi-flower1 text-gold fs-3\'></i>'">
                            </div>
                        </div>
                        <span class="typo-symbolic mb-1 d-block fw-bold" style="color: var(--meta-gold); font-size: 1.1rem; letter-spacing: 2px;">04</span>
                        <h3 class="fs-6 letter-spacing-1 mb-3 text-uppercase" style="color: var(--meta-gold-hover); font-weight: 500; letter-spacing: 1.5px;">TRANSFORMER</h3>
                        <div class="content-premium mb-0 text-ivory" style="opacity: 0.92; font-size: 0.92rem; line-height: 1.6;">
                            Reprogrammer<br>de nouveaux choix,<br>alignés avec<br>qui vous êtes vraiment.
                        </div>
                    </div>
                </article>

                <!-- 5. S'ALIGNER -->
                <article class="col-12 col-sm-6 col-lg position-relative z-1">
                    <div class="h-100 py-3 px-2 d-flex flex-column align-items-center text-center">
                        <div class="mb-3">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive); color: var(--meta-gold);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#B89A63" viewBox="0 0 16 16"><path d="M8.5.5a.5.5 0 0 0-1 0v.518A7.001 7.001 0 0 0 1.018 7.5H.5a.5.5 0 0 0 0 1h.518A7.001 7.001 0 0 0 7.5 14.982v.518a.5.5 0 0 0 1 0v-.518A7.001 7.001 0 0 0 14.982 8.5h.518a.5.5 0 0 0 0-1h-.518A7.001 7.001 0 0 0 8.5 1.018V.5zm-6.48 7A6.001 6.001 0 0 1 7.5 2.02v4.48a1.5 1.5 0 0 0-.98.98H2.02zm0 1h4.48a1.5 1.5 0 0 0 .98.98v4.48A6.001 6.001 0 0 1 2.02 8.5zm6.48 5.46V9.48a1.5 1.5 0 0 0 .98-.98h4.48a6.001 6.001 0 0 1-5.46 5.46zm5.46-6.46H9.48a1.5 1.5 0 0 0-.98-.98V2.02a6.001 6.001 0 0 1 5.46 5.46zM8 6.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z"/></svg>
                            </div>
                        </div>
                        <span class="typo-symbolic mb-1 d-block fw-bold" style="color: var(--meta-gold); font-size: 1.1rem; letter-spacing: 2px;">05</span>
                        <h3 class="fs-6 letter-spacing-1 mb-3 text-uppercase" style="color: var(--meta-gold-hover); font-weight: 500; letter-spacing: 1.5px;">S'ALIGNER</h3>
                        <div class="content-premium mb-0 text-ivory" style="opacity: 0.92; font-size: 0.92rem; line-height: 1.6;">
                            Vivre en cohérence<br>avec vos valeurs,<br>vos besoins<br>et vos désirs profonds.
                        </div>
                    </div>
                </article>

            </div>
        </section>

    </div>
</div>
{% endblock %}
