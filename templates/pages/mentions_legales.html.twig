{% block body %}
<div class="container py-5 my-2">
    <!-- TITRE DE LA PAGE -->
    <header class="text-center mb-5">
        <h1 class="font-serif-luxury text-gold fw-light mb-2 typo-titre gold-gradient-text" style="font-size: var(--fs-h1, 2.8rem); letter-spacing: 2px;">
            Mentions Légales & Confidentialité
        </h1>
        <div class="mx-auto mt-3" style="width: 100px; height: 1px; background: linear-gradient(90deg, transparent, var(--meta-gold, #B89A63), transparent);"></div>
    </header>

    <!-- GRILLE JURIDIQUE (2 COLONNES HAUT + 1 PLEINE LARGEUR BAS) -->
    <div class="row g-4 align-items-stretch">
        
        <!-- BLOC 1 : MENTIONS LÉGALES (Moitié Gauche) -->
        <div class="col-12 col-lg-6 d-flex">
            <section class="olive-card w-100 p-4 p-md-5 d-flex flex-column justify-content-between shadow-lg" style="background-color: var(--meta-olive); border: 1px solid rgba(184, 154, 99, 0.25); border-radius: 0;">
                <div>
                    <header class="text-center border-bottom pb-4 mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                        <h2 class="typo-titre text-gold fw-normal mb-1" style="font-size: 1.85rem; letter-spacing: 1px;">
                            Mentions Légales
                        </h2>
                        <p class="text-uppercase fw-semibold mb-0" style="letter-spacing: 2.5px; font-size: 0.75rem; color: var(--meta-gold, #B89A63);">
                            Éditeur du site & Hébergement
                        </p>
                    </header>

                    <div class="content-premium text-ivory" style="font-size: 0.95rem; line-height: 1.7;">
                        <div class="mb-4">
                            <h3 class="fw-bold text-gold text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 1.5px;">1. Éditeur du site</h3>
                            <p class="mb-1 text-ivory"><strong class="text-white">METAMORPHYSIS</strong></p>
                            <p class="mb-1 text-ivory">Consultante en relations humaines & Analyse transactionnelle</p>
                            <p class="mb-1 text-ivory">Statut juridique : <strong class="text-white">Entrepreneur Individuel (EI)</strong></p>
                            <p class="mb-1 text-ivory">Responsable de la publication : <strong class="text-white">Louisa CHOUIHI</strong></p>
                            <p class="mb-1 text-ivory">Siège social : 111 rue Étienne Marcel, 93100 Montreuil, France</p>
                            <p class="mb-1 text-ivory">SIRET : <strong class="text-white">879 518 462 00020</strong> (Code APE : 9609Z)</p>
                            <p class="mb-1 text-ivory">TVA : TVA non applicable, art. 293 B du CGI</p>
                            <p class="mb-0 text-ivory">
                                <span class="text-gold">Contact :</span> 
                                <a href="mailto:Metamorphysisconsulting@gmail.com" class="text-ivory text-decoration-underline" style="text-underline-offset: 4px;">Metamorphysisconsulting@gmail.com</a>
                            </p>
                        </div>

                        <div class="pt-3 border-top mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                            <h3 class="fw-bold text-gold text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 1.5px;">2. Hébergement</h3>
                            <p class="mb-1 text-ivory">Le site est hébergé par la société <strong class="text-white">OVH SAS</strong></p>
                            <p class="mb-1 text-ivory" style="font-size: 0.92rem;">2 rue Kellermann, 59100 Roubaix, France</p>
                            <p class="mb-1 text-ivory" style="font-size: 0.92rem;">Site web : <a href="https://www.ovhcloud.com/fr/" target="_blank" rel="noopener noreferrer" style="color: var(--meta-gold);">www.ovhcloud.com</a></p>
                            <p class="mb-0 text-ivory" style="font-size: 0.92rem;">Téléphone : 1007</p>
                        </div>

                        <div class="pt-3 border-top mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                            <h3 class="fw-bold text-gold text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 1.5px;">3. Propriété intellectuelle</h3>
                            <p class="mb-0 text-ivory" style="font-size: 0.88rem; line-height: 1.65; opacity: 0.92;">
                                L'ensemble des éléments graphiques, textuels, logos, marques et structures composant ce site sont la propriété exclusive de METAMORPHYSIS et de Louisa CHOUIHI. Toute reproduction, diffusion, modification ou utilisation sans autorisation préalable expresse est strictement interdite.
                            </p>
                        </div>

                        <div class="pt-3 border-top mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                            <h3 class="fw-bold text-gold text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 1.5px;">4. Protection des données personnelles (RGPD) & Paiement</h3>
                            <p class="mb-2 text-ivory" style="font-size: 0.88rem; line-height: 1.65; opacity: 0.92;">
                                Les informations recueillies lors de la prise de rendez-vous (nom, prénom, e-mail, coordonnées) sont nécessaires à la gestion des consultations et au suivi de la relation client. Elles sont destinées exclusivement à Louisa CHOUIHI / METAMORPHYSIS et ne font l'objet d'aucune cession commerciale.
                            </p>
                            <p class="mb-2 text-ivory" style="font-size: 0.88rem; line-height: 1.65; opacity: 0.92;">
                                Les transactions financières sont sécurisées et traitées directement par la plateforme certifiée <strong>Stripe</strong>. Aucune donnée bancaire n'est stockée sur ce site.
                            </p>
                            <p class="mb-0 text-ivory" style="font-size: 0.88rem; line-height: 1.65; opacity: 0.92;">
                                Conformément au Règlement Général sur la Protection des Données (RGPD), vous disposez d'un droit d'accès, de rectification et de suppression de vos données personnelles en envoyant un e-mail à : <a href="mailto:Metamorphysisconsulting@gmail.com" class="text-gold text-decoration-underline">Metamorphysisconsulting@gmail.com</a>.
                            </p>
                        </div>

                        <div class="pt-3 border-top" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                            <h3 class="fw-bold text-gold text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 1.5px;">5. Médiation de la consommation</h3>
                            <p class="mb-2 text-ivory" style="font-size: 0.88rem; line-height: 1.65; opacity: 0.92;">
                                Conformément aux articles L.616-1 et R.616-1 du Code de la consommation, tout consommateur a le droit de recourir gratuitement à un médiateur de la consommation en vue de la résolution amiable d'un litige qui l'oppose à un professionnel.
                            </p>
                            <p class="mb-0 text-ivory" style="font-size: 0.88rem; line-height: 1.65; opacity: 0.92;">
                                Organisme de médiation désigné : <strong class="text-white">CNPM MÉDIATION CONSOMMATION</strong><br>
                                Site internet : <a href="https://cnpm-mediation-consommation.eu" target="_blank" rel="noopener noreferrer" style="color: var(--meta-gold);">cnpm-mediation-consommation.eu</a>
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- BLOC 2 : POLITIQUE DE CONFIDENTIALITÉ (Moitié Droite) -->
        <div class="col-12 col-lg-6 d-flex">
            <section class="olive-card w-100 p-4 p-md-5 d-flex flex-column justify-content-between shadow-lg" style="background-color: var(--meta-olive); border: 1px solid rgba(184, 154, 99, 0.25); border-radius: 0;">
                <div>
                    <header class="text-center border-bottom pb-4 mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                        <h2 class="typo-titre text-gold fw-normal mb-1" style="font-size: 1.85rem; letter-spacing: 1px;">
                            Politique de Confidentialité
                        </h2>
                        <p class="text-uppercase fw-semibold mb-0" style="letter-spacing: 2.5px; font-size: 0.75rem; color: var(--meta-gold, #B89A63);">
                            Protection de vos données personnelles [RGPD]
                        </p>
                    </header>

                    <div class="content-premium text-ivory" style="font-size: 0.95rem; line-height: 1.7;">
                        <div class="mb-4">
                            <h3 class="fw-bold text-gold text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 1.5px;">1. Données collectées</h3>
                            <p class="mb-0 text-ivory" style="font-size: 0.88rem; line-height: 1.65;">
                                Dans le cadre de la prise de contact, de la gestion de votre compte et de la réservation de séances d'accompagnement, METAMORPHYSIS est amenée à collecter des informations strictement nécessaires : nom, prénom, adresse e-mail, numéro de téléphone et historique des réservations.
                            </p>
                        </div>

                        <div class="pt-3 border-top mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                            <h3 class="fw-bold text-gold text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 1.5px;">2. Finalité des traitements</h3>
                            <p class="mb-0 text-ivory" style="font-size: 0.88rem; line-height: 1.65;">
                                Vos données personnelles sont traitées exclusivement pour assurer la gestion de vos rendez-vous, le suivi de vos accompagnements personnalisés, la facturation et la communication liée à vos séances. Vos données ne sont en aucun cas cédées, louées ou vendues à des tiers.
                            </p>
                        </div>

                        <div class="pt-3 border-top" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                            <h3 class="fw-bold text-gold text-uppercase mb-2" style="font-size: 0.85rem; letter-spacing: 1.5px;">3. Vos droits</h3>
                            <p class="mb-0 text-ivory" style="font-size: 0.88rem; line-height: 1.65;">
                                Conformément au Règlement Général sur la Protection des Données (RGPD), vous disposez d'un droit d'accès, de rectification, de suppression et de portabilité de vos données. Vous pouvez exercer ces droits à tout moment en écrivant à : <a href="mailto:Metamorphysisconsulting@gmail.com" class="text-gold text-decoration-underline">Metamorphysisconsulting@gmail.com</a> ou <a href="mailto:contact@metamorphysis.fr" class="text-gold text-decoration-underline">contact@metamorphysis.fr</a>.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- BLOC 3 : CONDITIONS D'ANNULATION (Pleine Largeur Centrée) -->
        <div class="col-12">
            <section class="olive-card w-100 p-4 p-md-5 shadow-lg" style="background-color: var(--meta-olive); border: 1px solid rgba(184, 154, 99, 0.25); border-radius: 0;">
                <header class="text-center border-bottom pb-4 mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                    <h2 class="typo-titre text-gold fw-normal mb-1" style="font-size: 1.85rem; letter-spacing: 1px;">
                        Conditions d'Annulation
                    </h2>
                    <p class="text-uppercase fw-semibold mb-0" style="letter-spacing: 2.5px; font-size: 0.75rem; color: var(--meta-gold, #B89A63);">
                        Modalités relatives aux rendez-vous & séances
                    </p>
                </header>

                <div class="content-premium text-ivory text-center mx-auto" style="max-width: 900px; font-size: 0.95rem; line-height: 1.8;">
                    <p class="mb-3">
                        Chaque séance d'accompagnement fait l'objet d'une préparation sur-mesure et d'un créneau horaire strictement réservé à votre attention.
                    </p>
                    <p class="mb-3">
                        <strong class="text-gold">Délai de prévenance :</strong> Tout report ou annulation de séance doit être formulé au minimum <strong class="text-white">48 heures à l'avance</strong> par e-mail ou depuis votre espace personnel.
                    </p>
                    <p class="mb-0 text-muted-ivory fst-italic" style="opacity: 0.88; font-size: 0.9rem;">
                        En cas d'annulation tardive (moins de 48h avant le rendez-vous) ou de non-présentation, la séance sera considérée comme due et ne donnera lieu à aucun remboursement, sauf cas de force majeure dûment justifié.
                    </p>
                </div>
            </section>
        </div>

    </div>
</div>
{% endblock %}
