<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture Metamorphysis</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            color: #1a1a1a;
            font-size: 14px;
            line-height: 1.6;
        }
        .header {
            text-align: center;
            margin-bottom: 50px;
            padding-bottom: 20px;
            border-bottom: 2px solid #B89A63; /* Couleur Or */
        }
        .logo-text {
            font-size: 28px;
            font-weight: bold;
            color: #B89A63;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        .info-container {
            width: 100%;
            margin-bottom: 40px;
        }
        .info-cabinet {
            float: left;
            width: 50%;
        }
        .info-client {
            float: right;
            width: 40%;
            background-color: #f9f9f9;
            padding: 15px;
            border-left: 3px solid #B89A63;
        }
        .clearfix { clear: both; }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 30px;
        }
        th {
            background-color: #1a1a1a;
            color: #B89A63;
            padding: 12px;
            text-align: left;
            text-transform: uppercase;
            font-size: 12px;
        }
        td {
            padding: 12px;
            border-bottom: 1px solid #eeeeee;
        }
        .total-row td {
            font-weight: bold;
            font-size: 16px;
            border-top: 2px solid #1a1a1a;
        }
        .text-right { text-align: right; }
        .footer {
            position: absolute;
            bottom: 30px;
            width: 100%;
            text-align: center;
            font-size: 11px;
            color: #777;
            border-top: 1px solid #eeeeee;
            padding-top: 10px;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo-text">METAMORPHYSIS</div>
        <p>Prestations d'exception</p>
    </div>

    <div class="info-container">
        <div class="info-cabinet">
            <strong>Metamorphysis</strong><br>
            123 Avenue des Champs-Élysées<br>
            75008 Paris, France<br>
            Email: contact@metamorphysis.com<br>
            Siret : 123 456 789 00012
        </div>
        
        <div class="info-client">
            <strong>Facturé à :</strong><br>
            {{ reservation.user.prenom|capitalize }} {{ reservation.user.nom|upper }}<br>
            {{ reservation.user.email }}<br>
            {% if reservation.user.telephone %}
                Tél : {{ reservation.user.telephone }}
            {% endif %}
        </div>
        <div class="clearfix"></div>
    </div>

    <div style="margin-bottom: 20px;">
        <strong>Facture N° :</strong> FAC-{{ "now"|date("Ymd") }}-{{ reservation.id }}<br>
        <strong>Date de facturation :</strong> {{ "now"|date("d/m/Y") }}<br>
        <strong>Date du rendez-vous :</strong> {{ reservation.dateRendezVous|date("d/m/Y à H:i") }}
    </div>

    <table>
        <thead>
            <tr>
                <th>Prestation</th>
                <th class="text-right">Montant TTC</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{ reservation.prestation.nom }}</td>
                <td class="text-right">{{ reservation.prestation.prix }} €</td>
            </tr>
            <tr class="total-row">
                <td class="text-right">Total à régler :</td>
                <td class="text-right" style="color: #B89A63;">{{ reservation.prestation.prix }} €</td>
            </tr>
        </tbody>
    </table>

    <div class="footer">
        Metamorphysis - Société par actions simplifiée au capital de 1 000 €<br>
        TVA non applicable, art. 293 B du CGI. (À modifier selon le statut de la cliente)
    </div>

</body>
</html>