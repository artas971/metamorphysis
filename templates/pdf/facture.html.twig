<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture Metamorphysis</title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            color: #1a1a1a;
            font-size: 14px;
            line-height: 1.6;
        }
        .header {
            text-align: center;
            margin-bottom: 50px;
            padding-bottom: 20px;
            border-bottom: 2px solid #B89A63; /* Couleur Or */
        }
        .logo-text {
            font-size: 28px;
            font-weight: bold;
            color: #B89A63;
            letter-spacing: 3px;
            text-transform: uppercase;
        }
        .info-container {
            width: 100%;
            margin-bottom: 40px;
        }
        .info-cabinet {
            float: left;
            width: 50%;
        }
        .info-client {
            float: right;
            width: 40%;
            background-color: #f9f9f9;
            padding: 15px;
            border-left: 3px solid #B89A63;
        }
        .clearfix { clear: both; }
        
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 30px;
        }
        th {
            background-color: #1a1a1a;
            color: #B89A63;
            padding: 12px;
            text-align: left;
            text-transform: uppercase;
            font-size: 12px;
        }
        td {
            padding: 12px;
            border-bottom: 1px solid #eeeeee;
        }
        .total-row td {
            font-weight: bold;
            font-size: 16px;
            border-top: 2px solid #1a1a1a;
        }
        .text-right { text-align: right; }
        .footer {
            position: absolute;
            bottom: 30px;
            width: 100%;
            text-align: center;
            font-size: 11px;
            color: #777;
            border-top: 1px solid #eeeeee;
            padding-top: 10px;
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo-text">METAMORPHYSIS</div>
        <p>Prestations d'exception</p>
    </div>

    <div class="info-container">
        <div class="info-cabinet">
            <strong>Metamorphysis &bull; Louisa Chouihi</strong><br>
            111 Rue Étienne Marcel<br>
            93100 Montreuil, France<br>
            Email : contact@metamorphysis.fr<br>
            Site web : metamorphysis.fr<br>
            SIRET : 879 518 462 00020 &bull; APE : 9609Z
        </div>
        
        <div class="info-client">
            <strong>Facturé à :</strong><br>
            {{ reservation.user.prenom|capitalize }} {{ reservation.user.nom|upper }}<br>
            {{ reservation.user.email }}<br>
            {% if reservation.user.telephone %}
                Tél : {{ reservation.user.telephone }}
            {% endif %}
        </div>
        <div class="clearfix"></div>
    </div>

    <div style="margin-bottom: 20px;">
        <strong>Facture N° :</strong> FAC-{{ "now"|date("Ymd") }}-{{ reservation.id }}<br>
        <strong>Date d'émission :</strong> {{ "now"|date("d/m/Y") }}<br>
        <strong>Séance :</strong> Séance n°{{ reservation.numero }} - {% if reservation.dateRendezVous %}{{ reservation.dateRendezVous|date("d/m/Y à H:i") }}{% else %}À convenir{% endif %}
    </div>

    {% set prixFacture = reservation.montantPaye|default(reservation.prestation.prix) %}
    <table>
        <thead>
            <tr>
                <th>Désignation de l'accompagnement</th>
                <th class="text-right">Montant Réglé TTC</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <strong>{{ reservation.prestation.nom }}</strong> (Séance n°{{ reservation.numero }})
                    {% if reservation.nombrePersonnes is defined and reservation.nombrePersonnes > 1 %}
                        <br><span style="color: #666; font-size: 12px;">Formule : {{ reservation.getLibelleFormule() }}</span>
                    {% endif %}
                </td>
                <td class="text-right">{{ prixFacture|number_format(2, ',', ' ') }} €</td>
            </tr>
            <tr class="total-row">
                <td class="text-right">Total Réglé :</td>
                <td class="text-right" style="color: #B89A63;">{{ prixFacture|number_format(2, ',', ' ') }} €</td>
            </tr>
        </tbody>
    </table>

    <div class="footer">
        Metamorphysis &bull; Louisa Chouihi — Consultante en Relation Humaine &bull; 111 Rue Étienne Marcel, 93100 Montreuil<br>
        SIRET : 879 518 462 00020 &bull; TVA non applicable, art. 293 B du CGI &bull; Facture acquittée
    </div>

</body>
</html>