{% extends 'emails/layout_email.html.twig' %}

{% block title %}Notification Accompagnement en Groupe — Metamorphysis{% endblock %}

{% block content %}
    <h2 style="color: #B89A63; font-size: 20px; font-weight: normal; margin-top: 0; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px;">
        Bonjour Louisa,
    </h2>

    <p style="margin-bottom: 20px;">
        Un participant a réagi concernant la prochaine séance d'Accompagnement en Groupe :
    </p>

    <div style="background-color: rgba(74, 79, 65, 0.25); border-left: 3px solid #B89A63; padding: 18px 20px; margin: 25px 0;">
        <p style="margin: 0 0 8px 0; font-size: 15px; color: #FFFFF0;">
            <strong style="color: #B89A63;">Participant :</strong> {{ inscription.nomComplet }} ({{ inscription.email }})
        </p>
        <p style="margin: 0 0 8px 0; font-size: 14px; color: #D8D0BE;">
            <strong style="color: #B89A63;">Groupe :</strong> {{ groupe ? groupe.nom : (session.prestation ? session.prestation.nom : 'Accompagnement') }}
            {% if session.numeroSeance %}— Séance {{ session.numeroSeance }}{% endif %}
        </p>
        <p style="margin: 0 0 8px 0; font-size: 14px; color: #D8D0BE;">
            <strong style="color: #B89A63;">Date de la séance :</strong> {{ session.dateDebut|date('d/m/Y à H:i') }}
        </p>
        <p style="margin: 0; font-size: 14px; color: #D8D0BE;">
            <strong style="color: #B89A63;">Action / Statut :</strong> 
            <span style="color: {% if inscription.statutPresence == 'Confirmé' %}#5cb85c{% elseif inscription.statutPresence == 'Décliné' %}#d9534f{% else %}#f0ad4e{% endif %}; font-weight: bold;">
                {{ inscription.statutPresence }}
            </span>
        </p>
    </div>

    {% if inscription.messageParticipant %}
        <div style="background-color: rgba(184, 154, 99, 0.1); border: 1px solid rgba(184, 154, 99, 0.35); padding: 18px 20px; margin: 25px 0;">
            <strong style="color: #B89A63; display: block; margin-bottom: 8px;">Message transmis par le participant :</strong>
            <p style="margin: 0; color: #FFFFF0; font-style: italic; white-space: pre-line;">
                "{{ inscription.messageParticipant }}"
            </p>
        </div>
    {% endif %}

    <div style="text-align: center; margin: 30px 0;">
        <a href="{{ absolute_url(path('admin')) }}" 
           style="background-color: #B89A63; color: #0A0A09; font-weight: bold; text-decoration: none; padding: 12px 24px; display: inline-block; text-transform: uppercase; font-size: 12px; letter-spacing: 1px;">
            Accéder à l'administration
        </a>
    </div>
{% endblock %}
