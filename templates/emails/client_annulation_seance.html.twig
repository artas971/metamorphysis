{% extends 'emails/layout_email.html.twig' %}

{% block title %}Annulation de votre séance — Metamorphysis{% endblock %}

{% block content %}
    <h2 style="color: #FFFFF0; margin-top: 0; font-weight: 300; font-size: 20px; border-bottom: 1px solid rgba(184, 154, 99, 0.25); padding-bottom: 15px;">
        Annulation de votre séance
    </h2>

    <p style="font-size: 16px; color: #FFFFF0; margin-top: 20px;">
        Bonjour <strong style="color: #B89A63;">{{ client.prenom|capitalize }}</strong>,
    </p>

    <p style="color: #D8D0BE; line-height: 1.7;">
        Nous vous confirmons l'annulation de votre séance pour l'accompagnement 
        <strong style="color: #FFFFF0;">{{ prestation.nom }}</strong>.
    </p>

    <div style="background-color: rgba(220, 53, 69, 0.08); padding: 25px; border-radius: 4px; margin: 25px 0; border: 1px solid rgba(220, 53, 69, 0.3); border-left: 4px solid #dc3545;">
        <p style="margin: 0 0 10px 0; font-size: 14px;">
            <strong style="color: #8F8876; text-transform: uppercase; font-size: 11px; letter-spacing: 1.5px;">Soin concerné</strong><br>
            <span style="color: #FFFFF0; font-size: 15px;">{{ prestation.nom }} (Séance n°{{ seance.numero }})</span>
        </p>
        <p style="margin: 0; font-size: 14px;">
            <strong style="color: #8F8876; text-transform: uppercase; font-size: 11px; letter-spacing: 1.5px;">Date initiale annulée</strong><br>
            <strong style="color: #dc3545; text-decoration: line-through; font-size: 16px;">
                {% if ancienneDate %}{{ ancienneDate|date('d/m/Y à H:i') }}{% else %}Non renseignée{% endif %}
            </strong>
        </p>
    </div>

    <p style="font-size: 14.5px; line-height: 1.7; color: #D8D0BE;">
        Cette séance reste créditée dans votre parcours d'accompagnement. Vous pouvez choisir un nouveau créneau dès à présent depuis votre espace client.
    </p>

    <div style="text-align: center; margin: 35px 0 20px 0;">
        <a href="http://127.0.0.1:8000/mon-compte" target="_blank" 
           style="display: inline-block; padding: 14px 28px; background-color: #B89A63; color: #0A0A09; text-decoration: none; font-weight: bold; border-radius: 2px; text-transform: uppercase; letter-spacing: 1.5px; font-size: 13px;">
            Replanifier ma Séance
        </a>
    </div>
{% endblock %}
