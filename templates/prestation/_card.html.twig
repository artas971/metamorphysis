<div class="card shadow-lg h-100 transition-hover text-center d-flex flex-column position-relative" 
     style="background-color: rgba(74, 79, 65, 0.55); border: 1px solid rgba(184, 154, 99, 0.9); border-radius: 0; padding: 0 0 1.5rem 0; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
    
    {# 1. ZONE SUPÉRIEURE (Image ou Icône minimaliste élégante) #}
    {% if prestation.imageName %}
        <div style="height: 200px; width: 100%; overflow: hidden;">
            <img src="{{ vich_uploader_asset(prestation, 'imageFile') }}" 
                 class="w-100 h-100 object-fit-cover" 
                 alt="{{ prestation.nom }}">
        </div>
    {% else %}
        {# Alternative : Carré doré centré sur le dégradé officiel fusionné Violet/Vert #}
        <div class="d-flex flex-column align-items-center justify-content-center" 
             style="height: 200px; background: linear-gradient(135deg, var(--meta-plum) 0%, var(--meta-olive) 100%); overflow: hidden;">
            <div class="d-flex align-items-center justify-content-center" 
                 style="width: 80px; height: 80px; border: 1px solid var(--meta-gold); background-color: rgba(10, 10, 9, 0.4); border-radius: 0;">
                <i class="bi {{ prestation.icone|default('bi-person') }} text-gold" style="font-size: 2rem;"></i>
            </div>
        </div>
    {% endif %}

    {# 2. LE CONTENU DE LA CARTE #}
    <div class="card-body d-flex flex-column p-4 flex-grow-1">
        
        {# 2.1 Titre harmonisé (3 lignes max, hauteur constante) #}
        <div class="prestation-card-title-box mb-3 d-flex align-items-center justify-content-center" style="height: 3.8rem; min-height: 3.8rem; max-height: 3.8rem;">
            <h3 class="text-gold text-uppercase m-0 text-center" style="letter-spacing: 1.5px; font-family: var(--font-title), serif; font-size: 0.88rem !important; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {{ prestation.nom }}
            </h3>
        </div>
        
        {# 2.2 Trait séparateur doré parfaitement calé #}
        <div class="mx-auto mb-3" style="width: 30px; height: 1px; background-color: var(--meta-gold); opacity: 0.6;"></div>
        
        {# 2.3 Durée / Minutes (Alignement horizontal garanti) #}
        <div class="prestation-card-duration-box mb-3 d-flex align-items-center justify-content-center" style="height: 1.5rem; min-height: 1.5rem;">
            {% if prestation.duree %}
                <p class="text-sage small m-0" style="font-size: 0.82rem; letter-spacing: 1px;">
                    <i class="bi bi-clock me-1"></i> {{ prestation.duree }} min
                </p>
            {% else %}
                <span class="text-sage small m-0 opacity-0" aria-hidden="true">&nbsp;</span>
            {% endif %}
        </div>
        
        {# 2.4 Début de description (Départ et hauteur identiques sur toutes les cartes) #}
        <div class="prestation-card-desc-box mb-4 d-flex align-items-start justify-content-center" style="height: 4.8rem; min-height: 4.8rem; max-height: 4.8rem; overflow: hidden;">
            {% set desc_clean = prestation.description|striptags|replace({'&nbsp;': ' '}) %}
            <p class="text-ivory m-0 small text-center" style="line-height: 1.6; font-size: 0.84rem; opacity: 0.9; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {{ desc_clean }}
            </p>
        </div>
        
        {# 2.5 Prix et Unité #}
        <div class="prestation-card-price-box mb-3 d-flex align-items-center justify-content-center" style="height: 2rem;">
            <p class="text-gold fw-bold m-0 text-uppercase" style="font-size: 1.15rem; letter-spacing: 1px;">
                {% if prestation.prixAffiche %}
                    {{ prestation.prixAffiche }}
                {% else %}
                    {% if prestation.hasTarificationVariable %}<span class="fs-6 fw-normal text-capitalize" style="color: var(--meta-sage); font-size: 0.82rem !important;">À partir de </span>{% endif %}
                    {{ prestation.prix }} € 
                    {% if prestation.unitePrix is defined and prestation.unitePrix %}
                        <span class="fs-6 fw-light text-lowercase" style="color: var(--meta-ivory);">/ {{ prestation.unitePrix }}</span>
                    {% endif %}
                {% endif %}
            </p>
        </div>
                                                                                
        {# 2.6 Actions Boutons #}
        <div class="d-flex flex-column gap-2 mt-auto w-100 pt-2">
            {% if app.user and app.user.hasActivePrestation(prestation) %}
                <a href="{{ path('app_account') }}" 
                   class="btn w-100 text-uppercase rounded-0 py-2 transition-hover" 
                   style="background-color: rgba(184, 154, 99, 0.2); border: 1px solid var(--meta-gold); color: var(--meta-gold); font-size: 0.73rem; letter-spacing: 1.5px; font-weight: 600;"
                   title="Accompagnement déjà en cours — Voir mon espace">
                    <i class="bi bi-hourglass-split me-1"></i> EN COURS &bull; MON ESPACE
                </a>
            {% else %}
                <a href="{{ path('app_reservation_new', {'id': prestation.id}) }}" 
                   class="btn w-100 text-gold text-uppercase rounded-0 py-2 transition-hover" 
                   style="background-color: var(--meta-plum); border: 1px solid rgba(184, 154, 99, 0.4); font-size: 0.75rem; letter-spacing: 2px; font-weight: 500;">
                    RÉSERVER
                </a>
            {% endif %}
            <a href="{{ path('app_prestation_show', {'id': prestation.id}) }}" 
               class="btn w-100 text-gold text-uppercase rounded-0 py-2 transition-hover" 
               style="background-color: transparent; border: 1px solid rgba(184, 154, 99, 0.3); font-size: 0.75rem; letter-spacing: 2px;">
                DÉTAILS
            </a> 
        </div>
    </div>
</div>
