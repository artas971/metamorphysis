{% extends 'base.html.twig' %}

{% block title %}{{ prestation.nom }} - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# Bouton de retour à la liste #}
    <div class="mb-4">
        <a href="{{ path('app_prestation_index') }}" class="text-warning text-decoration-none fw-bold">
            <i class="bi bi-arrow-left"></i> Retour aux prestations
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-dark border-warning shadow-lg" style="border-radius: 15px;">
                <div class="card-body p-5">
                    
                    {# En-tête de la prestation #}
                    <div class="text-center mb-5">
                        <h1 class="text-warning display-5 mb-3" style="font-family: 'Impact', sans-serif; letter-spacing: 2px;">
                            {{ prestation.nom|upper }}
                        </h1>
                        
                        <div class="d-flex justify-content-center gap-4">
                            <span class="badge bg-warning text-dark fs-5 p-2">
                                <i class="bi bi-tag-fill"></i> {{ prestation.prix }} €
                            </span>
                            <span class="badge border border-warning text-warning fs-5 p-2">
                                <i class="bi bi-clock-history"></i> {{ prestation.duree }} min
                            </span>
                        </div>
                    </div>

                    {# Contenu de la description #}
                    <div class="text-white fs-5 mb-5" style="line-height: 1.8;">
                        <h4 class="text-warning mb-3 border-bottom border-warning pb-2">Description de l'accompagnement</h4>
                        <p>
                            {{ prestation.description }}
                        </p>
                    </div>

                    {# Section d'appel à l'action (Boutons) #}
                    <div class="bg-black p-4 rounded text-center border border-secondary">
                        <h5 class="text-light mb-3">Cette prestation correspond à vos besoins ?</h5>
                        <a href="{{ path('app_contact') }}" class="btn btn-warning btn-lg fw-bold px-5" style="border-radius: 30px;">
                            DEMANDER UN DEVIS
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}