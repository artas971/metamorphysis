{% extends 'base.html.twig' %}

{% block title %}{{ prestation.nom }} - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# Bouton de retour #}
    <div class="mb-4">
        <a href="{{ path('app_prestation_index') }}" class="text-gold text-decoration-none transition-hover d-inline-block" style="letter-spacing: 1px; text-transform: uppercase; font-size: 0.85rem;">
            <i class="bi bi-arrow-left me-2"></i>Retour aux prestations
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            
    <div class="card-premium shadow-lg overflow-hidden position-relative" style="background-color: rgba(74, 79, 65, 0.55); border: 1px solid rgba(184, 154, 99, 0.2);">                <i class="bi {{ prestation.icone|default('bi-star') }} position-absolute text-gold" style="font-size: 25rem; opacity: 0.03; bottom: -50px; right: -20px; z-index: 0; pointer-events: none;"></i>

                <div class="row g-0 position-relative z-1"> 
                    
                    {# 1. COLONNE IMAGE #}
                    <div class="col-md-5 d-flex">
                        {% if prestation.imageName %}
                            <img src="{{ vich_uploader_asset(prestation, 'imageFile') }}" 
                                alt="{{ prestation.nom }}" 
                                class="img-fluid w-100" 
                                style="height: 100%; min-height: 400px; object-fit: cover; border-right: 1px solid rgba(184, 154, 99, 0.2);">
                        {% else %}
                            {# Application du dégradé Violet (Plum) / Vert (Olive) #}
                            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" 
                                 style="background: linear-gradient(135deg, var(--meta-plum) 0%, var(--meta-olive) 100%); min-height: 400px; border-right: 1px solid rgba(184, 154, 99, 0.2);">
                                <i class="bi {{ prestation.icone|default('bi-star') }} text-gold opacity-50 mb-3" style="font-size: 4rem;"></i>
                                <span class="text-gold typo-symbolic opacity-50 fs-5 text-uppercase">Metamorphysis</span>
                            </div>
                        {% endif %}
                    </div>

                    {# 2. COLONNE CONTENU #}
                    <div class="col-md-7 d-flex flex-column p-4 p-md-5">
                                                {# En-tête : Icône, Titre et Prix #}
                        <div class="mb-4">
                            <i class="bi {{ prestation.icone|default('bi-star') }} text-gold fs-3 mb-2 d-block"></i>
                            <h1 class="text-gold typo-titre mb-3" style="font-size: 2.5rem; letter-spacing: 1px;">{{ prestation.nom }}</h1>
                            
                            <div class="d-flex flex-wrap align-items-center gap-3 text-ivory">
                                <span class="fs-4 fw-bold text-gold">
                                    {% if prestation.prixAffiche %}
                                        {{ prestation.prixAffiche }}
                                    {% else %}
                                        {{ prestation.calculerPrixTotal(prestation.minPersonnes) }} € 
                                        {% if prestation.unitePrix %}<span class="fs-6 fw-light text-uppercase">/ {{ prestation.unitePrix }}</span>{% endif %}
                                    {% endif %}
                                </span>
                                
                                {% if prestation.duree %}
                                    <span class="text-sage border-start border-sage ps-3">
                                        <i class="bi bi-clock me-1"></i>{{ prestation.duree }} minutes
                                    </span>
                                {% endif %}

                                {% if prestation.nombreSeances > 1 %}
                                    <span class="text-sage border-start border-sage ps-3">
                                        <i class="bi bi-ticket-perforated me-1"></i>{{ prestation.nombreSeances }} séances
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        {# Description Courte (Intro) #}
                        <div class="text-ivory fs-5 fw-light mb-4" style="line-height: 1.6; border-left: 2px solid var(--meta-gold); padding-left: 15px;">
                            {{ prestation.description|raw }}
                        </div>

                        {# Section Vidéo Optionnelle #}
                        {% if prestation.lienVideo %}
                            <div class="mb-4 mt-2">
                                <a href="{{ prestation.lienVideo }}" target="_blank" class="btn btn-outline-gold w-100 py-3 d-flex align-items-center justify-content-center transition-hover" style="border-radius: 0;">
                                    <i class="bi bi-play-circle-fill fs-4 me-3"></i> 
                                    <span style="letter-spacing: 1px; text-transform: uppercase;">Voir la vidéo de présentation</span>
                                </a>
                            </div>
                        {% endif %}

                        {# Description Longue (Contenu Premium Amélioré) #}
                        {% if prestation.descriptionComplementaire %}
                            <div class="mt-4 pt-4 border-top border-gold-subtle">
                                <h2 class="text-gold typo-symbolic fs-6 text-uppercase mb-4" style="letter-spacing: 3px; opacity: 0.8;">
                                    Le Déroulé du Soin
                                </h2>
                                
                                <div class="content-premium-text text-ivory flex-grow-1" style="
                                    font-family: 'Playfair Display', 'Didot', 'Georgia', serif;
                                    font-size: 1.05rem; 
                                    line-height: 1.9; 
                                    font-weight: 300; 
                                    letter-spacing: 0.5px;
                                    white-space: pre-line;
                                ">
                                    {{ prestation.descriptionComplementaire }}
                                </div>
                            </div>
                        {% endif %}

                        {# Section Formules & Tarifs Fixés par l'Admin #}
                        {% if prestation.hasTarificationVariable %}
                            <div class="my-4 p-4" style="background-color: var(--meta-olive); border: 1px solid var(--meta-gold); box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);">
                                <label class="form-label text-uppercase small fw-bold mb-3 d-flex align-items-center" style="letter-spacing: 1.5px; color: var(--meta-ivory);">
                                    <i class="bi bi-people-fill me-2 fs-5" style="color: var(--meta-gold);"></i>Formule & Nombre de participants
                                </label>
                                <div class="d-flex flex-wrap gap-2" id="formula-options">
                                    {% for i in prestation.minPersonnes..prestation.maxPersonnes %}
                                        {% set details = prestation.getFormuleDetails(i) %}
                                        <div class="formula-card flex-fill p-3 text-center transition-hover position-relative {% if loop.first %}active-formula{% endif %}" 
                                             data-personnes="{{ i }}" 
                                             data-price="{{ details.prix }}"
                                             style="background-color: var(--meta-plum); {% if loop.first %}border: 2px solid var(--meta-gold); box-shadow: 0 0 10px rgba(184, 154, 99, 0.45);{% else %}border: 1px solid rgba(184, 154, 99, 0.35); opacity: 0.85;{% endif %} cursor: pointer; min-width: 140px;">
                                            <div class="fw-bold mb-1" style="color: var(--meta-ivory); font-size: 0.88rem; text-transform: uppercase; letter-spacing: 1px;">
                                                <i class="bi bi-people me-1" style="color: var(--meta-gold);"></i>{{ details.titre }}
                                            </div>
                                            <div class="fw-bold" style="color: var(--meta-gold); font-size: 1.35rem;">
                                                {{ details.prix }} €
                                            </div>
                                            {% if details.sousTitre %}
                                                <div class="small mt-1" style="color: var(--meta-ivory-dim); font-size: 0.78rem;">
                                                    {{ details.sousTitre }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        {# Bouton d'action Réserver / Info Accompagnement en cours #}
                        {% if app.user and app.user.hasActivePrestation(prestation) %}
                            <div class="mt-4 p-4" style="background-color: rgba(255, 193, 7, 0.08); border: 1px solid rgba(255, 193, 7, 0.35); border-left: 4px solid #E5C78D;">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-info-circle-fill fs-4" style="color: #E5C78D;"></i>
                                    <h3 class="m-0 text-gold fs-6 text-uppercase" style="letter-spacing: 1.5px; font-family: var(--font-title), serif;">Accompagnement déjà en cours</h3>
                                </div>
                                <p class="text-ivory small mb-3" style="line-height: 1.6; opacity: 0.9; color: var(--meta-ivory);">
                                    Vous suivez actuellement ce parcours d'accompagnement. Vous ne pouvez pas souscrire de nouveau à cette même prestation tant que vos séances actuelles ne sont pas achevées.
                                </p>
                                <a href="{{ path('app_account') }}" 
                                   class="btn w-100 py-3 fw-bold text-uppercase transition-hover" 
                                   style="background-color: var(--meta-plum); color: var(--meta-gold); border: 1px solid var(--meta-gold); letter-spacing: 2px; border-radius: 0; font-size: 0.85rem;">
                                    <i class="bi bi-person-circle me-2"></i>Accéder à mon espace personnel
                                </a>
                            </div>
                        {% else %}
                            <div class="mt-4 pt-3" style="border-top: 1px solid rgba(184, 154, 99, 0.2);">
                                <a id="btn-reserver-prestation" href="{{ path('app_reservation_new', {'id': prestation.id, 'personnes': prestation.minPersonnes}) }}" 
                                   class="btn w-100 py-3 fw-bold text-uppercase transition-hover d-flex align-items-center justify-content-center gap-2" 
                                   style="background-color: var(--meta-plum); color: var(--meta-gold); border: 1px solid var(--meta-gold); letter-spacing: 2px; border-radius: 0;">
                                    <span style="color: var(--meta-ivory);">Réserver cette séance</span>
                                    <span id="btn-price-preview" class="badge text-gold ms-2 px-3 py-1" style="background-color: rgba(10, 10, 9, 0.85); border: 1px solid var(--meta-gold); font-size: 0.95rem; color: var(--meta-gold);">{{ prestation.getTarifPour(prestation.minPersonnes) }} €</span>
                                </a>
                            </div>
                        {% endif %}
                        
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const formulaCards = document.querySelectorAll('.formula-card');
    const btnPricePreview = document.getElementById('btn-price-preview');
    const btnReserver = document.getElementById('btn-reserver-prestation');
    const baseReservationUrl = "{{ path('app_reservation_new', {'id': prestation.id}) }}";

    formulaCards.forEach(card => {
        card.addEventListener('click', function() {
            formulaCards.forEach(c => {
                c.classList.remove('active-formula');
                c.style.backgroundColor = 'var(--meta-plum)';
                c.style.border = '1px solid var(--meta-sage)';
                c.style.boxShadow = 'none';
                c.style.opacity = '0.85';
            });

            this.classList.add('active-formula');
            this.style.backgroundColor = 'var(--meta-plum)';
            this.style.border = '2px solid var(--meta-gold)';
            this.style.boxShadow = '0 0 12px rgba(184, 154, 99, 0.4)';
            this.style.opacity = '1';

            const nbPers = this.getAttribute('data-personnes');
            const price = this.getAttribute('data-price');

            if (btnPricePreview) {
                btnPricePreview.innerText = price + ' €';
            }
            if (btnReserver) {
                btnReserver.href = baseReservationUrl + '?personnes=' + nbPers;
            }
        });
    });
});
</script>
{% endblock %}
{% endblock %}