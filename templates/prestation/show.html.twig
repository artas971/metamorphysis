{% extends 'base.html.twig' %}

{% block title %}{{ prestation.nom }} - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# Bouton retour #}
    <div class="mb-4">
        <a href="{{ path('app_prestation_index') }}" class="text-gold text-decoration-none fw-bold">
            <i class="bi bi-arrow-left"></i> Retour aux prestations
        </a>
    </div>

    <div class="card-premium shadow-lg overflow-hidden">
        <div class="row g-0">
            
            {# COLONNE GAUCHE : L'IMAGE #}
            <div class="col-md-5 col-lg-4 border-end border-gold">
                {% if prestation.imageName %}
                    <img src="{{ vich_uploader_asset(prestation, 'imageFile') }}" 
                         class="img-fluid w-100 h-100" 
                         alt="{{ prestation.nom }}" 
                         style="object-fit: cover; min-height: 400px;">
                {% else %}
                    <div class="bg-grad-subtle w-100 h-100 d-flex align-items-center justify-content-center" style="min-height: 400px;">
                        <h3 class="text-gold fw-bold text-center" style="opacity: 0.5;">METAMORPHYSIS</h3>
                    </div>
                {% endif %}
            </div>

            {# COLONNE DROITE : LES INFORMATIONS #}
            <div class="col-md-7 col-lg-8 d-flex flex-column">
                <div class="card-body p-5 flex-grow-1">
                    
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <h1 class="text-gold fw-bold text-uppercase">
                            {{ prestation.nom }}
                        </h1>
                        <span class="badge bg-gold text-dark fs-5 p-2">{{ prestation.prix }} €</span>
                    </div>

                    <h5 class="text-white-50 mb-4">
                        <i class="bi bi-clock me-2"></i> Durée estimée : {{ prestation.duree }} minutes
                    </h5>

                    <div class="text-white fs-5 lh-lg mb-5">
                        {# Le filtre nl2br permet de respecter les retours à la ligne de ta description #}
                        {{ prestation.description|nl2br }}
                    </div>

                </div>
                
                {# LE BOUTON D'ACTION EN BAS #}
                <div class="card-footer bg-transparent border-top border-gold p-4">
                    <a href="{{ path('app_reservation_new', {'id': prestation.id}) }}" class="btn btn-premium w-100 fs-4 fw-bold py-3 rounded-pill">
                        RÉSERVER CE SOIN
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}