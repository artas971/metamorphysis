{% extends 'base.html.twig' %}

{% block title %}{{ prestation.nom }} - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# Bouton de retour #}
    <div class="mb-4">
        <a href="{{ path('app_prestation_index') }}" class="text-gold text-decoration-none transition-hover d-inline-block" style="letter-spacing: 1px; text-transform: uppercase; font-size: 0.85rem;">
            <i class="bi bi-arrow-left me-2"></i>Retour aux prestations
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            
    <div class="card-premium shadow-lg overflow-hidden position-relative" style="background-color: rgba(74, 79, 65, 0.55); border: 1px solid rgba(184, 154, 99, 0.2);">                <i class="bi {{ prestation.icone|default('bi-star') }} position-absolute text-gold" style="font-size: 25rem; opacity: 0.03; bottom: -50px; right: -20px; z-index: 0; pointer-events: none;"></i>

                <div class="row g-0 position-relative z-1"> 
                    
                    {# 1. COLONNE IMAGE #}
                    <div class="col-md-5 d-flex">
                        {% if prestation.imageName %}
                            <img src="{{ vich_uploader_asset(prestation, 'imageFile') }}" 
                                alt="{{ prestation.nom }}" 
                                class="img-fluid w-100" 
                                style="height: 100%; min-height: 400px; object-fit: cover; border-right: 1px solid rgba(184, 154, 99, 0.2);">
                        {% else %}
                            {# Application du dégradé Violet (Plum) / Vert (Olive) #}
                            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" 
                                 style="background: linear-gradient(135deg, var(--meta-plum) 0%, var(--meta-olive) 100%); min-height: 400px; border-right: 1px solid rgba(184, 154, 99, 0.2);">
                                <i class="bi {{ prestation.icone|default('bi-star') }} text-gold opacity-50 mb-3" style="font-size: 4rem;"></i>
                                <span class="text-gold typo-symbolic opacity-50 fs-5 text-uppercase">Metamorphysis</span>
                            </div>
                        {% endif %}
                    </div>

                    {# 2. COLONNE CONTENU #}
                    <div class="col-md-7 d-flex flex-column p-4 p-md-5">
                        
                        {# En-tête : Icône, Titre et Prix #}
                        <div class="mb-4">
                            <i class="bi {{ prestation.icone|default('bi-star') }} text-gold fs-3 mb-2 d-block"></i>
                            <h1 class="text-gold typo-titre mb-3" style="font-size: 2.5rem; letter-spacing: 1px;">{{ prestation.nom }}</h1>
                            
                            <div class="d-flex align-items-center gap-4 text-ivory">
                                <span class="fs-4 fw-bold text-gold">
                                    {{ prestation.prix }} € 
                                    {% if prestation.unitePrix %}<span class="fs-6 fw-light text-uppercase">/ {{ prestation.unitePrix }}</span>{% endif %}
                                </span>
                                
                                {% if prestation.duree %}
                                    <span class="text-sage border-start border-sage ps-4">
                                        <i class="bi bi-clock me-2"></i>{{ prestation.duree }} minutes
                                    </span>
                                {% endif %}
                            </div>
                        </div>

                        {# Description Courte (Intro) #}
                        <div class="text-ivory fs-5 fw-light mb-4" style="line-height: 1.6; border-left: 2px solid var(--meta-gold); padding-left: 15px;">
                            {{ prestation.description|raw }}
                        </div>

                        {# Section Vidéo Optionnelle #}
                        {% if prestation.lienVideo %}
                            <div class="mb-4 mt-2">
                                <a href="{{ prestation.lienVideo }}" target="_blank" class="btn btn-outline-gold w-100 py-3 d-flex align-items-center justify-content-center transition-hover" style="border-radius: 0;">
                                    <i class="bi bi-play-circle-fill fs-4 me-3"></i> 
                                    <span style="letter-spacing: 1px; text-transform: uppercase;">Voir la vidéo de présentation</span>
                                </a>
                            </div>
                        {% endif %}

                        {# Description Longue (Contenu Premium Amélioré) #}
                        {% if prestation.descriptionComplementaire %}
                            <div class="mt-4 pt-4 border-top border-gold-subtle">
                                {# Un petit sous-titre discret pour introduire la section #}
                                <h2 class="text-gold typo-symbolic fs-6 text-uppercase mb-4" style="letter-spacing: 3px; opacity: 0.8;">
                                    Le Déroulé du Soin
                                </h2>
                                
                                {# Le bloc de texte avec une typographie haut de gamme #}
                                <div class="content-premium-text text-ivory flex-grow-1" style="
                                    font-family: 'Playfair Display', 'Didot', 'Georgia', serif; {# Utilise une police Serif élégante si ta charte en a une, sinon ajuste #}
                                    font-size: 1.05rem; 
                                    line-height: 1.9; 
                                    font-weight: 300; 
                                    letter-spacing: 0.5px;
                                    white-space: pre-line; {# Gère nativement et proprement les sauts de ligne tapés dans EasyAdmin #}
                                ">
                                    {{ prestation.descriptionComplementaire }}
                                </div>
                            </div>
                        {% endif %}

                        {# Bouton d'action Réserver / Info Accompagnement en cours #}
                        {% if app.user and app.user.hasActivePrestation(prestation) %}
                            <div class="mt-5 p-4" style="background-color: rgba(255, 193, 7, 0.08); border: 1px solid rgba(255, 193, 7, 0.35); border-left: 4px solid #E5C78D;">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-info-circle-fill fs-4" style="color: #E5C78D;"></i>
                                    <h3 class="m-0 text-gold fs-6 text-uppercase" style="letter-spacing: 1.5px; font-family: var(--font-title), serif;">Accompagnement déjà en cours</h3>
                                </div>
                                <p class="text-ivory small mb-3" style="line-height: 1.6; opacity: 0.9;">
                                    Vous suivez actuellement ce parcours d'accompagnement. Vous ne pouvez pas souscrire de nouveau à cette même prestation tant que vos séances actuelles ne sont pas achevées.
                                </p>
                                <a href="{{ path('app_account') }}" 
                                   class="btn w-100 py-3 fw-bold text-uppercase transition-hover" 
                                   style="background-color: rgba(184, 154, 99, 0.2); color: var(--meta-gold); border: 1px solid var(--meta-gold); letter-spacing: 2px; border-radius: 0; font-size: 0.85rem;">
                                    <i class="bi bi-person-circle me-2"></i>Accéder à mon espace personnel
                                </a>
                            </div>
                        {% else %}
                            <div class="mt-5 pt-4" style="border-top: 1px solid rgba(184, 154, 99, 0.2);">
                                <a href="{{ path('app_reservation_new', {'id': prestation.id}) }}" 
                                   class="btn w-100 py-3 fw-bold text-uppercase transition-hover" 
                                   style="background-color: var(--meta-plum); color: var(--meta-gold); border: 1px solid var(--meta-gold); letter-spacing: 2px; border-radius: 0;">
                                    Réserver cette séance
                                </a>
                            </div>
                        {% endif %}
                        
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>
{% endblock %}