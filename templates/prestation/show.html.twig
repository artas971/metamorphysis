{% extends 'base.html.twig' %}

{% block title %}{{ prestation.nom }} - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# Bouton de retour #}
    <div class="mb-4">
        <a href="{{ path('app_prestation_index') }}" class="text-gold text-decoration-none transition-hover d-inline-block" style="letter-spacing: 1px; text-transform: uppercase; font-size: 0.85rem;">
            <i class="bi bi-arrow-left me-2"></i>Retour aux prestations
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            
    <div class="card-premium shadow-lg overflow-hidden position-relative" style="background-color: rgba(74, 79, 65, 0.55); border: 1px solid rgba(184, 154, 99, 0.2);">                <i class="bi {{ prestation.icone|default('bi-star') }} position-absolute text-gold" style="font-size: 25rem; opacity: 0.03; bottom: -50px; right: -20px; z-index: 0; pointer-events: none;"></i>

                <div class="row g-0 position-relative z-1"> 
                    
                    {# 1. COLONNE IMAGE #}
                    <div class="col-md-5 d-flex">
                        {% if prestation.imageName %}
                            <img src="{{ vich_uploader_asset(prestation, 'imageFile') }}" 
                                alt="{{ prestation.nom }}" 
                                class="img-fluid w-100" 
                                style="height: 100%; min-height: 400px; object-fit: cover; border-right: 1px solid rgba(184, 154, 99, 0.2);">
                        {% else %}
                            {# Application du dégradé Violet (Plum) / Vert (Olive) #}
                            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" 
                                 style="background: linear-gradient(135deg, var(--meta-plum) 0%, var(--meta-olive) 100%); min-height: 400px; border-right: 1px solid rgba(184, 154, 99, 0.2);">
                                <i class="bi {{ prestation.icone|default('bi-star') }} text-gold opacity-50 mb-3" style="font-size: 4rem;"></i>
                                <span class="text-gold typo-symbolic opacity-50 fs-5 text-uppercase">Metamorphysis</span>
                            </div>
                        {% endif %}
                    </div>

                    {# 2. COLONNE CONTENU #}
                    <div class="col-md-7 d-flex flex-column p-4 p-md-5">
                                                {# En-tête : Icône, Titre et Prix #}
                        <div class="mb-4">
                            <i class="bi {{ prestation.icone|default('bi-star') }} text-gold fs-3 mb-2 d-block"></i>
                            <h1 class="text-gold typo-titre mb-3" style="font-size: 2.5rem; letter-spacing: 1px;">{{ prestation.nom }}</h1>
                            
                            <div class="d-flex flex-wrap align-items-center gap-3 text-ivory">
                                <span class="fs-4 fw-bold text-gold">
                                    {% if prestation.prixAffiche %}
                                        {{ prestation.prixAffiche }}
                                    {% else %}
                                        {{ prestation.calculerPrixTotal(prestation.minPersonnes) }} € 
                                        {% if prestation.unitePrix %}<span class="fs-6 fw-light text-uppercase">/ {{ prestation.unitePrix }}</span>{% endif %}
                                    {% endif %}
                                </span>
                                
                                {% if prestation.duree %}
                                    <span class="text-sage border-start border-sage ps-3">
                                        <i class="bi bi-clock me-1"></i>{{ prestation.duree }} minutes
                                    </span>
                                {% endif %}

                                {% if prestation.nombreSeances > 1 %}
                                    <span class="text-sage border-start border-sage ps-3">
                                        <i class="bi bi-ticket-perforated me-1"></i>{{ prestation.nombreSeances }} séances
                                    </span>
                                {% endif %}
                            </div>
                        </div>


                        {# Section Vidéo Optionnelle #}
                        {% if prestation.lienVideo %}
                            <div class="mb-4 mt-2">
                                <a href="{{ prestation.lienVideo }}" target="_blank" class="btn btn-outline-gold w-100 py-3 d-flex align-items-center justify-content-center transition-hover" style="border-radius: 0;">
                                    <i class="bi bi-play-circle-fill fs-4 me-3"></i> 
                                    <span style="letter-spacing: 1px; text-transform: uppercase;">Voir la vidéo de présentation</span>
                                </a>
                            </div>
                        {% endif %}

                        {# Description Longue (Contenu Premium Amélioré) #}
                        {% if prestation.descriptionComplementaire %}
                            <div class="mt-4 pt-4 border-top border-gold-subtle">
                                <h2 class="text-gold typo-symbolic fs-6 text-uppercase mb-4" style="letter-spacing: 3px; opacity: 0.8;">
                                    Le Déroulé du Soin
                                </h2>
                                
                                <div class="content-premium-text text-ivory flex-grow-1" style="
                                    font-family: 'Playfair Display', 'Didot', 'Georgia', serif;
                                    font-size: 1.05rem; 
                                    line-height: 1.9; 
                                    font-weight: 300; 
                                    letter-spacing: 0.5px;
                                    white-space: pre-line;
                                ">
                                    {{ prestation.descriptionComplementaire }}
                                </div>
                            </div>
                        {% endif %}

                        {# Section Formules & Tarifs Fixés par l'Admin #}
                        {% if prestation.hasTarificationVariable %}
                            <div class="my-4 p-4" style="background-color: var(--meta-olive); border: 1px solid var(--meta-gold); box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);">
                                <label class="form-label text-uppercase small fw-bold mb-3 d-flex align-items-center" style="letter-spacing: 1.5px; color: var(--meta-ivory);">
                                    <i class="bi bi-people-fill me-2 fs-5" style="color: var(--meta-gold);"></i>Formule & Nombre de participants
                                </label>
                                <div class="d-flex flex-wrap gap-2" id="formula-options">
                                    {% for i in prestation.minPersonnes..prestation.maxPersonnes %}
                                        {% set details = prestation.getFormuleDetails(i) %}
                                        <div class="formula-card flex-fill p-3 text-center transition-hover position-relative {% if loop.first %}active-formula{% endif %}" 
                                             data-personnes="{{ i }}" 
                                             data-price="{{ details.prix }}"
                                             style="background-color: var(--meta-plum); {% if loop.first %}border: 2px solid var(--meta-gold); box-shadow: 0 0 10px rgba(184, 154, 99, 0.45);{% else %}border: 1px solid rgba(184, 154, 99, 0.35); opacity: 0.85;{% endif %} cursor: pointer; min-width: 140px;">
                                            <div class="fw-bold mb-1" style="color: var(--meta-ivory); font-size: 0.88rem; text-transform: uppercase; letter-spacing: 1px;">
                                                <i class="bi bi-people me-1" style="color: var(--meta-gold);"></i>{{ details.titre }}
                                            </div>
                                            <div class="fw-bold" style="color: var(--meta-gold); font-size: 1.35rem;">
                                                {{ details.prix }} €
                                            </div>
                                            {% if details.sousTitre %}
                                                <div class="small mt-1" style="color: var(--meta-ivory-dim); font-size: 0.78rem;">
                                                    {{ details.sousTitre }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        {# Bouton d'action Réserver / Info Accompagnement en cours / Info Consultation Initiale requise #}
                        {% if app.user and not app.user.canBookPrestation(prestation) %}
                            <div class="mt-4 p-4" style="background-color: rgba(184, 154, 99, 0.1); border: 1px solid rgba(184, 154, 99, 0.4); border-left: 4px solid var(--meta-gold);">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-shield-lock-fill fs-4" style="color: var(--meta-gold);"></i>
                                    <h3 class="m-0 text-gold fs-6 text-uppercase" style="letter-spacing: 1.5px; font-family: var(--font-title), serif;">Consultation Initiale Préalable Requise</h3>
                                </div>
                                <p class="text-ivory small mb-3" style="line-height: 1.6; opacity: 0.95; color: var(--meta-ivory);">
                                    Afin d'adapter ce parcours sur-mesure à votre histoire et vos objectifs, vous devez préalablement réaliser votre <strong>Consultation Initiale</strong> avec Louisa Chouihi.
                                </p>
                                <a href="{{ path('app_prestation_show', {'slug': 'consultation-initiale'}) }}" 
                                   class="btn w-100 py-3 fw-bold text-uppercase transition-hover d-flex align-items-center justify-content-center gap-2" 
                                   style="background-color: var(--meta-plum); color: var(--meta-gold); border: 1px solid var(--meta-gold); letter-spacing: 2px; border-radius: 0; font-size: 0.85rem;">
                                    <i class="bi bi-calendar-check me-1"></i>Réserver ma Consultation Initiale
                                </a>
                            </div>
                        {% elseif app.user and app.user.hasActivePrestation(prestation) %}
                            <div class="mt-4 p-4" style="background-color: rgba(255, 193, 7, 0.08); border: 1px solid rgba(255, 193, 7, 0.35); border-left: 4px solid #E5C78D;">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-info-circle-fill fs-4" style="color: #E5C78D;"></i>
                                    <h3 class="m-0 text-gold fs-6 text-uppercase" style="letter-spacing: 1.5px; font-family: var(--font-title), serif;">Accompagnement déjà en cours</h3>
                                </div>
                                <p class="text-ivory small mb-3" style="line-height: 1.6; opacity: 0.9; color: var(--meta-ivory);">
                                    Vous suivez actuellement ce parcours d'accompagnement. Vous ne pouvez pas souscrire de nouveau à cette même prestation tant que vos séances actuelles ne sont pas achevées.
                                </p>
                                <a href="{{ path('app_account') }}" 
                                   class="btn w-100 py-3 fw-bold text-uppercase transition-hover" 
                                   style="background-color: var(--meta-plum); color: var(--meta-gold); border: 1px solid var(--meta-gold); letter-spacing: 2px; border-radius: 0; font-size: 0.85rem;">
                                    <i class="bi bi-person-circle me-2"></i>Accéder à mon espace personnel
                                </a>
                            </div>
                        {% elseif prestation.estCollectif %}
                            {# --- SECTION SPÉCIFIQUE : ATELIER DE GROUPE & THÉRAPIE COLLECTIVE (OPTION A) --- #}
                            <div class="mt-4 pt-4 border-top border-gold-subtle">
                                <div class="p-4" style="background: rgba(26, 28, 24, 0.85); border: 1px solid var(--meta-gold); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h3 class="m-0 text-gold fs-5 text-uppercase" style="letter-spacing: 1.5px; font-family: var(--font-title), serif;">
                                            <i class="bi bi-people-fill me-2"></i>Atelier de Groupe & Éveil
                                        </h3>
                                        <span class="badge" style="background: var(--meta-plum); color: var(--meta-gold); border: 1px solid var(--meta-gold); font-size: 0.85rem;">
                                            Tarif unique : {{ prestation.prix|default(30) }} € / pers
                                        </span>
                                    </div>

                                    {% if prestation.recurrence %}
                                        <p class="text-ivory small mb-3">
                                            <i class="bi bi-calendar-event text-gold me-2"></i><strong>Fréquence :</strong> {{ prestation.recurrence }}
                                        </p>
                                    {% endif %}

                                    {# Liste des sessions disponibles #}
                                    {% set sessionsValides = [] %}
                                    {% for s in prestation.sessionsGroupe %}
                                        {% if s.dateDebut > date() and s.statut != 'Annulé' %}
                                            {% set sessionsValides = sessionsValides|merge([s]) %}
                                        {% endif %}
                                    {% endfor %}

                                    {% if sessionsValides|length > 0 %}
                                        <div class="mb-3">
                                            {% if sessionsValides|length > 1 %}
                                                <label class="form-label text-ivory small text-uppercase fw-bold" style="letter-spacing: 1px;">Choisissez votre créneau :</label>
                                            {% else %}
                                                <label class="form-label text-ivory small text-uppercase fw-bold" style="letter-spacing: 1px;">Prochaine session programmée :</label>
                                            {% endif %}
                                            <div class="d-flex flex-column gap-2" id="sessions-group-list">
                                                {% for s in sessionsValides %}
                                                    <div class="session-item p-3 border transition-hover position-relative {% if loop.first %}selected-session{% endif %}"
                                                         data-session-id="{{ s.id }}"
                                                         data-date="{{ s.dateDebut|date('d/m/Y à H:i') }}"
                                                         data-inscrits="{{ s.nombreInscrits }}"
                                                         data-seuil="{{ s.seuilMinimum }}"
                                                         data-max="{{ s.capaciteMaximale }}"
                                                         data-complet="{{ s.isComplet ? '1' : '0' }}"
                                                         style="background: var(--meta-plum); {% if loop.first %}border-color: var(--meta-gold) !important; box-shadow: 0 0 10px rgba(184, 154, 99, 0.4);{% else %}border-color: rgba(184, 154, 99, 0.3) !important; opacity: 0.85;{% endif %} cursor: pointer;">
                                                        
                                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                                            <div class="text-ivory fw-bold">
                                                                <i class="bi bi-calendar-check text-gold me-2"></i>{{ s.dateDebut|date('d/m/Y à H:i') }}
                                                                {% if s.dateFin %} - {{ s.dateFin|date('H:i') }}{% endif %}
                                                            </div>
                                                            <span class="badge" style="{% if s.isComplet %}background-color: rgba(42, 26, 30, 0.9); border: 1px solid rgba(220, 53, 69, 0.6); color: #ff8b94;{% elseif s.isQuorumAtteint %}background-color: var(--meta-olive); border: 1px solid var(--meta-gold); color: var(--meta-ivory);{% else %}background-color: var(--meta-plum); border: 1px solid var(--meta-gold); color: var(--meta-gold);{% endif %}">
                                                                {% if s.isComplet %}Complet{% elseif s.isQuorumAtteint %}<i class="bi bi-check2-circle text-gold me-1"></i>Quorum validé{% else %}<i class="bi bi-hourglass-split me-1"></i>En cours{% endif %}
                                                            </span>
                                                        </div>

                                                        {# JAUGE PROGRESSION DYNAMIQUE #}
                                                        <div class="d-flex justify-content-between small mb-1 text-ivory">
                                                            <span>Progression : <strong class="text-gold">{{ s.nombreInscrits }}</strong> / {{ s.seuilMinimum }} requis (max {{ s.capaciteMaximale }})</span>
                                                            <span class="text-gold fw-bold">
                                                                {% if s.isQuorumAtteint %}
                                                                    <i class="bi bi-check-circle-fill text-gold me-1"></i>Session garantie
                                                                {% else %}
                                                                    Plus que {{ s.seuilMinimum - s.nombreInscrits }} place(s)
                                                                {% endif %}
                                                            </span>
                                                        </div>
                                                        <div class="progress" style="height: 8px; background-color: rgba(10, 10, 9, 0.7); border: 1px solid rgba(184, 154, 99, 0.3); border-radius: 0;">
                                                            {% set pct = (s.nombreInscrits / s.seuilMinimum) * 100 %}
                                                            {% if pct > 100 %}{% set pct = 100 %}{% endif %}
                                                            <div class="progress-bar" role="progressbar" 
                                                                 style="width: {{ pct }}%; background: linear-gradient(90deg, var(--meta-gold), #E5C78D); border-radius: 0;" 
                                                                 aria-valuenow="{{ s.nombreInscrits }}" aria-valuemin="0" aria-valuemax="{{ s.seuilMinimum }}">
                                                            </div>
                                                        </div>

                                                        <div class="mt-3 pt-2 d-flex justify-content-between align-items-center" style="border-top: 1px solid rgba(184, 154, 99, 0.2);">
                                                            <span class="text-ivory small opacity-75"><i class="bi bi-shield-lock text-gold me-1"></i>0,00 € débité aujourd'hui</span>
                                                            <span class="btn btn-sm text-uppercase" style="background-color: rgba(184, 154, 99, 0.2); border: 1px solid var(--meta-gold); color: var(--meta-gold); font-size: 0.72rem; letter-spacing: 1px;">
                                                                Réserver ce créneau <i class="bi bi-arrow-right ms-1"></i>
                                                            </span>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>

                                        <button type="button" id="btn-open-group-modal" 
                                                class="btn w-100 py-3 fw-bold text-uppercase transition-hover d-flex align-items-center justify-content-center gap-2" 
                                                style="background: linear-gradient(135deg, var(--meta-plum) 0%, rgba(74, 79, 65, 0.9) 100%); color: var(--meta-gold); border: 1px solid var(--meta-gold); letter-spacing: 2px; border-radius: 0;">
                                            <i class="bi bi-credit-card-2-front text-gold me-1"></i>
                                            <span style="color: var(--meta-ivory);">Pré-réserver ma place</span>
                                            <span class="badge text-gold ms-2 px-3 py-1" style="background-color: rgba(10, 10, 9, 0.85); border: 1px solid var(--meta-gold); font-size: 0.9rem;">0,00 € débité</span>
                                        </button>

                                        <div class="text-center mt-2 small text-ivory opacity-75">
                                            <i class="bi bi-shield-check text-gold me-1"></i>Empreinte bancaire sécurisée. Aucun prélèvement de {{ prestation.prix|default(30) }} € tant que les 5 participants ne sont pas réunis.
                                        </div>
                                    {% else %}
                                        <div class="p-4 text-ivory text-center" style="background: rgba(74, 79, 65, 0.35); border: 1px solid rgba(184, 154, 99, 0.3);">
                                            <i class="bi bi-info-circle text-gold fs-4 d-block mb-2"></i>
                                            Les prochaines dates d'ateliers seront programmées très prochainement par Louisa Chouihi.
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            <div class="mt-4 pt-3" style="border-top: 1px solid rgba(184, 154, 99, 0.2);">
                                <a id="btn-reserver-prestation" href="{{ path('app_reservation_new', {'slug': prestation.slug|default(prestation.id), 'personnes': prestation.minPersonnes}) }}" 
                                   class="btn w-100 py-3 fw-bold text-uppercase transition-hover d-flex align-items-center justify-content-center gap-2" 
                                   style="background-color: var(--meta-plum); color: var(--meta-gold); border: 1px solid var(--meta-gold); letter-spacing: 2px; border-radius: 0;">
                                    <span style="color: var(--meta-ivory);">Réserver cette séance</span>
                                    <span id="btn-price-preview" class="badge text-gold ms-2 px-3 py-1" style="background-color: rgba(10, 10, 9, 0.85); border: 1px solid var(--meta-gold); font-size: 0.95rem; color: var(--meta-gold);">{{ prestation.getTarifPour(prestation.minPersonnes) }} €</span>
                                </a>
                            </div>
                        {% endif %}
                        
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

{# --- MODAL DE PRÉ-RÉSERVATION AVEC EMPREINTE BANCAIRE (OPTION A) --- #}
{% if prestation.estCollectif %}
<div class="modal fade" id="modalPrereservationGroupe" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg" style="background: radial-gradient(ellipse at 50% 15%, var(--meta-plum) 0%, var(--meta-plum-dark) 60%, var(--meta-black) 100%); border: 1px solid var(--meta-gold); box-shadow: 0 15px 50px rgba(0, 0, 0, 0.85), 0 0 30px rgba(184, 154, 99, 0.25) !important; border-radius: 0;">
            <div class="modal-header border-0 pb-2">
                <div>
                    <h5 class="modal-title text-gold typo-titre fs-4 text-uppercase" style="letter-spacing: 1.5px;">
                        <i class="bi bi-shield-lock me-2"></i>Pré-réservation
                    </h5>
                    <div class="text-ivory small opacity-75">Atelier Collectif &bull; {{ prestation.nom }}</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body p-4">
                {# Résumé Créneau sélectionné #}
                <div class="p-3 mb-3 d-flex justify-content-between align-items-center" style="background: rgba(74, 79, 65, 0.35); border: 1px solid rgba(184, 154, 99, 0.35); border-radius: 0;">
                    <span class="text-ivory small"><i class="bi bi-calendar3 text-gold me-2"></i>Date : <strong id="modal-session-date" class="text-gold">-</strong></span>
                    <span class="badge px-2 py-1" style="background-color: var(--meta-olive); border: 1px solid var(--meta-gold); color: var(--meta-ivory); font-weight: 500; font-size: 0.78rem; letter-spacing: 0.5px;">
                        <i class="bi bi-shield-check text-gold me-1"></i>0,00 € débité
                    </span>
                </div>

                <form id="form-prereservation-groupe">
                    <input type="hidden" id="input-session-id" value="">

                    {% if app.user %}
                        {# UTILISATEUR CONNECTÉ : Champs masqués + récapitulatif élégant #}
                        <input type="hidden" id="group-prenom" value="{{ app.user.prenom }}">
                        <input type="hidden" id="group-nom" value="{{ app.user.nom }}">
                        <input type="hidden" id="group-email" value="{{ app.user.email }}">
                        <input type="hidden" id="group-telephone" value="{{ app.user.telephone }}">

                        <div class="p-3 mb-3 d-flex align-items-center justify-content-between" style="background: rgba(42, 26, 30, 0.6); border: 1px solid rgba(184, 154, 99, 0.35); border-radius: 0;">
                            <div>
                                <div class="text-gold fw-bold small text-uppercase" style="letter-spacing: 1px;">
                                    <i class="bi bi-person-check-fill me-1"></i>Participant connecté
                                </div>
                                <div class="text-ivory small mt-1">
                                    {{ app.user.prenom }} {{ app.user.nom }} &bull; <span class="opacity-75">{{ app.user.email }}</span>
                                </div>
                            </div>
                            <span class="badge" style="background-color: rgba(74, 79, 65, 0.7); border: 1px solid var(--meta-sage); color: var(--meta-ivory); font-size: 0.75rem;">
                                <i class="bi bi-check2 text-gold me-1"></i>Identifié
                            </span>
                        </div>
                    {% else %}
                        {# VISITEUR NON CONNECTÉ : Formulaire complet #}
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-ivory small text-uppercase">Prénom *</label>
                                <input type="text" id="group-prenom" class="form-control" required 
                                       style="background: rgba(10, 10, 9, 0.75); border: 1px solid rgba(184, 154, 99, 0.4); color: var(--meta-ivory); border-radius: 0;">
                            </div>
                            <div class="col-6">
                                <label class="form-label text-ivory small text-uppercase">Nom *</label>
                                <input type="text" id="group-nom" class="form-control" required
                                       style="background: rgba(10, 10, 9, 0.75); border: 1px solid rgba(184, 154, 99, 0.4); color: var(--meta-ivory); border-radius: 0;">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-ivory small text-uppercase">Adresse Email *</label>
                            <input type="email" id="group-email" class="form-control" required
                                   style="background: rgba(10, 10, 9, 0.75); border: 1px solid rgba(184, 154, 99, 0.4); color: var(--meta-ivory); border-radius: 0;">
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-ivory small text-uppercase">Téléphone (SMS de rappel) *</label>
                            <input type="tel" id="group-telephone" class="form-control" required
                                   style="background: rgba(10, 10, 9, 0.75); border: 1px solid rgba(184, 154, 99, 0.4); color: var(--meta-ivory); border-radius: 0;">
                        </div>
                    {% endif %}

                    {# ZONE CARTE BANCAIRE STRIPE #}
                    <div class="mb-4">
                        <label class="form-label text-ivory small text-uppercase d-flex justify-content-between align-items-center mb-2">
                            <span><i class="bi bi-credit-card text-gold me-1"></i>Coordonnées bancaires (Numéro, Date, CVC) *</span>
                            <span class="text-gold small"><i class="bi bi-lock-fill me-1"></i>3D Secure</span>
                        </label>
                        <div id="stripe-card-element" class="p-3" style="background: rgba(10, 10, 9, 0.75); border: 1px solid var(--meta-gold); border-radius: 0;">
                            <!-- Stripe injectera l'input de carte ici -->
                        </div>
                        <div id="stripe-card-errors" class="text-danger small mt-2" role="alert"></div>
                    </div>

                    {# ENCART ENGAGEMENT & TRANSPARENCE (Charte Pourpre & Olive & Or) #}
                    <div class="p-3 mb-4 small" style="background: linear-gradient(135deg, rgba(74, 79, 65, 0.4) 0%, rgba(42, 26, 30, 0.5) 100%); border: 1px solid var(--meta-gold); border-radius: 0; line-height: 1.5;">
                        <div class="text-gold fw-bold mb-1 d-flex align-items-center gap-1" style="letter-spacing: 0.5px;">
                            <i class="bi bi-info-circle-fill text-gold"></i>
                            <span>ENGAGEMENT &amp; TRANSPARENCE :</span>
                        </div>
                        <div class="text-ivory" style="opacity: 0.95;">
                            Votre carte ne sera prélevée de <strong class="text-gold">{{ prestation.prix|default(30) }} €</strong> que si l'atelier réunit au moins <strong class="text-gold">5 participants</strong>. Si ce quorum n'est pas atteint, l'empreinte bancaire s'annule automatiquement sans aucun frais.
                        </div>
                    </div>

                    <button type="submit" id="btn-submit-prereservation" class="btn w-100 py-3 fw-bold text-uppercase transition-hover d-flex align-items-center justify-content-center gap-2"
                            style="background-color: var(--meta-plum); color: var(--meta-gold); border: 1px solid var(--meta-gold); letter-spacing: 2px; border-radius: 0;">
                        <i class="bi bi-lock-fill text-gold"></i>
                        <span id="btn-submit-text" style="color: var(--meta-ivory);">Confirmer ma pré-réservation (0 €)</span>
                        <div id="btn-submit-spinner" class="spinner-border spinner-border-sm text-gold d-none" role="status"></div>
                    </button>
                </form>

                {# MESSAGE DE SUCCÈS #}
                <div id="group-success-box" class="d-none text-center py-4">
                    <i class="bi bi-check-circle-fill text-gold" style="font-size: 3.5rem;"></i>
                    <h4 class="text-gold typo-titre mt-3 fs-3">Pré-réservation validée !</h4>
                    <p class="text-ivory mt-2" id="group-success-msg">Votre place est réservée. Aucun montant n'a été débité.</p>
                    <div class="p-3 my-3" style="background: rgba(74, 79, 65, 0.4); border: 1px solid var(--meta-gold); border-radius: 0;">
                        <div class="text-gold fw-bold" id="group-success-gauge">-</div>
                    </div>
                    <button type="button" class="btn btn-outline-gold mt-2 px-4 py-2" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script src="https://js.stripe.com/v3/"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // 1. GESTION DES FORMULES CLASSIQUES
    const formulaCards = document.querySelectorAll('.formula-card');
    const btnPricePreview = document.getElementById('btn-price-preview');
    const btnReserver = document.getElementById('btn-reserver-prestation');
    const baseReservationUrl = "{{ path('app_reservation_new', {'slug': prestation.slug|default(prestation.id)}) }}";

    formulaCards.forEach(card => {
        card.addEventListener('click', function() {
            formulaCards.forEach(c => {
                c.classList.remove('active-formula');
                c.style.backgroundColor = 'var(--meta-plum)';
                c.style.border = '1px solid var(--meta-sage)';
                c.style.boxShadow = 'none';
                c.style.opacity = '0.85';
            });

            this.classList.add('active-formula');
            this.style.backgroundColor = 'var(--meta-plum)';
            this.style.border = '2px solid var(--meta-gold)';
            this.style.boxShadow = '0 0 12px rgba(184, 154, 99, 0.4)';
            this.style.opacity = '1';

            const nbPers = this.getAttribute('data-personnes');
            const price = this.getAttribute('data-price');

            if (btnPricePreview) {
                btnPricePreview.innerText = price + ' €';
            }
            if (btnReserver) {
                btnReserver.href = baseReservationUrl + '?personnes=' + nbPers;
            }
        });
    });

    // 2. GESTION DU MODULE ATELIER DE GROUPE
    const sessionItems = document.querySelectorAll('.session-item');
    const btnOpenGroupModal = document.getElementById('btn-open-group-modal');
    const modalEl = document.getElementById('modalPrereservationGroupe');

    if (sessionItems.length > 0 && btnOpenGroupModal && modalEl) {
        // Déplacer la modale sous <body> pour éviter d'être piégé dans le contexte d'empilement du conteneur parent
        if (modalEl.parentNode !== document.body) {
            document.body.appendChild(modalEl);
        }

        let activeSessionId = sessionItems[0].getAttribute('data-session-id');
        let activeSessionDate = sessionItems[0].getAttribute('data-date');

        // Initialisation Stripe Elements
        let stripe = null;
        let cardElement = null;
        let clientSecret = null;

        async function openGroupModal(sessionId, sessionDate) {
            document.getElementById('input-session-id').value = sessionId;
            document.getElementById('modal-session-date').innerText = sessionDate;
            document.getElementById('form-prereservation-groupe').classList.remove('d-none');
            document.getElementById('group-success-box').classList.add('d-none');

            const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
            bsModal.show();

            // Appel pour créer le SetupIntent Stripe
            if (!stripe) {
                try {
                    const resp = await fetch("{{ path('app_atelier_setup_intent') }}", { method: 'POST' });
                    const setupData = await resp.json();
                    if (setupData.publicKey && setupData.clientSecret) {
                        stripe = Stripe(setupData.publicKey);
                        clientSecret = setupData.clientSecret;
                        const elements = stripe.elements({ locale: 'fr' });
                        cardElement = elements.create('card', {
                            hidePostalCode: true,
                            style: {
                                base: {
                                    color: '#FFFFF0',
                                    fontFamily: 'Inter, sans-serif',
                                    fontSize: '15px',
                                    '::placeholder': { color: '#8A8F7C' },
                                    iconColor: '#B89A63'
                                },
                                invalid: { 
                                    color: '#E5C78D',
                                    iconColor: '#FA755A'
                                }
                            }
                        });
                        cardElement.mount('#stripe-card-element');
                    }
                } catch (e) {
                    console.error('Erreur chargement Stripe:', e);
                }
            }
        }

        sessionItems.forEach(item => {
            item.addEventListener('click', function() {
                sessionItems.forEach(s => {
                    s.classList.remove('selected-session');
                    s.style.borderColor = 'rgba(184, 154, 99, 0.3)';
                    s.style.boxShadow = 'none';
                    s.style.opacity = '0.85';
                });

                this.classList.add('selected-session');
                this.style.borderColor = 'var(--meta-gold)';
                this.style.boxShadow = '0 0 10px rgba(184, 154, 99, 0.4)';
                this.style.opacity = '1';

                activeSessionId = this.getAttribute('data-session-id');
                activeSessionDate = this.getAttribute('data-date');

                // Ouvrir immédiatement la modale pour ce créneau
                openGroupModal(activeSessionId, activeSessionDate);
            });
        });

        btnOpenGroupModal.addEventListener('click', function() {
            openGroupModal(activeSessionId, activeSessionDate);
        });

        // Soumission du formulaire de pré-réservation
        const groupForm = document.getElementById('form-prereservation-groupe');
        const submitBtn = document.getElementById('btn-submit-prereservation');
        const submitText = document.getElementById('btn-submit-text');
        const submitSpinner = document.getElementById('btn-submit-spinner');
        const cardErrors = document.getElementById('stripe-card-errors');

        groupForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            cardErrors.textContent = '';
            submitBtn.disabled = true;
            submitText.textContent = 'Sécurisation de l\'empreinte...';
            submitSpinner.classList.remove('d-none');

            const prenom = document.getElementById('group-prenom').value;
            const nom = document.getElementById('group-nom').value;
            const email = document.getElementById('group-email').value;
            const telephone = document.getElementById('group-telephone').value;
            const sessionId = document.getElementById('input-session-id').value;

            try {
                // 1. Validation de la carte et du 3D Secure via Stripe SetupIntent
                const { setupIntent, error } = await stripe.confirmCardSetup(clientSecret, {
                    payment_method: {
                        card: cardElement,
                        billing_details: {
                            name: prenom + ' ' + nom,
                            email: email,
                            phone: telephone
                        }
                    }
                });

                if (error) {
                    cardErrors.textContent = error.message;
                    submitBtn.disabled = false;
                    submitText.textContent = 'Confirmer ma pré-réservation (0 €)';
                    submitSpinner.classList.add('d-none');
                    return;
                }

                // 2. Enregistrement en BDD de l'empreinte validée
                const resInsc = await fetch("{{ path('app_atelier_inscrire') }}", {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        session_id: sessionId,
                        nom: nom,
                        prenom: prenom,
                        email: email,
                        telephone: telephone,
                        payment_method_id: setupIntent.payment_method
                    })
                });

                const inscData = await resInsc.json();

                if (inscData.success) {
                    groupForm.classList.add('d-none');
                    const successBox = document.getElementById('group-success-box');
                    successBox.classList.remove('d-none');

                    if (inscData.quorumAtteint) {
                        document.getElementById('group-success-msg').innerHTML = 
                            '<strong class="text-gold fs-5">🎉 Le quorum des ' + inscData.seuilMinimum + ' participants est atteint !</strong><br>Votre atelier est confirmé. Le prélèvement de 30 € a été validé et votre lien visio vous a été envoyé par email.';
                        document.getElementById('group-success-gauge').innerText = 
                            'Statut : Session Confirmée (' + inscData.totalInscrits + ' participants inscrits)';
                    } else {
                        document.getElementById('group-success-msg').innerHTML = 
                            'Votre carte a été enregistrée avec succès. <strong class="text-gold">Montant débité : 0,00 €</strong>.<br>Vous serez automatiquement prélevé dès que le 5ᵉ participant s\'inscrira.';
                        document.getElementById('group-success-gauge').innerText = 
                            'Jauge actuelle : ' + inscData.totalInscrits + ' sur ' + inscData.seuilMinimum + ' requis';
                    }
                } else {
                    cardErrors.textContent = inscData.error || 'Une erreur est survenue.';
                    submitBtn.disabled = false;
                    submitText.textContent = 'Confirmer ma pré-réservation (0 €)';
                    submitSpinner.classList.add('d-none');
                }
            } catch (err) {
                cardErrors.textContent = 'Erreur réseau ou communication avec Stripe.';
                submitBtn.disabled = false;
                submitText.textContent = 'Confirmer ma pré-réservation (0 €)';
                submitSpinner.classList.add('d-none');
            }
        });
    }
});
</script>
{% endblock %}