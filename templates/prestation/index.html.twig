{% extends 'base.html.twig' %}

{% block title %}Nos Prestations - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# En-tête de la page #}
    <div class="text-center mb-5">
        <h1 class="text-warning display-4" style="font-family: 'Impact', sans-serif; letter-spacing: 2px;">
            NOS PRESTATIONS
        </h1>
        <p class="text-light lead">Découvrez nos offres d'accompagnement sur mesure.</p>
    </div>

    {# Ouverture de la grille pour aligner les cartes #}
    <div class="row g-4 justify-content-center">
        
        {% for prestation in prestations %}
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 bg-dark border-warning shadow-lg transition-hover" style="border-radius: 15px;">
                    <div class="card-body d-flex flex-column p-4">
                        
                        {# Titre et Prix #}
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h3 class="card-title text-warning fw-bold mb-0">{{ prestation.nom }}</h3>
                            <span class="badge bg-warning text-dark fs-5">{{ prestation.prix }} €</span>
                        </div>
                        
                        {# Durée #}
                        <div class="mb-3 text-secondary">
                            <i class="bi bi-clock-history"></i> Durée estimée : {{ prestation.duree }} min
                        </div>
                        
                        {# Description #}
                        <p class="card-text text-white grow">
                            {{ prestation.description }}
                        </p>
                        
                        {# Boutons d'action #}
                        <div class="mt-4 text-center d-flex gap-2">
                            {# Bouton pour voir les détails #}
                            <a href="{{ path('app_prestation_show', {'id': prestation.id}) }}" class="btn btn-warning w-50 fw-bold" style="border-radius: 30px;">
                                DÉTAILS
                            </a>
                            {# Bouton vers le contact #}
                            <a href="{{ path('app_contact') }}" class="btn btn-outline-warning w-50 fw-bold" style="border-width: 2px; border-radius: 30px;">
                                DEVIS
                            </a>
                        </div>
                        
                    </div>
                </div>
            </div>
        {% else %}
            {# Message affiché si la base de données est vide #}
            <div class="col-12 text-center text-white">
                <p>Aucune prestation n'est disponible pour le moment. Revenez très vite !</p>
            </div>
        {% endfor %}
        
    </div> {# Fermeture de la grille (row) #}
</div> {# Fermeture du container #}

{# CSS pour l'effet de survol #}
<style>
    .transition-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(212, 175, 55, 0.2) !important;
    }
</style>
{% endblock %}