{% extends 'base.html.twig' %}

{% block title %}Nos Prestations - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# En-tête de la page #}
    <div class="text-center mb-5">
        <h1 class="text-gold display-4 fw-bold typo-titre">NOS PRESTATIONS</h1>
        <p class="text-ivory lead">Découvrez nos offres d'accompagnement sur mesure.</p>
    </div>

    {# --- DÉBUT DU CARROUSEL --- #}
    <div class="prestation-slider-container">
        
        <button class="slider-btn slider-btn-left d-none d-md-flex align-items-center justify-content-center" aria-label="Précédent">
            <i class="bi bi-chevron-left fs-4"></i>
        </button>

        <div class="prestation-track" id="prestationTrack">
            
            {% for prestation in prestations %}
                <div class="prestation-card-item">
                    <div class="card card-premium shadow-lg h-100 overflow-hidden transition-hover text-center d-flex flex-column" style="padding: 0 0 1.5rem 0;">
                        
                        {# 1. ZONE SUPÉRIEURE (Image ou Icône minimaliste élégante) #}
                        {% if prestation.imageName %}
                            <img src="{{ vich_uploader_asset(prestation, 'imageFile') }}" 
                                 class="card-img-top object-fit-cover" 
                                 alt="{{ prestation.nom }}" 
                                 style="height: 220px; border-bottom: 1px solid rgba(184, 154, 99, 0.2);">
                        {% else %}
                            {# Alternative haut de gamme : Une icône centrée dans un cercle, comme sur l'accueil #}
                            <div class="card-img-top d-flex flex-column align-items-center justify-content-center" 
                                 style="height: 220px; background-color: rgba(74, 79, 65, 0.1); border-bottom: 1px solid rgba(184, 154, 99, 0.2);">
                                <div class="rounded-circle border border-gold d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background-color: rgba(184, 154, 99, 0.02);">
                                    <i class="bi {{ prestation.icone|default('bi-person') }} text-gold fs-3"></i>
                                </div>
                            </div>
                        {% endif %}

                        {# 2. LE CONTENU DE LA CARTE #}
                        <div class="card-body d-flex flex-column p-4 flex-grow-1">
                            {# Titre sur une ligne ou deux centré #}
                            <h3 class="text-gold fs-6 text-uppercase mb-2" style="letter-spacing: 1px; font-family: var(--font-title), serif; min-height: 45px; display: flex; align-items: center; justify-content: center;">
                                {{ prestation.nom }}
                            </h3>
                            
                            {# Le petit trait séparateur de l'accueil #}
                            <hr class="mx-auto mb-3" style="width: 35px; height: 1px; background-color: var(--meta-gold); border: none; opacity: 0.4;">
                            
                            <p class="text-sage small mb-3" style="font-size: 0.8rem;">
                                <i class="bi bi-clock me-1"></i> {{ prestation.duree }} min
                            </p>
                            
                            {# Description nettoyée et calibrée #}
                            {% set desc_clean = prestation.description|striptags|replace({'&nbsp;': ' '}) %}
                            <p class="text-ivory mb-4 flex-grow-1 small" style="line-height: 1.5; font-size: 0.8rem; min-height: 72px;">
                                {{ desc_clean|length > 90 ? desc_clean|slice(0, 90) ~ '...' : desc_clean }}
                            </p>
                            
                            <p class="text-gold small mb-4 fw-bold" style="letter-spacing: 1px; font-size: 0.9rem;">
                                {{ prestation.prix }} €
                            </p>
                            
                            {# 3. LES ACTION BOUTONS (Superposés pour plus d'espace et de clarté) #}
                            <div class="d-flex flex-column gap-2 mt-auto w-100 px-2">
                                <a href="{{ path('app_reservation_new', {'id': prestation.id}) }}"class="btn w-100 text-gold text-uppercase rounded-0 py-2" style="background-color: #2A1A1E; border: 1px solid rgba(184, 154, 99, 0.3); font-size: 0.75rem; letter-spacing: 1px; transition: all 0.3s ease;">
                                    RÉSERVER
                                </a>
                                <a href="{{ path('app_prestation_show', {'id': prestation.id}) }}" class="btn w-100 text-gold text-uppercase rounded-0 py-2" style="background-color: #2A1A1E; border: 1px solid rgba(184, 154, 99, 0.3); font-size: 0.75rem; letter-spacing: 1px; transition: all 0.3s ease;">
                                    DÉTAILS
                                </a> 
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center text-ivory w-100 py-5">
                    <p class="text-sage">Aucune prestation n'est disponible pour le moment.</p>
                </div>
            {% endfor %}
            
        </div>

        <button class="slider-btn slider-btn-right d-none d-md-flex align-items-center justify-content-center" aria-label="Suivant">
            <i class="bi bi-chevron-right fs-4"></i>
        </button>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const track = document.getElementById('prestationTrack');
        const btnLeft = document.querySelector('.slider-btn-left');
        const btnRight = document.querySelector('.slider-btn-right');

        if(track && btnLeft && btnRight) {
            const card = document.querySelector('.prestation-card-item');
            
            if (card) {
                // Calcule la largeur d'une carte + l'espace (gap)
                const scrollAmount = card.offsetWidth + 15; 

                btnLeft.addEventListener('click', () => {
                    track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                });

                btnRight.addEventListener('click', () => {
                    track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });
            }
        }
    });
</script>
{% endblock %}