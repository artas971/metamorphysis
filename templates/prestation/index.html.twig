{% extends 'base.html.twig' %}

{% block title %}Nos Prestations - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# En-tête de la page #}
    <div class="text-center mb-5">
        <h1 class="text-gold display-4 fw-bold typo-titre">NOS PRESTATIONS</h1>
        <p class="text-ivory lead">Découvrez nos offres d'accompagnement sur mesure.</p>
    </div>

 {# --- DÉBUT DU CARROUSEL --- #}
    <div class="prestation-slider-container">
        
        {# Bouton Précédent (Masqué sur mobile grâce à d-none d-md-flex) #}
        <button class="slider-btn slider-btn-left d-none d-md-flex align-items-center justify-content-center" aria-label="Précédent">
            <i class="bi bi-chevron-left fs-4"></i>
        </button>

        {# Ajout de l'ID "prestationTrack" pour que le JavaScript le trouve #}
        <div class="prestation-track" id="prestationTrack">
            
            {% for prestation in prestations %}
                {# ... TON CODE ACTUEL DE LA CARTE RESTE STRICTEMENT IDENTIQUE ICI ... #}
                <div class="prestation-card-item">
                    <div class="card card-premium shadow-lg h-100 overflow-hidden transition-hover">
                        {# 1. L'IMAGE TOUT EN HAUT #}
                        {% if prestation.imageName %}
                            <img src="{{ vich_uploader_asset(prestation, 'imageFile') }}" 
                                 class="card-img-top object-fit-cover" 
                                 alt="{{ prestation.nom }}" 
                                 style="height: 250px; border-bottom: 1px solid rgba(184, 154, 99, 0.3);">
                        {% else %}
                            <div class="card-img-top bg-grad-subtle d-flex align-items-center justify-content-center" 
                                 style="height: 250px; border-bottom: 1px solid rgba(184, 154, 99, 0.3);">
                                <h3 class="text-gold fw-bold typo-symbolic" style="opacity: 0.5;">METAMORPHYSIS</h3>
                            </div>
                        {% endif %}

                        {# 2. LE CONTENU DE LA CARTE #}
                        <div class="card-body d-flex flex-column p-4">
                            <h4 class="text-gold fw-bold mb-3 typo-titre">
                                {{ prestation.nom }} 
                                <span class="float-end text-ivory fs-5">{{ prestation.prix }} €</span>
                            </h4>
                            <p class="text-sage mb-3">
                                <i class="bi bi-clock"></i> {{ prestation.duree }} min
                            </p>
                            <div class="text-ivory mb-4 flex-grow-1">
                                {{ prestation.description|raw }}
                            </div>
                            <div class="d-flex justify-content-between mt-auto gap-3">
                                <a href="{{ path('app_prestation_show', {'id': prestation.id}) }}" class="btn btn-premium w-50 text-center">DÉTAILS</a> 
                                <a href="{{ path('app_reservation_new', {'id': prestation.id}) }}" class="btn btn-gold w-50 text-center">RÉSERVER</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center text-ivory w-100">
                    <p>Aucune prestation n'est disponible pour le moment.</p>
                </div>
            {% endfor %}
            
        </div> {# Fermeture de prestation-track #}

        {# Bouton Suivant #}
        <button class="slider-btn slider-btn-right d-none d-md-flex align-items-center justify-content-center" aria-label="Suivant">
            <i class="bi bi-chevron-right fs-4"></i>
        </button>

    </div> {# Fermeture de prestation-slider-container #}
</div> {# Fermeture du container #}

{# Le moteur JavaScript du Slider #}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const track = document.getElementById('prestationTrack');
        const btnLeft = document.querySelector('.slider-btn-left');
        const btnRight = document.querySelector('.slider-btn-right');

        if(track && btnLeft && btnRight) {
            // Distance de défilement : 380px (carte) + 32px (gap de 2rem)
            const scrollAmount = 412; 

            btnLeft.addEventListener('click', () => {
                track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            });

            btnRight.addEventListener('click', () => {
                track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            });
        }
    });
</script>
{% endblock %}