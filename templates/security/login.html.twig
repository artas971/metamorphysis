{% extends 'base.html.twig' %}

{% block title %}Connexion - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card card-premium shadow-lg">
                <div class="card-body p-5">
                    <h2 class="text-center text-gold fw-bold mb-4 typo-titre">CONNEXION</h2>

                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger mb-4" style="background: transparent; border: 1px solid #dc3545; color: #dc3545;">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}

                        {% if app.user %}
                            <div class="mb-3 text-center text-ivory">
                                Déjà connecté : <strong class="text-gold">{{ app.user.userIdentifier }}</strong>.
                                <a href="{{ path('app_logout') }}" class="text-sage small d-block mt-2">Déconnexion</a>
                            </div>
                        {% else %}
                            <div class="mb-4">
                                <label for="inputEmail" class="form-label text-gold typo-symbolic small">ADRESSE EMAIL</label>
                                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control input-premium" required autofocus>
                            </div>

                            <div class="mb-3">
                                <label for="inputPassword" class="form-label text-gold typo-symbolic small">MOT DE PASSE</label>
                                <input type="password" name="password" id="inputPassword" class="form-control input-premium" required>
                            </div>

                            <div class="mb-4 text-end">
                                <a href="{{ path('app_forgot_password_request') }}" class="text-sage text-decoration-none small">Mot de passe oublié ?</a>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="mb-4 form-check">
                                <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input" style="background-color: var(--meta-black); border-color: var(--meta-gold);">
                                <label class="form-check-label text-ivory small" for="remember_me">Se souvenir de moi</label>
                            </div>

                            <button class="btn btn-gold w-100 py-3" type="submit">ENTRER</button>
                        {% endif %}
                    </form>

                    <div class="text-center mt-4 pt-3 border-top border-sage">
                        <p class="small text-ivory">Nouveau client ? <a href="{{ path('app_register') }}" class="text-gold text-decoration-none">Créer un compte</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}