{% extends 'base.html.twig' %}

{% block title %}Connexion - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card bg-dark border-secondary text-light shadow-lg">
                <div class="card-body p-5">
                    <h2 class="text-center text-or fw-bold mb-4">Se connecter</h2>

                    <form method="post">
                        {# Affichage des erreurs de connexion (mauvais mot de passe, etc.) #}
                        {% if error %}
                            <div class="alert alert-danger bg-danger text-light border-0">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}

                        {# Message si l'utilisateur est déjà connecté #}
                        {% if app.user %}
                            <div class="mb-3 text-center">
                                Vous êtes déjà connecté en tant que <strong class="text-or">{{ app.user.userIdentifier }}</strong>.<br>
                                <a href="{{ path('app_logout') }}" class="text-muted small text-decoration-none mt-2 d-block">Me déconnecter</a>
                            </div>
                        {% else %}

                            <div class="mb-3">
                                <label for="inputEmail" class="form-label text-or">Adresse Email</label>
                                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control bg-dark text-light border-secondary" autocomplete="email" required autofocus>
                            </div>

                            <div class="mb-3">
                                <label for="inputPassword" class="form-label text-or">Mot de passe</label>
                                <input type="password" name="password" id="inputPassword" class="form-control bg-dark text-light border-secondary" autocomplete="current-password" required>
                            </div>

                            {# Jeton de sécurité obligatoire pour Symfony #}
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            {# La case "Se souvenir de moi" #}
                            <div class="mb-4 form-check text-muted small">
                                <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input bg-dark border-secondary">
                                <label class="form-check-label" for="remember_me">Se souvenir de moi</label>
                            </div>

                            <button class="btn btn-premium w-100 py-2" type="submit">
                                Entrer
                            </button>
                            
                        {% endif %}
                    </form>

                    <div class="text-center mt-4 pt-3 border-top border-secondary">
                        <p class="small text-muted">Nouveau client ? <a href="/register" class="text-or text-decoration-none">Créer un compte</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}