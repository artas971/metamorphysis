{% extends 'base.html.twig' %}

{% block title %}Mon Compte - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5 text-white">
    <h1 class="text-gold fw-bold mb-5 text-uppercase typo-titre" style="letter-spacing: 2px;">Mon Espace Personnel</h1>
    
    <div class="row g-4">
        {# COLONNE GAUCHE : Informations personnelles #}
        <div class="col-md-4">
            {# HARMONISATION TRANSLUCIDE #}
            <div class="card-premium shadow-lg h-100" style="background-color: rgba(74, 79, 65, 0.55); border: 1px solid rgba(184, 154, 99, 0.2); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: var(--radius-card);">
                <div class="card-body p-4">
                    <h4 class="text-gold fw-bold mb-4 text-uppercase small" style="letter-spacing: 1px;">Mes Informations</h4>
                    
                    <div class="d-flex flex-column gap-4">
                        <div>
                            <small class="text-sage text-uppercase fw-bold" style="letter-spacing: 1px;">Identité</small>
                            <div class="fs-5 mt-1 text-ivory">
                                <i class="bi bi-person text-gold me-2"></i> 
                                {{ app.user.prenom|capitalize }} {{ app.user.nom|upper }}
                            </div>
                        </div>
                        
                        <div>
                            <small class="text-sage text-uppercase fw-bold" style="letter-spacing: 1px;">Email de contact</small>
                            <div class="fs-6 mt-1 text-ivory"><i class="bi bi-envelope text-gold me-2"></i> {{ app.user.email }}</div>
                        </div>

                        <div>
                            <small class="text-sage text-uppercase fw-bold" style="letter-spacing: 1px;">Téléphone</small>
                            <div class="fs-6 mt-1 text-ivory">
                                <i class="bi bi-telephone text-gold me-2"></i> 
                                {% if app.user.telephone is defined and app.user.telephone %}
                                    {{ app.user.telephone }}
                                {% else %}
                                    <span class="text-muted fst-italic">Non renseigné</span>
                                {% endif %}
                            </div>
                        </div>

                        <div>
                            <small class="text-sage text-uppercase fw-bold" style="letter-spacing: 1px;">Statut</small>
                            <div class="fs-6 mt-1 text-ivory"><i class="bi bi-check-circle-fill text-gold me-2"></i> Compte Actif</div>
                        </div>
                    </div>
                    
                    <hr class="border-gold-subtle my-4">
                    
                    <a href="{{ path('app_account_edit') }}" class="btn btn-outline-gold w-100 fw-bold mb-3 rounded-pill text-uppercase" style="letter-spacing: 1px; font-size: 0.85rem;">
                        <i class="bi bi-pencil-square me-2"></i> Modifier mon profil
                    </a>
                    
                    <a href="{{ path('app_logout') }}" class="btn btn-link text-sage text-decoration-none w-100 fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.8rem;">
                        <i class="bi bi-box-arrow-right me-2"></i> Se déconnecter
                    </a>
                </div>
            </div>
        </div>
        
        {# COLONNE DROITE : Historique des Parcours / Séances #}
        <div class="col-md-8">
            <div class="card-premium shadow-lg h-100" style="background-color: rgba(74, 79, 65, 0.55); border: 1px solid rgba(184, 154, 99, 0.2); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: var(--radius-card);">
                <div class="card-body p-4 p-md-5">
                    <h4 class="text-gold fw-bold mb-5 text-uppercase typo-titre" style="letter-spacing: 2px;">Mes Parcours d'Accompagnement</h4>
                    
                    {% if parcoursList is not empty %}
                        
                        <div class="d-flex flex-column gap-5">
                            {% for parcours in parcoursList %}
                                <div class="parcours-block">
                                    {# En-tête du parcours avec la progression #}
                                    <div class="d-flex justify-content-between align-items-end mb-3 border-bottom border-gold-subtle pb-2">
                                        <h5 class="text-ivory fw-bold mb-0" style="font-family: var(--font-title); letter-spacing: 1px;">{{ parcours.prestation.nom }}</h5>
                                        <span class="text-gold small fw-bold text-uppercase" style="letter-spacing: 1px;">
                                            {{ parcours.planifiees }} / {{ parcours.total }} séance(s) planifiée(s)
                                        </span>
                                    </div>

                                    {# Liste des séances pour ce parcours #}
                                    <div class="table-responsive">
                                        <table class="table table-borderless align-middle text-white mb-0">
                                            <tbody>
                                                {% for seance in parcours.seances %}
                                                    <tr class="border-bottom" style="border-color: rgba(184, 154, 99, 0.1) !important;">
                                                        <td class="fw-bold bg-transparent text-sage w-25">Séance {{ seance.numero }}</td>
                                                        
                                                        <td class="bg-transparent w-50">
                                                            {% if seance.dateRendezVous %}
                                                                <span class="text-ivory"><i class="bi bi-calendar-event me-2 text-gold"></i>{{ seance.dateRendezVous|date('d/m/Y à H:i') }}</span>
                                                            {% else %}
                                                                <span class="text-white-50 fst-italic"><i class="bi bi-calendar-x me-2"></i>Non planifiée</span>
                                                            {% endif %}
                                                        </td>
                                                        
                                                        <td class="text-end bg-transparent w-25">
                                                            {% if seance.dateRendezVous %}
                                                                {# La séance a une date : on affiche le bouton détails #}
                                                                <a href="{{ path('app_reservation_show', {'id': seance.id}) }}" class="btn btn-sm btn-outline-gold rounded-pill px-3 transition-hover">
                                                                    Détails
                                                                </a>
                                                            {% else %}
                                                                {# La séance est en réserve : on affiche le bouton pour la planifier #}
                                                                 <a href="{{ path('app_seance_planifier', {'id': seance.id}) }}" class="btn btn-sm btn-premium rounded-pill px-3 fw-bold transition-hover" style="letter-spacing: 1px; font-size: 0.75rem;">
                                                                    PLANIFIER
                                                                </a>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                    {% else %}
                        <div class="text-center py-5">
                            <i class="bi bi-journal-x text-gold opacity-50 mb-3" style="font-size: 3rem;"></i>
                            <p class="text-ivory fs-5 mb-4">Vous n'avez pas encore initié de parcours d'accompagnement.</p>
                            <a href="{{ path('app_prestation_index') }}" class="btn btn-premium fw-bold py-2 px-4 rounded-pill text-uppercase" style="letter-spacing: 1px;">
                                DÉCOUVRIR NOS PRESTATIONS
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}