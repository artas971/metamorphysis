{% extends 'base.html.twig' %}

{% block title %}Mon Compte - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 pt-5">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="text-or fw-bold">Mon Espace Personnel</h1>
            {# On ajoute le nom à côté du prénom dans le message de bienvenue #}
            <p class="text-muted fs-5">Ravi de vous revoir, <span class="text-light">{{ app.user.prenom }} {{ app.user.nom }}</span> !</p>
        </div>
    </div>

    <div class="row g-4 justify-content-center">
        
        {# CARTE : INFORMATIONS PERSONNELLES #}
        <div class="col-md-6 col-lg-5">
            <div class="card bg-dark border-secondary text-light h-100 shadow-lg">
                <div class="card-header border-secondary bg-transparent pt-4 pb-3">
                    <h4 class="text-or mb-0"><i class="fas fa-user-circle me-2"></i>Mes Informations</h4>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush list-group-dark">
                        {# NOUVEAU BLOC : LE NOM #}
                        <li class="list-group-item bg-transparent text-light border-secondary py-3">
                            <span class="text-muted small d-block">Nom</span>
                            <span class="fw-bold fs-5">{{ app.user.nom }}</span>
                        </li>
                        <li class="list-group-item bg-transparent text-light border-secondary py-3">
                            <span class="text-muted small d-block">Prénom</span>
                            <span class="fw-bold fs-5">{{ app.user.prenom }}</span>
                        </li>
                        <li class="list-group-item bg-transparent text-light border-secondary py-3">
                            <span class="text-muted small d-block">Adresse Email</span>
                            <span class="fw-bold fs-5">{{ app.user.email }}</span>
                        </li>
                        <li class="list-group-item bg-transparent text-light border-0 py-3">
                            <span class="text-muted small d-block">Téléphone</span>
                            <span class="fw-bold fs-5">{{ app.user.telephone }}</span>
                        </li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent border-0 pb-4 text-center">
                    <button class="btn btn-outline-warning w-100">Modifier mes informations</button>
                </div>
            </div>
        </div>

        {# CARTE : RÉSERVATIONS (POUR PLUS TARD) #}
        <div class="col-md-6 col-lg-5">
            <div class="card bg-dark border-secondary text-light h-100 shadow-lg">
                <div class="card-header border-secondary bg-transparent pt-4 pb-3">
                    <h4 class="text-or mb-0"><i class="fas fa-calendar-check me-2"></i>Mes Séances</h4>
                </div>
                <div class="card-body d-flex flex-column justify-content-center align-items-center text-center py-5">
                    <div class="text-muted mb-4">
                        <i class="fas fa-box-open fa-3x mb-3 opacity-50"></i>
                        <p>Vous n'avez pas encore de séance programmée.</p>
                    </div>
                    <a href="{{ path('app_prestation_index') }}" class="btn btn-premium mt-auto">Découvrir les prestations</a>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}