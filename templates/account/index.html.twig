{% extends 'base.html.twig' %}

{% block title %}Mon Compte - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5 text-white">
    <h1 class="text-gold fw-bold mb-5 text-uppercase">Mon Espace Personnel</h1>
    
    <div class="row g-4">
        {# COLONNE GAUCHE : Informations personnelles #}
        <div class="col-md-4">
            <div class="card-premium shadow-lg h-100">
                <div class="card-body p-4">
                    <h4 class="text-gold fw-bold mb-4">Mes Informations</h4>
                    
                    <div class="d-flex flex-column gap-4">
                        {# Bloc Nom / Prénom (Capitalisé automatiquement : John CREASY) #}
                        <div>
                            <small class="text-white-50 text-uppercase fw-bold" style="letter-spacing: 1px;">Identité</small>
                            <div class="fs-5 mt-1">
                                <i class="bi bi-person text-gold me-2"></i> 
                                {{ app.user.prenom|capitalize }} {{ app.user.nom|upper }}
                            </div>
                        </div>
                        
                        {# Bloc Email #}
                        <div>
                            <small class="text-white-50 text-uppercase fw-bold" style="letter-spacing: 1px;">Email de contact</small>
                            <div class="fs-6 mt-1"><i class="bi bi-envelope text-gold me-2"></i> {{ app.user.email }}</div>
                        </div>

                        {# Bloc Téléphone #}
                        <div>
                            <small class="text-white-50 text-uppercase fw-bold" style="letter-spacing: 1px;">Téléphone</small>
                            <div class="fs-6 mt-1">
                                <i class="bi bi-telephone text-gold me-2"></i> 
                                {% if app.user.telephone is defined and app.user.telephone %}
                                    {{ app.user.telephone }}
                                {% else %}
                                    <span class="text-muted fst-italic">Non renseigné</span>
                                {% endif %}
                            </div>
                        </div>

                        {# Bloc Statut #}
                        <div>
                            <small class="text-white-50 text-uppercase fw-bold" style="letter-spacing: 1px;">Statut</small>
                            <div class="fs-6 mt-1"><i class="bi bi-check-circle-fill text-success me-2"></i> Compte Actif</div>
                        </div>
                    </div>
                    
                    <hr class="border-gold my-4">
                    
                    {# NOUVEAU BOUTON DE MODIFICATION #}
                    <a href="{{ path('app_account_edit') }}" class="btn btn-premium w-100 fw-bold mb-3 rounded-pill">
                        <i class="bi bi-pencil-square me-2"></i> MODIFIER MON PROFIL
                    </a>
                    
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-danger w-100 fw-bold rounded-pill">
                        <i class="bi bi-box-arrow-right me-2"></i> SE DÉCONNECTER
                    </a>
                </div>
            </div>
        </div>
        
        {# COLONNE DROITE : Historique des réservations #}
        <div class="col-md-8">
            <div class="card-premium shadow-lg h-100">
                <div class="card-body p-4">
                    <h4 class="text-gold fw-bold mb-4">Mes Rendez-vous</h4>
                    
                    {% if reservations is not empty %}
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle text-white border-gold-subtle">
                                <thead>
                                    <tr class="text-gold border-bottom border-gold">
                                        <th scope="col" class="bg-transparent">Prestation</th>
                                        <th scope="col" class="bg-transparent">Date</th>
                                        <th scope="col" class="bg-transparent">Statut</th>
                                        <th scope="col" class="text-end bg-transparent">Détails</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for reservation in reservations %}
                                        <tr class="border-bottom border-secondary">
                                            <td class="fw-bold bg-transparent">{{ reservation.prestation.nom }}</td>
                                            <td class="bg-transparent">{{ reservation.dateRendezVous|date('d/m/Y à H:i') }}</td>
                                            <td class="bg-transparent">
                                                {# Logique des badges de couleur #}
                                                {% if reservation.statut == 'Confirmé' %}
                                                    <span class="badge bg-success px-3 py-2 rounded-pill">Confirmé</span>
                                                {% elseif reservation.statut == 'En attente' %}
                                                    <span class="badge px-3 py-2 rounded-pill text-dark" style="background-color: var(--meta-gold);">En attente</span>
                                                {% elseif reservation.statut == 'Annulé' %}
                                                    <span class="badge bg-danger px-3 py-2 rounded-pill">Annulé</span>
                                                {% else %}
                                                    <span class="badge bg-secondary px-3 py-2 rounded-pill">{{ reservation.statut }}</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-end bg-transparent">
                                                {# Redirection vers la réservation spécifique (app_reservation_show) #}
                                                <a href="{{ path('app_reservation_show', {'id': reservation.id}) }}" class="btn btn-sm btn-outline-gold rounded-pill" title="Voir mon rendez-vous">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        {# Message affiché si le client n'a aucun rendez-vous #}
                        <div class="text-center py-5">
                            <p class="text-white-50 fs-5 mb-4">Vous n'avez pas encore effectué de réservation.</p>
                            <a href="{{ path('app_prestation_index') }}" class="btn btn-premium fw-bold py-2 px-4 rounded-pill">
                                DÉCOUVRIR NOS OFFRES
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}