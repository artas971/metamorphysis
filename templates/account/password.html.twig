{% extends 'base.html.twig' %}

{% block title %}Changer de mot de passe - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5 text-white">
    
    {# Bouton de retour vers l'édition du profil #}
    <div class="mb-4">
        <a href="{{ path('app_account_edit') }}" class="text-gold text-decoration-none transition-hover d-inline-block">
            <i class="bi bi-arrow-left me-2"></i>Retour
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-premium shadow-lg">
                <div class="card-body p-5">
                    
                    <div class="text-center mb-5">
                        <i class="bi bi-shield-lock text-gold display-4 mb-3 d-block"></i>
                        <h2 class="text-gold fw-bold text-uppercase typo-titre">Sécurité</h2>
                        <p class="text-white-50 mt-2">Choisissez un mot de passe robuste.</p>
                    </div>

                    {{ form_start(form) }}
                        
                        {# Ancien mot de passe #}
                        <div class="mb-4 text-start">
                            {{ form_label(form.oldPassword, null, {'label_attr': {'class': 'form-label text-sage fw-bold text-uppercase small'}}) }}
                            {{ form_widget(form.oldPassword, {'attr': {'class': 'form-control input-premium p-3'}}) }}
                            <div class="text-danger mt-1 small fw-bold">{{ form_errors(form.oldPassword) }}</div>
                        </div>

                        <hr class="border-gold-subtle my-4 opacity-25">

                        {# Nouveau mot de passe (1ère saisie) #}
                        <div class="mb-4 text-start">
                            {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'form-label text-sage fw-bold text-uppercase small'}}) }}
                            {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control input-premium p-3'}}) }}
                            <div class="text-danger mt-1 small">{{ form_errors(form.newPassword.first) }}</div>
                        </div>

                        {# Nouveau mot de passe (Confirmation) #}
                        <div class="mb-5 text-start">
                            {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'form-label text-sage fw-bold text-uppercase small'}}) }}
                            {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control input-premium p-3'}}) }}
                            <div class="text-danger mt-1 small">{{ form_errors(form.newPassword.second) }}</div>
                        </div>

                        <button type="submit" class="btn btn-gold w-100 fw-bold py-3 rounded-pill text-uppercase">
                            Valider le nouveau mot de passe
                        </button>
                        
                    {{ form_end(form) }}

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}