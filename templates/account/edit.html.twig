{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="mb-4">
                <a href="{{ path('app_account') }}" class="text-warning text-decoration-none fw-bold">
                    <i class="bi bi-arrow-left"></i> Retour à mon espace
                </a>
            </div>

            <div class="card bg-dark border-warning shadow-lg" style="border-radius: 15px;">
                <div class="card-body p-5">
                    <h2 class="text-warning fw-bold text-center mb-4" style="font-family: 'Impact', sans-serif;">MODIFIER MON PROFIL</h2>
                    
                    {{ form_start(form) }}
                        
                        <div class="mb-4">
                            {{ form_label(form.email, 'Adresse Email', {'label_attr': {'class': 'form-label text-white-50 fw-bold text-uppercase', 'style': 'letter-spacing: 1px;'}}) }}
                            
                            {# On change légèrement la classe CSS (bg-secondary au lieu de bg-dark) pour assombrir le champ et montrer qu'il est inactif #}
                            {{ form_widget(form.email, {'attr': {'class': 'form-control bg-secondary text-white-50 border-secondary mt-2'}}) }}
                            
                            {# Le message d'explication UX #}
                            <div class="form-text text-white-50 fst-italic mt-2">
                                <i class="bi bi-info-circle me-1"></i> Pour des raisons de sécurité, l'adresse email de connexion ne peut pas être modifiée.
                            </div>
                            
                            <div class="text-danger mt-1 fw-bold">{{ form_errors(form.email) }}</div>
                        </div>

                        <div class="mb-5">
                            {{ form_label(form.telephone, 'Numéro de Téléphone', {'label_attr': {'class': 'form-label text-white-50 fw-bold text-uppercase', 'style': 'letter-spacing: 1px;'}}) }}
                            {{ form_widget(form.telephone, {'attr': {'class': 'form-control bg-dark text-white border-warning mt-2'}}) }}
                            <div class="text-danger mt-1 fw-bold">{{ form_errors(form.telephone) }}</div>
                        </div>

                        <button type="submit" class="btn btn-warning w-100 fw-bold py-3 fs-5" style="border-radius: 30px; font-family: 'Impact', sans-serif;">
                            ENREGISTRER LES MODIFICATIONS
                        </button>

                    {{ form_end(form) }}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}