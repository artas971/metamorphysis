{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5 text-white">
    
    {# Bouton de retour #}
    <div class="mb-4">
        <a href="{{ path('app_account') }}" class="text-gold text-decoration-none transition-hover d-inline-block">
            <i class="bi bi-arrow-left me-2"></i>Retour à mon espace
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-premium shadow-lg">
                <div class="card-body p-5">
                    
                    <div class="text-center mb-5">
                        <h2 class="text-gold fw-bold text-uppercase typo-titre">Modifier mon profil</h2>
                    </div>

                    {{ form_start(form) }}
                        
                        {# Champ Email (Bloqué) #}
                        <div class="mb-4 text-start">
                            {{ form_label(form.email, null, {'label_attr': {'class': 'form-label text-sage fw-bold text-uppercase small'}}) }}
                            
                            {# On assombrit légèrement le champ pour montrer qu'il est inactif #}
                            {{ form_widget(form.email, {'attr': {
                                'class': 'form-control input-premium p-3 text-white-50',
                                'style': 'background-color: rgba(255,255,255,0.05) !important;'
                            }}) }}
                            
                            {# Message explicatif de sécurité #}
                            <div class="mt-2 text-white-50 small fst-italic">
                                <i class="bi bi-info-circle me-1"></i> Pour des raisons de sécurité, l'adresse email de connexion ne peut pas être modifiée.
                            </div>
                        </div>

                        {# Champ Téléphone (Modifiable) #}
                        <div class="mb-5 text-start">
                            {{ form_label(form.telephone, null, {'label_attr': {'class': 'form-label text-sage fw-bold text-uppercase small'}}) }}
                            {{ form_widget(form.telephone, {'attr': {'class': 'form-control input-premium p-3'}}) }}
                            <div class="text-danger mt-1 small">{{ form_errors(form.telephone) }}</div>
                        </div>

                        {# Bouton d'enregistrement (Style "Outline" premium) #}
                        <button type="submit" class="btn btn-premium w-100 fw-bold py-3 rounded-pill text-uppercase">
                            Enregistrer les modifications
                        </button>
                        
                    {{ form_end(form) }}
                    {# Séparateur visuel #}
                    <div class="d-flex align-items-center my-4">
                        <hr class="flex-grow-1 border-gold-subtle">
                        <span class="px-3 text-white-50 small text-uppercase" style="letter-spacing: 2px;">Sécurité</span>
                        <hr class="flex-grow-1 border-gold-subtle">
                    </div>

                    {# Bouton vers le changement de mot de passe #}
                    <div class="text-center">
                        <p class="text-white-50 small mb-3">Vous souhaitez modifier votre mot de passe de connexion ?</p>
                        <a href="{{ path('app_password_change') }}" class="btn btn-outline-gold w-100 rounded-pill">
                            <i class="bi bi-shield-lock me-2"></i> CHANGER MON MOT DE PASSE
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}