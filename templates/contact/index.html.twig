{% extends 'base.html.twig' %}

{% block title %}Contact - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="card-premium shadow-lg overflow-hidden" style="background: linear-gradient(to bottom, rgba(74, 79, 65, 0.7), rgba(30, 32, 27, 0.9)); border: 1px solid rgba(184, 154, 99, 0.3); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: 0;">
                
                {# ZONE SUPÉRIEURE : Le dégradé officiel fusionné Violet/Vert appliqué au titre #}
                <div class="text-center py-5 px-4" style="background: linear-gradient(135deg, var(--meta-plum) 0%, var(--meta-olive) 100%); border-bottom: 1px solid rgba(184, 154, 99, 0.3);">
                    <h1 class="display-5 fw-bold text-uppercase typo-titre mb-3" style="color: var(--meta-gold); letter-spacing: 2px;">NOUS CONTACTER</h1>
                    <p class="lead m-0" style="color: var(--meta-ivory); font-size: 1.1rem; opacity: 0.9;">Une question ? Besoin d'échanger sur votre situation ? Écrivez-nous directement.</p> 
                </div>

                {# CORPS DU FORMULAIRE #}
                <div class="card-body p-4 p-md-5">
                    
                    {# Définition des valeurs si l'utilisateur est connecté #}
                    {% set default_nom = app.user ? app.user.prenom|capitalize ~ ' ' ~ app.user.nom|upper : '' %}
                    {% set default_email = app.user ? app.user.email : '' %}
                    {% set is_readonly = app.user ? true : false %}
                    
                    {{ form_start(form) }}
                        
                        {# Champ Nom #}
                        <div class="mb-4">
                            {{ form_label(form.nom, 'Votre Nom', {'label_attr': {'class': 'form-label fw-bold text-uppercase small', 'style': 'color: var(--meta-ivory); letter-spacing: 1px;'}}) }}
                            {{ form_widget(form.nom, {'attr': {
                                'class': 'form-control text-white p-3 mt-2', 
                                'style': 'background-color: rgba(10, 10, 9, 0.6); border: 1px solid rgba(184, 154, 99, 0.4); border-radius: 0; color: var(--meta-ivory) !important;',
                                'value': default_nom,
                                'readonly': is_readonly
                            }}) }}
                            <div class="text-danger mt-1 small fw-bold">{{ form_errors(form.nom) }}</div>
                        </div>

                        {# Champ Email #}
                        <div class="mb-4">
                            {{ form_label(form.email, 'Votre Adresse Email', {'label_attr': {'class': 'form-label fw-bold text-uppercase small', 'style': 'color: var(--meta-ivory); letter-spacing: 1px;'}}) }}
                            {{ form_widget(form.email, {'attr': {
                                'class': 'form-control text-white p-3 mt-2', 
                                'style': 'background-color: rgba(10, 10, 9, 0.6); border: 1px solid rgba(184, 154, 99, 0.4); border-radius: 0; color: var(--meta-ivory) !important;',
                                'value': default_email,
                                'readonly': is_readonly
                            }}) }}
                            <div class="text-danger mt-1 small fw-bold">{{ form_errors(form.email) }}</div>
                        </div>

                        {# Champ Sujet #}
                        <div class="mb-4">
                            {{ form_label(form.sujet, 'Sujet de votre demande', {'label_attr': {'class': 'form-label fw-bold text-uppercase small', 'style': 'color: var(--meta-ivory); letter-spacing: 1px;'}}) }}
                            {{ form_widget(form.sujet, {'attr': {'class': 'form-control text-white p-3 mt-2', 'style': 'background-color: rgba(10, 10, 9, 0.6); border: 1px solid rgba(184, 154, 99, 0.4); border-radius: 0; color: var(--meta-ivory) !important;'}}) }}
                            <div class="text-danger mt-1 small fw-bold">{{ form_errors(form.sujet) }}</div>
                        </div>

                        {# Champ Message #}
                        <div class="mb-5">
                            {{ form_label(form.message, 'Votre Message', {'label_attr': {'class': 'form-label fw-bold text-uppercase small', 'style': 'color: var(--meta-ivory); letter-spacing: 1px;'}}) }}
                            {{ form_widget(form.message, {'attr': {'class': 'form-control text-white p-3 mt-2', 'rows': 5, 'style': 'background-color: rgba(10, 10, 9, 0.6); border: 1px solid rgba(184, 154, 99, 0.4); border-radius: 0; color: var(--meta-ivory) !important; resize: none;'}}) }}
                            <div class="text-danger mt-1 small fw-bold">{{ form_errors(form.message) }}</div>
                        </div>

                        {# Bouton de validation premium #}
                        <button type="submit" class="btn w-100 fw-bold py-3 rounded-0 text-uppercase transition-hover" style="background-color: var(--meta-gold); color: var(--meta-black); letter-spacing: 1px;">
                            ENVOYER LE MESSAGE
                        </button>

                    {{ form_widget(form.fax_number) }}
                    {{ form_end(form) }}
                    
                </div>
            </div>
            
        </div>
    </div>
</div>
{% endblock %}