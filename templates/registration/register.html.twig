{% extends 'base.html.twig' %}

{% block title %}Inscription - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-premium shadow-lg">
                <div class="card-body p-5">
                    <h2 class="text-center text-gold fw-bold mb-4 typo-titre">CRÉER UN COMPTE</h2>
                    
                    {{ form_errors(registrationForm) }}

                   {{ form_start(registrationForm) }}
                        {% for field in [registrationForm.nom, registrationForm.prenom, registrationForm.telephone, registrationForm.email, registrationForm.plainPassword] %}
                            <div class="mb-3">
                                {# Utilisation d'un filtre conditionnel pour forcer le label #}
                                {% set label_text = field.vars.name == 'plainPassword' ? 'MOT DE PASSE' : (field.vars.name|upper) %}
                                
                                {{ form_label(field, label_text, {'label_attr': {'class': 'form-label text-gold typo-symbolic small'}}) }}
                                {{ form_widget(field, {'attr': {'class': 'form-control input-premium'}}) }}
                                
                                {# Affichage des erreurs spécifiques au champ #}
                                <div class="text-danger small mt-1">
                                    {{ form_errors(field) }}
                                </div>
                            </div>
                        {% endfor %}

                        <div class="mb-4 form-check">
                            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input', 'style': 'background-color: var(--meta-black); border-color: var(--meta-gold);'}}) }}
                            {{ form_label(registrationForm.agreeTerms, "J'accepte les conditions d'utilisation", {'label_attr': {'class': 'form-check-label text-ivory small'}}) }}
                        </div>

                        <button type="submit" class="btn btn-gold w-100 py-3">S'INSCRIRE</button>
                    {{ form_end(registrationForm) }}
                    
                    <div class="text-center mt-4 pt-3 border-top border-gold">
                        <p class="small text-ivory">Déjà un compte ? <a href="{{ path('app_login') }}" class="text-gold text-decoration-none">Se connecter</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}