{% set nb_etapes = section.etapes|length %}

{% if nb_etapes == 4 %}
    {% set col_class = 'col-lg-3' %}
    {% set line_left = '12.5%' %}
    {% set line_width = '75%' %}
{% else %}
    {% set col_class = 'col-lg-4' %}
    {% set line_left = '16.66%' %}
    {% set line_width = '66.66%' %}
{% endif %}

<div class="row g-4 justify-content-center position-relative pt-4">
    <div class="d-none d-lg-block position-absolute" style="top: 59px; left: {{ line_left }}; width: {{ line_width }}; height: 1px; background: rgba(184, 154, 99, 0.3); z-index: 0;" aria-hidden="true"></div>
    
    {% for etape in section.etapes %}
        <article class="col-12 col-md-6 {{ col_class }} text-center position-relative z-1">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-black);">
                    {% if etape.icone in ['bi-brain', 'brain-svg', 'cerveau'] %}
                        {# Cerveau SVG doré élégant #}
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#B89A63" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/>
                            <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/>
                            <path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/>
                            <path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/>
                            <path d="M6.002 5.125A3 3 0 0 0 6.401 6.5"/>
                            <path d="M3.477 10.896a4 4 0 0 1 .585-.396"/>
                            <path d="M19.938 10.5a4 4 0 0 1 .585.396"/>
                            <path d="M6 18a4 4 0 0 1-1.967-.516"/>
                            <path d="M19.967 17.484A4 4 0 0 1 18 18"/>
                        </svg>
                    {% elseif etape.icone in ['bi-symmetry-vertical', 'confronter', 'miroir-face'] %}
                        {# Confronter : Face-à-face / Miroir de lucidité face à face #}
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#B89A63" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M7 4a5 5 0 0 0-4 4.8c0 2.5 1.5 4.6 3.6 5.3L6 18h2"/>
                            <path d="M17 4a5 5 0 0 1 4 4.8c0 2.5-1.5 4.6-3.6 5.3L18 18h-2"/>
                            <line x1="12" y1="3" x2="12" y2="21" stroke-dasharray="2 2" stroke-width="1.5"/>
                            <circle cx="8" cy="8.5" r="0.75" fill="#B89A63"/>
                            <circle cx="16" cy="8.5" r="0.75" fill="#B89A63"/>
                        </svg>
                    {% elseif etape.icone == 'libellule.svg' %}
                        <img src="/images/libellule.svg" alt="" style="width: 44px; height: 44px; object-fit: contain; display: block;">
                    {% elseif etape.icone %}
                        <i class="bi {{ etape.icone }} text-gold fs-3" aria-hidden="true"></i>
                    {% endif %}
                </div>
            </div>
            <span class="text-gold typo-symbolic mb-1 d-block" aria-hidden="true">{{ loop.index < 10 ? '0' ~ loop.index : loop.index }}</span>
            <h3 class="text-ivory fs-6 letter-spacing-1 mb-3">{{ etape.titre|upper }}</h3>
            <p class="text-sage small px-2">{{ etape.texte }}</p>
        </article>
    {% endfor %}
</div>
