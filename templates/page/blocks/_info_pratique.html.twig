<aside class="mt-5 pt-3 d-flex flex-column flex-md-row align-items-md-center gap-4">
    <div class="border border-gold rounded-circle d-flex align-items-center justify-content-center p-2" style="width: 50px; height: 50px; flex-shrink: 0;">
        <i class="bi bi-flower1 text-gold fs-4" aria-hidden="true"></i>
    </div>
    
    <div class="text-sage small mb-0 w-100 d-flex flex-column flex-md-row align-items-md-center gap-3">
        {{ section.contenu|raw }}
    </div>
</aside>

{% if section.titre %}
<div class="text-center mt-5">
    <span class="text-sage text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">{{ section.titre }}</span>
</div>
{% endif %}
