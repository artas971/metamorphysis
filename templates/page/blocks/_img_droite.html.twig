{% set crop_style = '' %}
{% if section.cropHaut or section.cropBas or section.cropGauche or section.cropDroite %}
    {% set crop_style = 'clip-path: inset(' ~ section.cropHaut|default(0) ~ '% ' ~ section.cropDroite|default(0) ~ '% ' ~ section.cropBas|default(0) ~ '% ' ~ section.cropGauche|default(0) ~ '%);' %}
{% endif %}
{% set z_img = (section.imageSuperposition == 'image_sur_texte') ? 10 : (section.imageZIndex|default(1)) %}
{% set z_txt = (section.imageSuperposition == 'texte_sur_image') ? 10 : 2 %}
{% set cadre_color = section.imageCadreCouleur|default('gold') %}
{% set b_top = section.imageCadreHaut|default(0) %}
{% set b_bottom = section.imageCadreBas|default(0) %}
{% set b_left = section.imageCadreGauche|default(0) %}
{% set b_right = section.imageCadreDroite|default(0) %}
{% set has_cadre = (cadre_color != 'none' and (b_top > 0 or b_bottom > 0 or b_left > 0 or b_right > 0)) %}

<div class="row align-items-stretch {% if section.paddingDroite is not null and section.paddingDroite == 0 %}g-0 me-0{% else %}g-4 g-lg-5 justify-content-between{% endif %}">
    <div class="col-lg-6 order-2 order-lg-1 content-premium text-start pt-3 pt-lg-2" style="z-index: {{ z_txt }};">
        {% if section.titre %}
            <h2 class="typo-titre fw-light mb-2 builder-title" style="color: var(--meta-{{ section.titreCouleur|default('gold-hover') }});">{{ section.titre }}</h2>
        {% endif %}
        {% if section.sousTitre %}
            <div class="mb-4 builder-subtitle" style="text-transform: uppercase; font-weight: 500; color: var(--meta-{{ section.sousTitreCouleur|default('ivory') }});">
                {{ section.sousTitre|nl2br }}
            </div>
        {% endif %}
        <div class="content-premium mb-0 builder-content" style="opacity: 0.92; color: var(--meta-{{ section.texteCouleur|default('ivory') }});">
            {{ section.contenu|format_paragraphs(section.texteCouleur|default('ivory'))|raw }}
        </div>
        {% if section.boutonLien and section.boutonTexte %}
            <div class="mt-4 pt-2">
                <a href="{{ section.boutonLien }}" 
                   target="{{ section.boutonCible|default('_self') }}" 
                   class="btn btn-outline-gold px-4 py-2 text-uppercase rounded-0 transition-hover" 
                   style="letter-spacing: 2px; font-size: 0.8rem;">
                    {{ section.boutonTexte }} <i class="bi bi-star text-gold fs-5 align-middle ms-2" aria-hidden="true"></i>
                </a>
            </div>
        {% endif %}
    </div>
    
    <div class="col-lg-6 order-1 order-lg-2 position-relative mt-2 mt-lg-0 {% if section.paddingDroite is not null and section.paddingDroite == 0 %}pe-0{% endif %}" style="z-index: {{ z_img }};">
        <div class="position-relative w-100" 
             style="transform: translate({{ section.imagePosX|default('0') }}%, {{ section.imagePosY|default('0') }}px); 
                    transition: transform 0.3s ease;
                    {% if section.largeurMedia %}max-width: {{ section.largeurMedia }}px; margin-left: auto;{% endif %}">
            {% set img_url = media_url(section) %}
            {% if img_url %}
                <div class="position-relative shadow-lg w-100" 
                     style="{% if has_cadre %}
                                background-color: var(--meta-{{ cadre_color }});
                                padding-top: {{ b_top }}px;
                                padding-bottom: {{ b_bottom }}px;
                                padding-left: {{ b_left }}px;
                                padding-right: {{ b_right }}px;
                            {% endif %}
                            box-sizing: border-box;
                            border-radius: 0;">
                    {% if section.imageLien %}
                        <a href="{{ section.imageLien }}" class="d-block transition-hover text-decoration-none w-100" title="Découvrir">
                    {% endif %}
                    <img src="{{ img_url }}" 
                         alt="Illustration {{ section.titre|default('') }}" 
                         loading="lazy"
                         decoding="async"
                         class="d-block shadow-sm w-100" 
                         style="width: 100%; height: auto; min-height: clamp(260px, 45vh, 440px); object-fit: cover; border-radius: 0; {{ crop_style }}">
                    {% if section.imageLien %}
                        </a>
                    {% endif %}
                </div>
            {% endif %}

            {% if section.citation %}
                {{ include('components/_quote_aside.html.twig', {'section': section}) }}
            {% endif %}
        </div>
    </div>
</div>
