{% extends 'base.html.twig' %}

{% block title %}{{ page.titre }} - Metamorphysis{% endblock %}

{% block meta_description %}{{ page.metaDescription|default('Metamorphysis vous accompagne dans votre cheminement personnel et la libération de vos schémas limitants. Séances et consultations sur-mesure.') }}{% endblock %}
{% block og_title %}{{ page.titre }} | Metamorphysis{% endblock %}
{% block og_description %}{{ page.metaDescription|default('Un parcours d\'accompagnement d\'exception pour vous libérer des schémas limitants.') }}{% endblock %}
{% block twitter_title %}{{ page.titre }} | Metamorphysis{% endblock %}
{% block twitter_description %}{{ page.metaDescription|default('Découvrez nos parcours d\'accompagnement sur-mesure.') }}{% endblock %}

{% block body %}

{% if isDraftPreview|default(false) %}
    <div class="bg-warning text-dark py-2 px-3 text-center fw-bold shadow position-sticky top-0 z-3" style="letter-spacing: 1px; font-size: 0.85rem; border-bottom: 2px solid #b89a63;">
        <i class="bi bi-eye-slash-fill me-2"></i> MODE BROUILLON — Cette page est hors-ligne / non publiée (invisible pour le public)
        <a href="{{ path('admin_page_edit', {'entityId': page.id}) }}" class="btn btn-sm btn-dark ms-3 py-0 px-2 text-gold" style="font-size: 0.75rem;">✏️ Modifier dans EasyAdmin</a>
    </div>
{% endif %}

{% if page.slug == 'mentions-legales' %}
    {# =========================================================================
       LAYOUT GRILLE LUXE (2+1) : MENTIONS LÉGALES & CONFIDENTIALITÉ
       Bloc 1 (Gauche) | Bloc 2 (Droite) | Bloc 3 (Pleine Largeur Centré Dessous)
       Angles 100% droits (border-radius: 0), Cartes Vert Olive, Fond Pourpre Sombre
       ========================================================================= #}
    <div class="container py-4 my-3 pt-lg-4">
        {% if page.afficherTitre %}
            <header class="text-center mb-5">
                <h1 class="font-serif-luxury text-gold fw-light mb-2 typo-titre gold-gradient-text" style="font-size: var(--fs-h1, 2.8rem); letter-spacing: 2px;">
                    {{ page.titre }}
                </h1>
                <div class="mx-auto mt-3" style="width: 100px; height: 1px; background: linear-gradient(90deg, transparent, var(--meta-gold, #B89A63), transparent);"></div>
            </header>
        {% endif %}

        {% set sections_sorted = page.sections|sort((a, b) => (a.ordre ?? 0) <=> (b.ordre ?? 0)) %}
        {% set sec1 = sections_sorted[0] ?? null %}
        {% set sec2 = sections_sorted[1] ?? null %}
        {% set sec3 = sections_sorted[2] ?? null %}

        <div class="row g-4 align-items-stretch">
            {# BLOC 1 : MENTIONS LÉGALES (Moitié gauche de l'écran col-lg-6) #}
            {% if sec1 %}
                <div class="col-12 col-lg-6 d-flex">
                    <section class="olive-card w-100 p-4 p-md-5 d-flex flex-column justify-content-between">
                        <div>
                            <header class="text-center border-bottom pb-4 mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                                <h2 class="typo-titre text-gold fw-normal mb-1" style="font-size: 1.85rem; letter-spacing: 1px;">
                                    {{ sec1.titre }}
                                </h2>
                                {% if sec1.sousTitre %}
                                    <p class="text-uppercase fw-semibold mb-0" style="letter-spacing: 2.5px; font-size: 0.75rem; color: var(--meta-gold, #B89A63);">
                                        {{ sec1.sousTitre }}
                                    </p>
                                {% endif %}
                            </header>
                            <div class="content-premium text-ivory">
                                {{ sec1.contenu|raw }}
                            </div>
                        </div>
                    </section>
                </div>
            {% endif %}

            {# BLOC 2 : POLITIQUE DE CONFIDENTIALITÉ (Moitié droite de l'écran col-lg-6) #}
            {% if sec2 %}
                <div class="col-12 col-lg-6 d-flex">
                    <section class="olive-card w-100 p-4 p-md-5 d-flex flex-column justify-content-between">
                        <div>
                            <header class="text-center border-bottom pb-4 mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                                <h2 class="typo-titre text-gold fw-normal mb-1" style="font-size: 1.85rem; letter-spacing: 1px;">
                                    {{ sec2.titre }}
                                </h2>
                                {% if sec2.sousTitre %}
                                    <p class="text-uppercase fw-semibold mb-0" style="letter-spacing: 2.5px; font-size: 0.75rem; color: var(--meta-gold, #B89A63);">
                                        {{ sec2.sousTitre }}
                                    </p>
                                {% endif %}
                            </header>
                            <div class="content-premium text-ivory">
                                {{ sec2.contenu|raw }}
                            </div>
                        </div>
                    </section>
                </div>
            {% endif %}

            {# BLOC 3 : CONDITIONS D'ANNULATION (Pleine largeur col-12 sous les 2 premiers blocs) #}
            {% if sec3 %}
                <div class="col-12">
                    <section class="olive-card w-100 p-4 p-md-5">
                        <header class="text-center border-bottom pb-4 mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                            <h2 class="typo-titre text-gold fw-normal mb-1" style="font-size: 1.85rem; letter-spacing: 1px;">
                                {{ sec3.titre }}
                            </h2>
                            {% if sec3.sousTitre %}
                                <p class="text-uppercase fw-semibold mb-0" style="letter-spacing: 2.5px; font-size: 0.75rem; color: var(--meta-gold, #B89A63);">
                                    {{ sec3.sousTitre }}
                                </p>
                            {% endif %}
                        </header>
                        <div class="content-premium text-ivory">
                            {{ sec3.contenu|raw }}
                        </div>
                    </section>
                </div>
            {% endif %}

            {# Blocs additionnels si ajoutés dans le Page Builder #}
            {% for extra_sec in sections_sorted|slice(3) %}
                <div class="col-12">
                    <section class="olive-card w-100 p-4 p-md-5">
                        {% if extra_sec.titre %}
                            <header class="text-center border-bottom pb-4 mb-4" style="border-color: rgba(184, 154, 99, 0.25) !important;">
                                <h2 class="typo-titre text-gold fw-normal mb-1">{{ extra_sec.titre }}</h2>
                                {% if extra_sec.sousTitre %}
                                    <p class="text-uppercase fw-semibold mb-0" style="letter-spacing: 2px; font-size: 0.75rem; color: var(--meta-gold);">{{ extra_sec.sousTitre }}</p>
                                {% endif %}
                            </header>
                        {% endif %}
                        <div class="content-premium text-ivory">
                            {{ extra_sec.contenu|raw }}
                        </div>
                    </section>
                </div>
            {% endfor %}
        </div>
    </div>
{% else %}
    {# --- Titre de page H1 standard --- #}
    {% if page.afficherTitre %}
        <header class="container mt-5 pt-5 text-center">
            <h1 class="text-gold fw-bold mb-5 typo-titre">{{ page.titre }}</h1>
        </header>
    {% endif %}

    <div class="container position-relative mt-4 pt-lg-4 pb-4 mb-5">
        {# Panneau unifié continu sans rupture entre les blocs (angles droits) #}
        <div class="{% if page.fondBlocsUnifie == 'olive' %}bg-olive-premium shadow-lg{% endif %} position-relative" style="border-radius: 0 !important; {% if page.fondBlocsUnifie != 'olive' %}background-color: transparent;{% endif %}">
            {# LA BOUCLE DES BLOCS DYNAMIQUES DU PAGE BUILDER #}
            {% for section in page.sections|sort((a, b) => (a.ordre ?? 0) <=> (b.ordre ?? 0)) %}
                
                {% set is_banniere = (section.disposition == 'banniere') %}
                {% set dispos_titre_integre = ['presentation_expert', 'img_gauche', 'img_droite', 'bandeau_conclusion', 'processus', 'grille_colonnes', 'texte_centre', 'slider_prestations', 'grille_mentions'] %}
                
                {% set p_top = (section.paddingHaut is not null) ? section.paddingHaut ~ 'px' : '3rem' %}
                {% set p_bottom = (section.paddingBas is not null) ? section.paddingBas ~ 'px' : '3rem' %}
                {% set p_left = (section.paddingGauche is not null) ? section.paddingGauche ~ 'px' : '3rem' %}
                {% set p_right = (section.paddingDroite is not null) ? section.paddingDroite ~ 'px' : '3rem' %}
                
                {% set m_top = (section.margeHaut is not null and section.margeHaut != 0) ? section.margeHaut ~ 'px' : ((section.decalagePosY) ? section.decalagePosY ~ 'px' : '0px') %}
                {% set m_bottom = (section.margeBas is not null and section.margeBas != 0) ? section.margeBas ~ 'px' : '0px' %}
                {% set min_h = (section.hauteurMin is not null and section.hauteurMin > 0) ? section.hauteurMin ~ 'px' : 'auto' %}
                {% set sec_zindex = (section.decalagePosY < 0 or (section.margeHaut is not null and section.margeHaut < 0)) ? (loop.index * 10 + 20) : (loop.index * 10) %}

                {% if is_banniere %}
                    <section class="builder-section position-relative" 
                        style="--sec-p-top: {{ p_top }}; --sec-p-bottom: {{ p_bottom }}; --sec-p-left: {{ p_left }}; --sec-p-right: {{ p_right }}; --sec-m-top: {{ m_top }}; --sec-m-bottom: {{ m_bottom }}; --sec-min-h: {{ min_h }}; z-index: {{ sec_zindex }};">
                        {{ include('page/blocks/_' ~ section.disposition ~ '.html.twig', {'section': section, 'loop_index': loop.index}, ignore_missing = true) }}
                    </section>
                {% else %}
                    <section class="builder-section position-relative" 
                        style="--sec-p-top: {{ p_top }}; --sec-p-bottom: {{ p_bottom }}; --sec-p-left: {{ p_left }}; --sec-p-right: {{ p_right }}; --sec-m-top: {{ m_top }}; --sec-m-bottom: {{ m_bottom }}; --sec-min-h: {{ min_h }}; {% if section.couleurFond and section.couleurFond not in ['none', 'plum'] %}background-color: var(--meta-{{ section.couleurFond }});{% endif %} z-index: {{ sec_zindex }};"
                        {% if section.titre and section.disposition not in dispos_titre_integre %}aria-labelledby="section-heading-{{ loop.index }}"{% endif %}>
                        
                        {# Titre de section standard si la disposition ne l'intègre pas dans son design #}
                        {% if section.titre is defined and section.titre is not null and section.disposition not in dispos_titre_integre %}
                            <header class="mb-4 text-center">
                                <h2 id="section-heading-{{ loop.index }}" class="text-ivory fw-light mb-2" style="font-size: 2.5rem;">
                                    {{ section.titre }}
                                </h2>
                            </header>
                        {% endif %}

                        {# Rendu dynamique et isolé du bloc #}
                        {{ include('page/blocks/_' ~ section.disposition ~ '.html.twig', {'section': section, 'loop_index': loop.index}, ignore_missing = true) }}

                        {# Rendu du bouton d'action CTA pour texte_centre / titre_seul #}
                        {% if section.boutonTexte and section.disposition in ['texte_centre', 'titre_seul'] %}
                            {% set btn_class = 'btn-gold-premium' %}
                            {% if section.boutonStyle == 'outline' %}
                                {% set btn_class = 'btn-outline-gold' %}
                            {% elseif section.boutonStyle == 'sage' %}
                                {% set btn_class = 'btn-sage-premium' %}
                            {% elseif section.boutonStyle == 'plum' %}
                                {% set btn_class = 'btn-plum-premium' %}
                            {% endif %}

                            <div class="mt-4 pt-2 text-center w-100 position-relative" style="z-index: 10;">
                                <a href="{{ section.boutonLien|default('#') }}" 
                                   target="{{ section.boutonCible|default('_self') }}" 
                                   class="btn {{ btn_class }} px-4 py-2 rounded-0 fw-bold text-uppercase transition-hover" 
                                   style="letter-spacing: 1.5px; font-size: 0.85rem;">
                                    {{ section.boutonTexte }} <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                                </a>
                            </div>
                        {% endif %}

                    </section>
                {% endif %}
                
            {% endfor %}
        </div>
    </div>
{% endif %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tracks = document.querySelectorAll('.prestation-track');
            tracks.forEach((track) => {
                const trackId = track.getAttribute('id');
                if (!trackId) return;
                const index = trackId.split('-')[2];
                const btnPrev = document.getElementById(`btn-prev-${index}`);
                const btnNext = document.getElementById(`btn-next-${index}`);

                if (btnPrev && btnNext) {
                    const scrollAmount = 412; 
                    btnNext.addEventListener('click', () => {
                        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                    });
                    btnPrev.addEventListener('click', () => {
                        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                    });
                }
            });
        });
    </script>

    {{ include('partials/_admin_floating_bar.html.twig', {'page': page}, ignore_missing = true) }}
{% endblock %}

{% endblock %}