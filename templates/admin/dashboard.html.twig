{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}Bienvenue sur votre Espace Metamorphysis{% endblock %}

{% block main %}
<div class="container-fluid mt-4">
    {# Résumé rapide #}
    <div class="row mb-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-5">
                    <h2 class="fw-light mb-3">Bonjour ! Bienvenue dans votre cabinet digital.</h2>
                    <p class="lead text-muted">
                        Cet espace sécurisé a été conçu sur mesure pour vous permettre de piloter votre activité en toute simplicité.
                        Utilisez le menu sur la gauche pour naviguer entre les différentes sections.
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# Tes Cartes #}
    <div class="row g-4">
        {# Carte 1 : Réservations #}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
                            <i class="fa-solid fa-calendar-check fs-4"></i>
                        </div>
                        <h4 class="mb-0">Réservations</h4>
                    </div>
                        <a href="{{ url_reservations }}" class="btn btn-outline-primary btn-sm">Gérer les réservations</a>
                </div>
            </div>
        </div>
        
        {# Carte 2 : Pages #}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle me-3">
                            <i class="fa-solid fa-file-lines fs-4"></i>
                        </div>
                        <h4 class="mb-0">Pages (Textes)</h4>
                    </div>
                     <a href="{{ url_pages }}" class="btn btn-outline-success btn-sm">Modifier le site</a>
                </div>
            </div>
        </div>

        {# Carte 3 : Prestations #}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-circle me-3">
                            <i class="fa-solid fa-gem fs-4"></i>
                        </div>
                        <h4 class="mb-0">Prestations</h4>
                    </div>
                   <a href="{{ url_prestations }}" class="btn btn-outline-warning btn-sm">Voir les prestations</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}