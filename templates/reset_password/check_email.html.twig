{% extends 'base.html.twig' %}

{% block title %}Email envoyé - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="card-premium shadow-lg text-center">
                <div class="card-body p-5">
                    <div class="text-gold display-1 mb-4">
                        <i class="bi bi-envelope-check"></i>
                    </div>
                    <h2 class="text-gold fw-bold mb-3">LIEN ENVOYÉ !</h2>
                    
                        <p class="text-white border border-sage rounded-0 p-3 bg-grad-subtle bg-opacity-10">
                        Un e-mail de récupération vient de vous être envoyé. Il contient un lien sécurisé valable pendant <strong>{{ tokenLifetime|date('H') }} heure(s)</strong>.
                    </p>

                    <p class="text-white-50 small mt-4">
                        Si vous ne recevez rien d'ici quelques minutes, vérifiez votre dossier de courriers indésirables (spams) ou <a href="{{ path('app_forgot_password_request') }}" class="text-gold text-decoration-none fw-bold">réessayez</a>.
                    </p>

                    <hr class="border-gold my-4">

                        <a href="{{ path('app_login') }}" class="btn btn-premium btn-sm px-4 rounded-0">
                        Retour à la page de connexion
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}