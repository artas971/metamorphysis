{% extends 'base.html.twig' %}

{% block title %}Réinitialiser mon mot de passe - Metamorphysis{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <div class="mb-4">
                <a href="{{ path('app_login') }}" class="text-gold text-decoration-none fw-bold">
                    <i class="bi bi-arrow-left"></i> Retour à la connexion
                </a>
            </div>

            <div class="card-premium shadow-lg">
                <div class="card-body p-5">
                    <h2 class="text-gold fw-bold text-center mb-3">MOT DE PASSE OUBLIÉ</h2>
                    <p class="text-white-50 text-center small mb-4">
                        Saisissez votre adresse email. Si elle correspond à un compte existant, nous vous enverrons un lien sécurisé pour créer un nouveau mot de passe.
                    </p>

                    {# Affichage des messages d'erreur spécifiques au bundle s'il y en a #}
                    {% for flash_error in app.flashes('reset_password_error') %}
                        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
                    {% endfor %}

                    {{ form_start(requestForm) }}
                        
                        <div class="mb-4">
                            {{ form_label(requestForm.email, 'Votre Adresse Email', {'label_attr': {'class': 'form-label text-white-50 fw-bold text-uppercase'}}) }}
                            {{ form_widget(requestForm.email, {'attr': {'class': 'form-control bg-grad-subtle text-white border-gold mt-2', 'placeholder': 'exemple@mail.com'}}) }}
                            <div class="text-danger mt-1 fw-bold">{{ form_errors(requestForm.email) }}</div>
                        </div>

                        <button type="submit" class="btn btn-premium w-100 fw-bold py-3 fs-5 mt-2 rounded-0">
                            RECEVOIR LE LIEN DE RÉCUPÉRATION
                        </button>

                    {{ form_end(requestForm) }}
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}