<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    {# SEO & Titre #}
    <title>{% block title %}Metamorphysis | Transformation & Accompagnement Sur-Mesure{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Metamorphysis vous accompagne dans votre cheminement personnel et la libération de vos schémas limitants. Séances et consultations sur-mesure.{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ app.request.uri }}{% endblock %}">
    
    {# Open Graph / Facebook / WhatsApp #}
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="Metamorphysis">
    <meta property="og:title" content="{% block og_title %}Metamorphysis | Accompagnement & Transformation Sur-Mesure{% endblock %}">
    <meta property="og:description" content="{% block og_description %}Un parcours d'accompagnement d'exception pour vous libérer des schémas limitants.{% endblock %}">
    <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/libellule.svg')) }}{% endblock %}">
    <meta property="og:url" content="{{ app.request.uri }}">

    {# Twitter Cards #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% block twitter_title %}Metamorphysis | Accompagnement & Transformation Sur-Mesure{% endblock %}">
    <meta name="twitter:description" content="{% block twitter_description %}Découvrez nos parcours d'accompagnement sur-mesure.{% endblock %}">
    <meta name="twitter:image" content="{% block twitter_image %}{{ absolute_url(asset('images/libellule.svg')) }}{% endblock %}">

    {% block meta %}{% endblock %}
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/libellule.svg') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}?v={{ 'now'|date('U') }}">
    
    <style>
        .dropdown-menu {
            background-color: var(--meta-black);
            border: 1px solid var(--meta-gold);
        }
        .dropdown-item:hover {
            background-color: var(--meta-plum);
            color: var(--meta-gold) !important;
        }
        .dropdown-item.text-danger:hover {
            background-color: rgba(220, 53, 69, 0.1);
        }
    </style>

    {% block stylesheets %}{% endblock %}
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>

    {# Données Structurées JSON-LD (Schema.org) #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HealthAndBeautyBusiness",
      "name": "Metamorphysis",
      "url": "{{ absolute_url(path('app_home')) }}",
      "logo": "{{ absolute_url(asset('images/libellule.svg')) }}",
      "description": "Accompagnement sur-mesure en développement personnel et libération des schémas limitants.",
      "priceRange": "€€"
    }
    </script>
</head>

<body>

    {# Lien d'évitement pour l'accessibilité #}
    <a href="#main-content" class="visually-hidden-focusable btn btn-gold position-fixed top-0 start-0 z-3 m-2 shadow">
        Aller au contenu principal
    </a>

    <header role="banner">
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top mb-4" style="background-color: #4F4F41;" aria-label="Navigation principale">
            <div class="container">
                
                <a class="navbar-brand text-gold typo-symbolic d-flex align-items-center gap-3" href="{{ path('app_home') }}" aria-label="Metamorphysis - Accueil">
                    <div class="navbar-dragonfly-container" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                        {% include 'partials/logo_nav.html.twig' with {'is_navbar': true} %}
                    </div>
                    <span class="d-none d-md-inline fs-4" style="letter-spacing: 2px;">METAMORPHYSIS</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Basculer la navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        
                        {{ render(controller('App\\Controller\\MenuController::renderDynamicNav')) }}

                        {% if app.user %}
                            <li class="nav-item dropdown ms-lg-4 mt-2 mt-lg-0">
                                <a class="nav-link dropdown-toggle btn-premium py-1 px-3" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Mon Compte
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="navbarDropdown">
                                    <li><span class="dropdown-item-text typo-citation" style="color: #FFFFF0;">Bonjour, {{ app.user.prenom|capitalize }}</span></li>
                                    <li><hr class="dropdown-divider border-sage"></li>
                                    <li><a class="dropdown-item text-ivory" href="{{ path('app_account') }}"><i class="bi bi-person-badge me-2 text-gold"></i>Mon tableau de bord</a></li>
                                    <li><hr class="dropdown-divider border-sage"></li>
                                    <li><a class="dropdown-item text-danger fw-bold" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Se déconnecter</a></li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item ms-lg-4 mt-2 mt-lg-0">
                                <a class="nav-link text-ivory nav-link-premium" href="{{ path('app_login') }}">Connexion</a>
                            </li>
                            <li class="nav-item mt-2 mt-lg-0 ms-2">
                                <a class="btn btn-gold btn-sm px-4 py-2" style="font-size: 0.75rem; letter-spacing: 0.1em;" href="{{ path('app_register') }}">S'inscrire</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="flex-grow-1" tabindex="-1">
        {% for label, messages in app.flashes %}
            <div class="container mt-4">
                {% for message in messages %}
                    <div class="alert alert-premium alert-dismissible fade show d-flex align-items-center shadow-lg" 
                         style="{% if label == 'warning' %}border-left: 4px solid #E5C78D; background-color: rgba(255, 193, 7, 0.15); color: #FFFFF0; border-radius: 4px;{% elseif label == 'danger' %}border-left: 4px solid #dc3545; background-color: rgba(220, 53, 69, 0.15); color: #FFFFF0; border-radius: 4px;{% else %}border-left: 4px solid var(--meta-gold); background-color: rgba(74, 79, 65, 0.45); color: #FFFFF0; border-radius: 4px;{% endif %}" 
                         role="alert">
                        {% if label == 'warning' %}
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3" style="color: #E5C78D;"></i>
                        {% elseif label == 'danger' %}
                            <i class="bi bi-x-circle-fill text-danger fs-4 me-3"></i>
                        {% else %}
                            <i class="bi bi-check-circle-fill text-gold fs-4 me-3"></i>
                        {% endif %}
                        <div class="flex-grow-1" style="font-size: 0.95rem; line-height: 1.5;">{{ message }}</div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    {{ render(controller('App\\Controller\\MenuController::renderDynamicFooter')) }}
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Gestionnaire interactif pour le déploiement de l'encart citation sur mobile et tablette (< 992px)
        document.addEventListener('DOMContentLoaded', function() {
            document.addEventListener('click', function(e) {
                const box = e.target.closest('.quote-aside-box');
                if (!box) return;
                
                // Uniquement actif en dessous de 992px (Mobile & Tablette)
                if (window.innerWidth >= 992) return;
                
                const isExpanded = box.classList.toggle('is-expanded');
                const header = box.querySelector('.quote-aside-header');
                if (header) {
                    header.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                }
                const label = box.querySelector('.quote-toggle-label');
                if (label) {
                    label.textContent = isExpanded ? 'Masquer la citation' : 'Afficher la citation';
                }
            });

            // Accessibilité clavier (Enter & Space)
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    const header = e.target.closest('.quote-aside-header');
                    if (header && window.innerWidth < 992) {
                        e.preventDefault();
                        header.click();
                    }
                }
            });
        });
    </script>
    {% block javascripts %}{% endblock %}

</body>
</html>