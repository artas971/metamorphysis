<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Metamorphysis | Thérapie et Accompagnement{% endblock %}</title>
        
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="d-flex flex-column min-vh-100">
        
        <nav class="navbar navbar-expand-lg navbar-dark py-3" style="background-color: transparent;">
            <div class="container">
                <a class="navbar-brand brand-logo text-gold fs-3" href="/">
                    METAMORPHYSIS
                </a>
                
                <button class="navbar-toggler border-gold text-gold" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-4">
                            <a class="nav-link text-light" href="/">Accueil</a>
                        </li>
                        <li class="nav-item me-4">
                            <a class="nav-link text-light" href="#">L'expérience</a>
                        </li>
                        <li class="nav-item me-4">
                            <a class="nav-link text-light" href="#">À propos</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-premium px-4 py-2" href="#">Réserver</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="flex-grow-1">
            {% block body %}{% endblock %}
        </main>

        <footer class="text-center py-4 mt-auto border-top border-secondary">
            <div class="container text-muted small">
                <p class="mb-1">&copy; {{ 'now'|date('Y') }} Metamorphysis. Tous droits réservés.</p>
            </div>
        </footer>
        
    </body>
</html>