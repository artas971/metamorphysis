<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Metamorphysis{% endblock %}</title>
     
    {# Ce bloc permettra aux pages dynamiques d'injecter leur propre description SEO #}
    {% block meta %}{% endblock %}
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    {# Ton fichier CSS Premium qui contient toute la DA #}
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    
    <style>
        /* On ne garde ici que les petits ajustements spécifiques au menu déroulant de Bootstrap */
        .dropdown-menu {
            background-color: var(--meta-black);
            border: 1px solid var(--meta-gold);
        }
        .dropdown-item:hover {
            background-color: var(--meta-plum);
            color: var(--meta-gold) !important;
        }
        .dropdown-item.text-danger:hover {
            background-color: rgba(220, 53, 69, 0.1);
        }
    </style>

    {% block stylesheets %}
    {% endblock %}
</head>
<body>

    {# La Navbar : Bordure Sauge fumée, fond transparent pour laisser voir le dégradé du body #}
    {# La Navbar : Plus de bordure, fond transparent, ultra épurée #}
    <nav class="navbar navbar-expand-lg navbar-dark mb-4" style="background: transparent;">
        <div class="container">
            <a class="navbar-brand text-gold typo-symbolic" href="{{ path('app_home') }}">METAMORPHYSIS</a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    
                    {{ render(controller('App\\Controller\\MenuController::renderDynamicNav')) }}
                    {# Liens fonctionnels existants #}
                    <li class="nav-item">
                        <a class="nav-link text-ivory nav-link-premium" href="{{ path('app_prestation_index') }}">Prestations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-ivory nav-link-premium" href="{{ path('app_contact') }}">Contact</a>
                    </li>

                    {# --- LOGIQUE TWIG : L'UTILISATEUR EST-IL CONNECTÉ ? --- #}
                     {% if app.user %}
                        <li class="nav-item dropdown ms-lg-4 mt-2 mt-lg-0">
                            
                            <a class="nav-link dropdown-toggle btn-premium py-1 px-3" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Mon Compte
                            </a>
                            
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="navbarDropdown">
                                <li><span class="dropdown-item-text text-gold typo-citation">Bonjour, {{ app.user.prenom }}</span></li>
                                <li><hr class="dropdown-divider border-sage"></li>
                                
                                <li><a class="dropdown-item text-ivory" href="{{ path('app_account') }}"><i class="bi bi-person-badge me-2 text-gold"></i>Mon tableau de bord</a></li>
                                <li><hr class="dropdown-divider border-sage"></li>
                                <li><a class="dropdown-item text-danger fw-bold" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Se déconnecter</a></li>
                            </ul>
                        </li>
                    {% else %}
                        {# Boutons pour les visiteurs non connectés #}
                        <li class="nav-item ms-lg-4 mt-2 mt-lg-0">
                            <a class="nav-link text-ivory nav-link-premium" href="/login">Connexion</a>
                        </li>
                        <li class="nav-item mt-2 mt-lg-0 ms-2">
                            <a class="btn btn-gold btn-sm px-4 py-2" style="font-size: 0.75rem; letter-spacing: 0.1em;" href="/register">S'inscrire</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        {# --- SYSTÈME D'AFFICHAGE DES MESSAGES FLASH --- #}
        <div class="container mt-4">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-premium alert-dismissible fade show d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle text-gold fs-4 me-3"></i>
                            <div>{{ message }}</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
        </div>

        {% block body %}{% endblock %}
    </main>

    {# Le Footer : Bordure et texte en Sauge fumée #}
    {{ render(controller('App\\Controller\\MenuController::renderDynamicFooter')) }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    {% block javascripts %}
    {% endblock %}
</body>
</html>