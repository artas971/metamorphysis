{% extends 'base.html.twig' %}

{% block title %}Réserver - {{ prestation.nom }}{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-dark border-warning shadow-lg" style="border-radius: 15px;">
                <div class="card-body p-5">
                    
                    <div class="text-center mb-4">
                        <h2 class="text-warning fw-bold" style="font-family: 'Impact', sans-serif;">RÉSERVER</h2>
                        <p class="text-white fs-5 mt-2">{{ prestation.nom }}</p>
                        <span class="badge bg-warning text-dark fs-6">{{ prestation.prix }} €</span>
                    </div>

                    {# Le Formulaire #}
                    {{ form_start(form) }}
                        <div class="mb-4 text-white">
                            {{ form_row(form.dateRendezVous) }}
                        </div>

                        <button type="submit" class="btn btn-warning w-100 fw-bold py-2" style="border-radius: 30px;">
                            CONFIRMER LA DEMANDE
                        </button>
                    {{ form_end(form) }}

                </div>
            </div>
            
            <div class="text-center mt-3">
                <a href="{{ path('app_prestation_show', {'id': prestation.id}) }}" class="text-secondary text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Retour aux détails
                </a>
            </div>
            
        </div>
    </div>
</div>
{% endblock %}