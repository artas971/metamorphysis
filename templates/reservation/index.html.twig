{% extends 'base.html.twig' %}

{% block title %}Réserver - {{ prestation.nom }}{% endblock %}

{# On charge la feuille de style et le script de Flatpickr directement pour cette page #}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-premium shadow-lg">
                <div class="card-body p-5">
                    
                    <div class="text-center mb-4">
                        <h2 class="text-gold fw-bold">RÉSERVER</h2>
                        <p class="text-white fs-5 mt-2 mb-1">{{ prestation.nom }}</p>
                        <p class="text-gold fs-4 mb-4">{{ prestation.prix }} €</p>
                    </div>

                    {{ form_start(form, {'attr': {'id': 'reservation-form'}}) }}
                        <div class="mb-4 text-start">
                            <label class="form-label text-sage fw-bold text-uppercase small">1. Choisissez une date</label>
                            
                            {# Le champ texte que Flatpickr va transformer #}
                            <input type="text" id="date-picker" class="form-control input-premium p-3 mb-4" placeholder="Sélectionnez une date..." required>
                            
                            <label class="form-label text-sage fw-bold text-uppercase small">2. Choisissez une heure</label>
                            
                            <div id="time-slots-container" class="d-flex flex-wrap gap-2 mb-3">
                                <span class="text-white-50 small fst-italic">Veuillez d'abord sélectionner une date.</span>
                            </div>

                            <div class="d-none">
                                {{ form_widget(form.dateRendezVous, {'attr': {'id': 'real-datetime-input'}}) }}
                            </div>
                        </div>

                        <button type="submit" id="submit-btn" class="btn btn-premium w-100 fw-bold py-2 rounded-pill" disabled>
                            CONFIRMER LA DEMANDE
                        </button>
                    {{ form_end(form) }}

                </div>
            </div>
            
            <div class="text-center mt-3">
                <a href="{{ path('app_prestation_show', {'id': prestation.id}) }}" class="text-secondary text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Retour aux détails
                </a>
            </div>
            
        </div>
    </div>
</div>

<style>
    /* Style premium de l'input de date */
    #date-picker {
        background-color: #11140F !important;
        color: #D8D0BE !important;
        border: 1px solid rgba(184, 154, 99, 0.4) !important;
    }
    #date-picker::placeholder {
        color: rgba(216, 208, 190, 0.4) !important; 
        font-style: italic;
    }

    /* =========================================
       FLATPICKR : INTEGRATION METAMORPHYSIS PROPRE
       ========================================= */
    .flatpickr-calendar {
        background: #23291E !important; 
        border: 1px solid #B89A63 !important; 
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6) !important;
        border-radius: 8px !important;
    }
    
    .flatpickr-months .flatpickr-month, 
    .flatpickr-current-month .flatpickr-monthDropdown-months,
    .flatpickr-current-month input.cur-year {
        color: #B89A63 !important; 
        font-weight: bold;
    }
    
    .flatpickr-prev-month svg, .flatpickr-next-month svg {
        fill: #B89A63 !important;
    }
    
    span.flatpickr-weekday {
        color: #D8D0BE !important; 
        opacity: 0.7;
    }
    
    .flatpickr-day {
        color: #D8D0BE !important; 
        border-radius: 6px !important;
    }
    
    .flatpickr-day:hover, .flatpickr-day:focus {
        background: rgba(184, 154, 99, 0.2) !important; 
        border-color: #B89A63 !important;
        color: #FFF !important;
    }
    
    .flatpickr-day.selected, .flatpickr-day.selected:hover {
        background: #4A1525 !important; 
        border-color: #B89A63 !important;
        color: #B89A63 !important;
        font-weight: bold;
    }
    
    .flatpickr-day.flatpickr-disabled, 
    .flatpickr-day.flatpickr-disabled:hover {
        color: rgba(216, 208, 190, 0.15) !important; 
        background: transparent !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const datePickerElement = document.getElementById('date-picker');
        const timeSlotsContainer = document.getElementById('time-slots-container');
        const realInput = document.querySelector('[name="reservation[dateRendezVous]"]'); 
        const submitBtn = document.getElementById('submit-btn');

        // On initialise Flatpickr !
        flatpickr(datePickerElement, {
            locale: "fr",
            minDate: "today",
            disableMobile: true,
            onChange: function(selectedDates, dateStr, instance) {
                
                timeSlotsContainer.innerHTML = '<span class="text-gold small"><i class="bi bi-hourglass-split"></i> Analyse des disponibilités...</span>';
                submitBtn.disabled = true;

                // Appel au serveur (qui ne plantera plus grâce à notre correction de la durée)
                fetch('/api/disponibilites/{{ prestation.id }}/' + dateStr)
                    .then(response => response.json())
                    .then(creneaux => {
                        timeSlotsContainer.innerHTML = '';

                        if (creneaux.length === 0) {
                            timeSlotsContainer.innerHTML = '<span class="text-white-50 small fst-italic"><i class="bi bi-calendar-x text-gold me-1"></i> Toutes nos disponibilités sont réservées pour cette date.</span>';
                            return;
                        }

                        creneaux.forEach(heure => {
                            const btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'btn rounded-pill px-4 py-2 text-gold border border-gold';
                            btn.style.transition = 'all 0.3s ease';
                            btn.textContent = heure;

                            btn.addEventListener('click', function() {
                                document.querySelectorAll('#time-slots-container button').forEach(b => {
                                    b.className = 'btn rounded-pill px-4 py-2 text-gold border border-gold';
                                    b.style.backgroundColor = 'transparent';
                                });
                                
                                this.className = 'btn rounded-pill px-4 py-2 text-dark border border-gold fw-bold';
                                this.style.backgroundColor = '#D4AF37';

                                realInput.value = dateStr + 'T' + heure;
                                submitBtn.disabled = false;
                            });

                            btn.addEventListener('mouseenter', function() {
                                if (!this.classList.contains('fw-bold')) {
                                    this.style.backgroundColor = 'rgba(212, 175, 55, 0.1)';
                                }
                            });
                            btn.addEventListener('mouseleave', function() {
                                if (!this.classList.contains('fw-bold')) {
                                    this.style.backgroundColor = 'transparent';
                                }
                            });

                            timeSlotsContainer.appendChild(btn);
                        });
                    })
                    .catch(error => {
                        timeSlotsContainer.innerHTML = '<span class="text-white-50 small"><i class="bi bi-exclamation-circle text-gold me-1"></i> Une erreur est survenue lors de la recherche des créneaux.</span>';
                    });
            }
        });
    });
</script>
{% endblock %}