{% extends 'base.html.twig' %}

{% block title %}Réserver - {{ prestation.nom }}{% endblock %}

{# On charge la feuille de style et le script de Flatpickr directement pour cette page #}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    
    {# REPOSITIONNEMENT : Bouton retour placé au-dessus de la carte, aligné à gauche #}
    <div class="row justify-content-center mb-3">
        <div class="col-md-8 col-lg-6">
            <a href="{{ path('app_account') }}" class="text-decoration-none transition-hover small text-uppercase" style="color: #B89A63; letter-spacing: 1px;">
                <i class="bi bi-arrow-left me-2"></i>Retour à mon espace
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            {# HARMONISATION : Intégration de la translucidité à 55%, flou de fond (blur) et fine bordure dorée #}
            <div class="card-premium shadow-lg" style="background-color: rgba(74, 79, 65, 0.55); border: 1px solid rgba(184, 154, 99, 0.2); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: 0;">
                <div class="card-body p-5">
                    
                    <div class="text-center mb-4 border-bottom pb-4" style="border-color: rgba(184, 154, 99, 0.2) !important;">
                        {# Titre et Prestation en OR #}
                        <h2 class="fw-bold typo-titre" style="color: #B89A63; letter-spacing: 2px;">RÉSERVER</h2>
                        <p class="fs-5 mt-2 mb-1" style="color: #B89A63; font-family: var(--font-title); text-transform: uppercase; letter-spacing: 1px;">
                            {% if seance is defined and seance.numero > 1 %}
                                Séance {{ seance.numero }} - {{ prestation.nom }}
                            {% else %}
                                {{ prestation.nom }}
                            {% endif %}
                        </p>
                        {# Prix en IVOIRE #}
                        <p class="fs-4 mb-0" style="color: #FFFFF0; opacity: 0.95;">{{ prestation.prix }} €</p>
                    </div>

                    {{ form_start(form, {'attr': {'id': 'reservation-form'}}) }}
                        <div class="mb-4 text-start">
                            
                            {# Label 1 en IVOIRE #}
                            <label class="form-label fw-bold text-uppercase small" style="color: #FFFFF0; letter-spacing: 1px;">1. Choisissez une date</label>
                            
                            {# Le champ texte que Flatpickr va transformer #}
                            <input type="text" id="date-picker" class="form-control input-premium p-3 mb-4" placeholder="Sélectionnez une date..." required>
                            
                            {# Label 2 en IVOIRE #}
                            <label class="form-label fw-bold text-uppercase small" style="color: #FFFFF0; letter-spacing: 1px;">2. Choisissez une heure</label>
                            
                            <div id="time-slots-container" class="d-flex flex-wrap gap-2 mb-3">
                                <span class="small fst-italic" style="color: #FFFFF0; opacity: 0.6;">Veuillez d'abord sélectionner une date.</span>
                            </div>

                            <div class="d-none">
                                {{ form_widget(form.dateRendezVous, {'attr': {'id': 'real-datetime-input'}}) }}
                            </div>
                        </div>

                        <button type="submit" id="submit-btn" class="btn btn-premium w-100 fw-bold py-3 rounded-0 text-uppercase" style="letter-spacing: 1px;" disabled>
                            CONFIRMER LA DEMANDE
                        </button>
                    {{ form_end(form) }}

                </div>
            </div>
            
        </div>
    </div>
</div>

<style>
    /* Style premium de l'input de date */
    #date-picker {
        background-color: rgba(10, 10, 9, 0.6) !important;
        color: #FFFFF0 !important;
        border: 1px solid rgba(184, 154, 99, 0.4) !important;
        border-radius: 0 !important;
    }
    #date-picker::placeholder {
        color: rgba(255, 255, 240, 0.4) !important; 
        font-style: italic;
    }

    /* =========================================
       FLATPICKR : CONFIGURATION SÉCURISÉE SUR LES VARIABLES DE LA CHARTE
       ========================================= */
    .flatpickr-calendar {
        background: var(--meta-olive) !important; 
        border: 1px solid var(--meta-gold) !important; 
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6) !important;
        border-radius: 0 !important;
        font-family: var(--font-body) !important;
    }
    
    .flatpickr-months .flatpickr-month, 
    .flatpickr-current-month .flatpickr-monthDropdown-months,
    .flatpickr-current-month input.cur-year {
        color: var(--meta-gold) !important; 
        font-family: var(--font-title) !important;
        font-weight: bold;
    }
    
    .flatpickr-prev-month svg, .flatpickr-next-month svg {
        fill: var(--meta-gold) !important;
    }
    
    span.flatpickr-weekday {
        color: #FFFFF0 !important; 
        opacity: 0.7;
    }
    
    .flatpickr-day {
        color: #FFFFF0 !important; 
        border-radius: 0 !important;
    }
    
    .flatpickr-day:hover, .flatpickr-day:focus {
        background: rgba(184, 154, 99, 0.2) !important; 
        border-color: var(--meta-gold) !important;
        color: #FFF !important;
    }
    
    .flatpickr-day.selected, .flatpickr-day.selected:hover {
        background: var(--meta-plum) !important; 
        border-color: var(--meta-gold) !important;
        color: var(--meta-gold) !important;
        font-weight: bold;
    }
    
    .flatpickr-day.flatpickr-disabled, 
    .flatpickr-day.flatpickr-disabled:hover {
        color: rgba(255, 255, 240, 0.15) !important; 
        background: transparent !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const datePickerElement = document.getElementById('date-picker');
        const timeSlotsContainer = document.getElementById('time-slots-container');
        const realInput = document.querySelector('[name="reservation[dateRendezVous]"]'); 
        const submitBtn = document.getElementById('submit-btn');

        // Calcul de la date limite : Aujourd'hui + 12 mois
        const dateLimite = new Date();
        dateLimite.setMonth(dateLimite.getMonth() + 12);

        flatpickr(datePickerElement, {
            locale: "fr",
            minDate: "today",
            maxDate: dateLimite, // <-- LA LIMITE EST APPLIQUÉE ICI
            disableMobile: true,
            onChange: function(selectedDates, dateStr, instance) {
                
                timeSlotsContainer.innerHTML = '<span class="small" style="color: #B89A63;"><i class="bi bi-hourglass-split"></i> Analyse des disponibilités...</span>';
                submitBtn.disabled = true;

                // Sélection dynamique de l'URL de l'API selon le contexte de la séance
                {% if seance is defined and seance.id %}
                    const apiUrl = '/api/disponibilites/seance/{{ seance.id }}/' + dateStr;
                {% else %}
                    const apiUrl = '/api/disponibilites/{{ prestation.id }}/' + dateStr;
                {% endif %}

                fetch(apiUrl)
                    .then(response => response.json())
                    .then(creneaux => {
                        timeSlotsContainer.innerHTML = '';

                        if (creneaux.length === 0) {
                            timeSlotsContainer.innerHTML = '<span class="small fst-italic" style="color: rgba(255, 255, 240, 0.6);"><i class="bi bi-calendar-x me-1" style="color: #B89A63;"></i> Toutes nos disponibilités sont réservées pour cette date.</span>';
                            return;
                        }

                        creneaux.forEach(heure => {
                            const btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'btn rounded-0 px-4 py-2 border border-gold';
                            btn.style.transition = 'all 0.3s ease';
                            
                            // Le texte par défaut en Ivoire
                            btn.style.color = '#FFFFF0'; 
                            btn.textContent = heure;

                            btn.addEventListener('click', function() {
                                document.querySelectorAll('#time-slots-container button').forEach(b => {
                                    b.className = 'btn rounded-0 px-4 py-2 border border-gold';
                                    b.style.backgroundColor = 'transparent';
                                    b.style.color = '#FFFFF0'; // Retour à l'Ivoire
                                    b.style.fontWeight = 'normal';
                                });
                                
                                this.className = 'btn rounded-0 px-4 py-2 border border-gold fw-bold';
                                this.style.backgroundColor = '#B89A63';
                                this.style.color = '#111'; // Texte sombre sur fond or

                                realInput.value = dateStr + 'T' + heure;
                                submitBtn.disabled = false;
                            });

                            btn.addEventListener('mouseenter', function() {
                                if (!this.classList.contains('fw-bold')) {
                                    this.style.backgroundColor = 'rgba(184, 154, 99, 0.1)';
                                }
                            });
                            btn.addEventListener('mouseleave', function() {
                                if (!this.classList.contains('fw-bold')) {
                                    this.style.backgroundColor = 'transparent';
                                }
                            });

                            timeSlotsContainer.appendChild(btn);
                        });
                    })
                    .catch(error => {
                        timeSlotsContainer.innerHTML = '<span class="small fst-italic" style="color: rgba(255, 255, 240, 0.6);"><i class="bi bi-exclamation-circle me-1" style="color: #B89A63;"></i> Une erreur est survenue lors de la recherche des créneaux.</span>';
                    });
            }
        });
    });
</script>
{% endblock %}