{% extends 'base.html.twig' %}

{% block title %}Réserver - {{ prestation.nom }}{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-premium shadow-lg">
                <div class="card-body p-5">
                    
                    <div class="text-center mb-4">
                        <h2 class="text-gold fw-bold">RÉSERVER</h2>
                        <p class="text-white fs-5 mt-2 mb-1">{{ prestation.nom }}</p>
                        {# Le prix affiché proprement en Or #}
                        <p class="text-gold fs-4 mb-4">{{ prestation.prix }} €</p>
                    </div>

                    {# Le Formulaire #}
                    {{ form_start(form) }}
                        <div class="mb-4 text-start">
                            {# 1. Le Label personnalisé en Sauge #}
                            {{ form_label(form.dateRendezVous, 'Choisissez une date et une heure', {
                                'label_attr': {'class': 'form-label text-sage fw-bold text-uppercase small'}
                            }) }}
                            
                            {# 2. Le Champ (Widget) personnalisé avec input-premium #}
                            {{ form_widget(form.dateRendezVous, {
                                'attr': {
                                    'class': 'form-control input-premium p-3'
                                }
                            }) }}
                            
                            {# 3. L'affichage des erreurs #}
                            <div class="text-danger mt-1 small">
                                {{ form_errors(form.dateRendezVous) }}
                            </div>
                        </div>

                        <button type="submit" class="btn btn-premium w-100 fw-bold py-2 rounded-pill">
                            CONFIRMER LA DEMANDE
                        </button>
                    {{ form_end(form) }}

                </div>
            </div>
            
            <div class="text-center mt-3">
                <a href="{{ path('app_prestation_show', {'id': prestation.id}) }}" class="text-secondary text-decoration-none">
                    <i class="bi bi-arrow-left"></i> Retour aux détails
                </a>
            </div>
            
        </div>
    </div>
</div>
{% endblock %}