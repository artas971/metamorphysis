{% extends 'base.html.twig' %}

{% block title %}Accueil - Metamorphysis{% endblock %}

{% block body %}
<section class="container py-5 mt-5">
    
    <div class="mb-5">
        <span class="text-sage text-uppercase" style="letter-spacing: 2px; font-size: 0.8rem;">Votre cheminement</span>
        <h2 class="text-ivory fw-light mt-2" style="font-size: 2.5rem; max-width: 600px;">
            Un processus de transformation en quatre étapes.
        </h2>
    </div>

    <div class="row g-4 justify-content-center position-relative pt-4">
        
        {# Trait horizontal recalibré au centre exact pour 4 colonnes #}
        <div class="d-none d-lg-block position-absolute" style="top: 59px; left: 12.5%; width: 75%; height: 1px; background: rgba(184, 154, 99, 0.3); z-index: 0;"></div>

        {# Étape 01 #}
        <div class="col-12 col-md-6 col-lg-3 text-center position-relative z-1">
            <div class="mb-3">
                {# Changement de background-color pour var(--meta-olive) #}
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive);">
                    <i class="bi bi-eye text-gold fs-3"></i>
                </div>
            </div>
            <div class="text-gold typo-symbolic mb-1">01</div>
            <h4 class="text-ivory fs-6 letter-spacing-1 mb-3">OBSERVER</h4>
            <p class="text-sage small px-2">Prendre conscience de ce qui se répète et de ses impacts.</p>
        </div>

        {# Étape 02 #}
        <div class="col-12 col-md-6 col-lg-3 text-center position-relative z-1">
            <div class="mb-3">
                {# Changement de background-color pour var(--meta-olive) #}
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive);">
                    <i class="bi bi-search text-gold fs-3"></i>
                </div>
            </div>
            <div class="text-gold typo-symbolic mb-1">02</div>
            <h4 class="text-ivory fs-6 letter-spacing-1 mb-3">COMPRENDRE</h4>
            <p class="text-sage small px-2">Mettre en lumière les mécanismes inconscients qui influencent vos choix.</p>
        </div>

        {# Étape 03 #}
        <div class="col-12 col-md-6 col-lg-3 text-center position-relative z-1">
            <div class="mb-3">
                {# Changement de background-color pour var(--meta-olive) #}
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive);">
                    <i class="bi bi-flower1 text-gold fs-3"></i>
                </div>
            </div>
            <div class="text-gold typo-symbolic mb-1">03</div>
            <h4 class="text-ivory fs-6 letter-spacing-1 mb-3">TRANSFORMER</h4>
            <p class="text-sage small px-2">Construire de nouvelles réponses et sortir des schémas limitants.</p>
        </div>

        {# Étape 04 #}
        <div class="col-12 col-md-6 col-lg-3 text-center position-relative z-1">
            <div class="mb-3">
                {# Changement de background-color pour var(--meta-olive) #}
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive);">
                    <i class="bi bi-brightness-high text-gold fs-3"></i>
                </div>
            </div>
            <div class="text-gold typo-symbolic mb-1">04</div>
            <h4 class="text-ivory fs-6 letter-spacing-1 mb-3">S'ALIGNER</h4>
            <p class="text-sage small px-2">Retrouver une coherence intérieure et avancer avec plus de liberté et de sens.</p>
        </div>

    </div>
</section>

<section class="container py-5 mt-5">
    <div class="row align-items-center g-5">
        
        <div class="col-lg-5">
            <h2 class="text-ivory fw-light mb-4" style="font-size: 2.8rem; line-height: 1.3;">
                Chaque transformation<br>
                <span class="text-gold">commence par</span><br>
                une rencontre.
            </h2>
            
            <p class="text-sage mb-4">Chaque parcours est unique.</p>
            
            <p class="text-sage mb-4">
                Certaines personnes viennent avec une problématique précise. D'autres ressentent simplement qu'un schéma se répète sans parvenir à l'expliquer.
            </p>
            
            <p class="text-sage mb-5">
                Lors de la première rencontre, nous prenons le temps de comprendre votre situation afin de définir ensemble le rythme et l'orientation de l'accompagnement.
            </p>
            
            <a href="{{ path('app_prestation_index') }}" class="btn btn-outline-gold px-4 py-2 text-uppercase rounded-0" style="letter-spacing: 2px; font-size: 0.8rem;">
                PRENDRE RENDEZ-VOUS <i class="bi bi-star text-gold fs-5 align-middle ms-2"></i>
            </a>
        </div>

    <div class="col-lg-7 mt-5 mt-lg-0">
    
    <div class="d-flex shadow-lg" style="border-radius: 4px; overflow: hidden; width: 100%;">

        <img src="{{ asset('images/fauteuils.jpg') }}" 
             alt="Espace de consultation Metamorphysis" 
             class="img-fluid" 
             style="flex: 1; min-width: 0; width: 100%; height: auto; object-fit: cover; display: block;">

        <div class="d-none d-md-block" 
             style="flex: 0 0 45px; background-color: var(--meta-olive); height: auto;">
        </div>
        
    </div>
    
</div>
</section>

<section class="container py-5 mt-5 mb-5">
    
    <div class="mb-5">
        <h2 class="text-ivory fw-light mb-2" style="font-size: 2.5rem;">
            Les espaces d'accompagnement
        </h2>
        <p class="text-sage">Différentes modalités pour répondre à vos besoins.</p>
    </div>

    {% set nb_prestations = prestations|length %}

    <div class="prestation-slider-container position-relative {% if nb_prestations > 5 %}px-5{% else %}px-5 px-lg-0{% endif %}">
        
        {% if nb_prestations > 1 %}
            <button class="slider-btn position-absolute start-0 {% if nb_prestations <= 5 %}d-lg-none{% endif %}" id="btn-prev" aria-label="Précédent" style="top: 50%; transform: translateY(-50%); z-index: 10; background-color: var(--meta-black);">
                <i class="bi bi-chevron-left"></i>
            </button>
        {% endif %}

        <div class="prestation-track {% if nb_prestations <= 5 %}justify-content-lg-center{% endif %}" id="slider-track">
            
            {% for prestation in prestations %}
                <div class="prestation-card-item">
                    <div class="card h-100 rounded-0 text-center d-flex flex-column" style="background-color: transparent; border: 1px solid rgba(184, 154, 99, 0.3); padding: 2rem 1rem;">
                        
                        {# 1. Icône de profil dynamique entourée d'un cercle doré #}
                        <div class="mb-4 mt-2 d-flex justify-content-center">
                            <div class="rounded-circle border border-gold d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; background-color: rgba(184, 154, 99, 0.02);">
                                <i class="bi {{ prestation.icone|default('bi-person') }} text-gold fs-4"></i>
                            </div>
                        </div>

                        {# 2. Titre de la carte #}
                        <h3 class="text-gold fs-6 text-uppercase mb-2" style="letter-spacing: 1px; font-family: var(--font-title), serif; min-height: 40px; display: flex; align-items: center; justify-content: center;">
                            {{ prestation.nom }}
                        </h3>

                        {# 3. Le petit trait séparateur doré discret #}
                        <hr class="mx-auto mb-4" style="width: 35px; height: 1px; background-color: var(--meta-gold); border: none; opacity: 0.4;">

                        {# 4. Description nettoyée #}
                        {% set desc_clean = prestation.description|striptags|replace({'&nbsp;': ' '}) %}
                        <p class="text-sage small flex-grow-1 px-1 mb-4" style="font-size: 0.8rem; line-height: 1.5;">
                            {{ desc_clean|length > 90 ? desc_clean|slice(0, 90) ~ '...' : desc_clean }}
                        </p>

                        {# 5. Prix avec unité dynamique (ex: SÉANCE, FORFAIT, MOIS) #}
                        <p class="text-gold small mb-4" style="letter-spacing: 1px; font-size: 0.85rem;">
                            {{ prestation.prix }} € / {{ prestation.unitePrix|default('SÉANCE')|upper }}
                        </p>

                        <div class="mt-auto">
                            <a href="{{ path('app_prestation_show', {'id': prestation.id}) }}" class="d-inline-block w-100 text-gold small text-decoration-none text-uppercase py-2" style="letter-spacing: 1px; background-color: var(--meta-pourpre, #21141C); transition: all 0.3s ease;">
                                DÉCOUVRIR <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
            
        </div>

        {% if nb_prestations > 1 %}
            <button class="slider-btn position-absolute end-0 {% if nb_prestations <= 5 %}d-lg-none{% endif %}" id="btn-next" aria-label="Suivant" style="top: 50%; transform: translateY(-50%); z-index: 10; background-color: var(--meta-black);">
                <i class="bi bi-chevron-right"></i>
            </button>
        {% endif %}
    </div>

{# Bandeau d'information pratique encadré #}
    <div class="d-flex flex-column flex-md-row align-items-md-center gap-4 p-4 mt-5" 
         style="background: var(--grad-subtle); border: 1px solid rgba(184, 154, 99, 0.3); border-radius: var(--radius-card);">
        
        <div class="border border-gold rounded-circle d-flex align-items-center justify-content-center p-2" 
             style="width: 50px; height: 50px; flex-shrink: 0; background-color: rgba(10, 10, 9, 0.2);">
            <i class="bi bi-flower1 text-gold fs-4"></i>
        </div>
        
        <p class="text-ivory small mb-0 flex-grow-1 text-center text-md-start">
            Le rythme et la durée de l'accompagnement sont définis ensemble lors de la première rencontre, en fonction de vos besoins et de vos objectifs.
        </p>
        
        <a href="#" class="text-gold small text-decoration-none text-uppercase ms-md-auto text-nowrap" 
           style="letter-spacing: 1px; font-weight: 500;">
            En savoir plus <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    
    <div class="text-center mt-5">
        <span class="text-sage text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">Les séances ne sont pas remboursées par la sécurité sociale.</span>
    </div>
</section>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const track = document.getElementById('slider-track');
            const btnPrev = document.getElementById('btn-prev');
            const btnNext = document.getElementById('btn-next');

            if (track && btnPrev && btnNext) {
                btnNext.addEventListener('click', () => {
                    // Calcule dynamiquement la largeur d'une carte + le gap de 15px
                    const card = document.querySelector('.prestation-card-item');
                    const scrollAmount = card.offsetWidth + 15; 
                    track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });

                btnPrev.addEventListener('click', () => {
                    const card = document.querySelector('.prestation-card-item');
                    const scrollAmount = card.offsetWidth + 15;
                    track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                });
            }
        });
    </script>
{% endblock %}