{% extends 'base.html.twig' %}

{% block title %}Accueil - Metamorphysis{% endblock %}

{% block body %}
    {# SECTION 1 : HÉROS & PROCESSUS #}
    <section class="container py-5 mt-5" aria-labelledby="heading-processus">
        <header class="mb-5 text-center">
            {# Le surtitre devient un <span> pour ne pas voler la vedette SEO au H1 #}
            <span class="text-uppercase fw-bold d-block mb-2" style="color: var(--meta-gold, #B89A63); letter-spacing: 3px; font-size: 0.85rem;">
                Bienvenue chez Metamorphysis
            </span>

            {# Le H1 contient l'intention principale #}
            <h1 id="heading-processus" class="fw-light mt-2 mb-3" style="color: var(--meta-gold, #B89A63); font-size: 2.8rem; line-height: 1.3;">
                Votre cheminement vers la transformation
            </h1>

            <p class="lead mx-auto" style="color: var(--meta-ivory, #FFFFF0); opacity: 0.9; font-size: 1.25rem; max-width: 650px;">
                Un processus d'accompagnement sur-mesure en quatre étapes pour vous libérer des schémas limitants.
            </p>
        </header>
     
        <div class="row g-4 justify-content-center position-relative pt-4">
            
            <div class="d-none d-lg-block position-absolute" style="top: 59px; left: 12.5%; width: 75%; height: 1px; background: rgba(184, 154, 99, 0.3); z-index: 0;" aria-hidden="true"></div>

            {# Étape 01 - Utilisation de <article> au lieu de <div> pour le SEO #}
            <article class="col-12 col-md-6 col-lg-3 text-center position-relative z-1">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive);">
                        <i class="bi bi-eye text-gold fs-3" aria-hidden="true"></i>
                    </div>
                </div>
                <span class="text-gold typo-symbolic mb-1 d-block fw-bold" aria-hidden="true">01</span>
                <h2 class="fs-6 letter-spacing-1 mb-3 text-uppercase" style="color: #FFFFF0;">Observer</h2>
                <p class="small px-2" style="color: #FFFFF0; opacity: 0.85;">Prendre conscience de ce qui se répète et de ses impacts.</p>
            </article>

            {# Étape 02 #}
            <article class="col-12 col-md-6 col-lg-3 text-center position-relative z-1">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive);">
                        <i class="bi bi-search text-gold fs-3" aria-hidden="true"></i>
                    </div>
                </div>
                <span class="text-gold typo-symbolic mb-1 d-block fw-bold" aria-hidden="true">02</span>
                <h2 class="fs-6 letter-spacing-1 mb-3 text-uppercase" style="color: #FFFFF0;">Comprendre</h2>
                <p class="small px-2" style="color: #FFFFF0; opacity: 0.85;">Mettre en lumière les mécanismes inconscients qui influencent vos choix.</p>
            </article>

            {# Étape 03 #}
            <article class="col-12 col-md-6 col-lg-3 text-center position-relative z-1">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive);">
                        <i class="bi bi-flower1 text-gold fs-3" aria-hidden="true"></i>
                    </div>
                </div>
                <span class="text-gold typo-symbolic mb-1 d-block fw-bold" aria-hidden="true">03</span>
                <h2 class="fs-6 letter-spacing-1 mb-3 text-uppercase" style="color: #FFFFF0;">Transformer</h2>
                <p class="small px-2" style="color: #FFFFF0; opacity: 0.85;">Construire de nouvelles réponses et sortir des schémas limitants.</p>
            </article>

            {# Étape 04 #}
            <article class="col-12 col-md-6 col-lg-3 text-center position-relative z-1">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-gold" style="width: 70px; height: 70px; background-color: var(--meta-olive);">
                        <i class="bi bi-brightness-high text-gold fs-3" aria-hidden="true"></i>
                    </div>
                </div>
                <span class="text-gold typo-symbolic mb-1 d-block fw-bold" aria-hidden="true">04</span>
                <h2 class="fs-6 letter-spacing-1 mb-3 text-uppercase" style="color: #FFFFF0;">S'aligner</h2>
                <p class="small px-2" style="color: #FFFFF0; opacity: 0.85;">Retrouver une cohérence intérieure et avancer avec plus de liberté et de sens.</p>
            </article>

        </div>
    </section>

    {# SECTION 2 : RENCONTRE #}
    <section class="container py-5 mt-5" aria-labelledby="heading-rencontre">
        <div class="row align-items-center g-5">
            
            <div class="col-lg-5">
                <h2 id="heading-rencontre" class="fw-light mb-4" style="color: #B89A63; font-size: 2.8rem; line-height: 1.3;">
                    Chaque transformation<br>
                    commence par<br>
                    une rencontre.
                </h2>
                
                <p class="fw-bold mb-4" style="color: #B89A63; font-size: 1.1rem;">Chaque parcours est unique.</p>
                
                <p class="mb-4" style="color: #FFFFF0; opacity: 0.85; line-height: 1.6;">
                    Certaines personnes viennent avec une problématique précise. D'autres ressentent simplement qu'un schéma se répète sans parvenir à l'expliquer.
                </p>
                
                <p class="mb-5" style="color: #FFFFF0; opacity: 0.85; line-height: 1.6;">
                    Lors de la première rencontre, nous prenons le temps de comprendre votre situation afin de définir ensemble le rythme et l'orientation de l'accompagnement.
                </p>
                
                <a href="{{ path('app_prestation_index') }}" title="Prendre rendez-vous" class="btn btn-outline-gold px-4 py-2 text-uppercase rounded-0 transition-hover" style="letter-spacing: 2px; font-size: 0.8rem;">
                    PRENDRE RENDEZ-VOUS <i class="bi bi-star text-gold fs-5 align-middle ms-2" aria-hidden="true"></i>
                </a>
            </div>

            <div class="col-lg-7 mt-5 mt-lg-0">
                <div class="d-flex shadow-lg" style="border-radius: 0; overflow: hidden; width: 100%;">
                    {# Ajout des attributs SEO essentiels sur l'image #}
                    <img src="{{ asset('images/fauteuils.jpg') }}" 
                         alt="Espace de consultation Metamorphysis" 
                         loading="lazy"
                         width="800"
                         height="600"
                         class="img-fluid" 
                         style="flex: 1; min-width: 0; width: 100%; height: auto; object-fit: cover; display: block;">

                    <div class="d-none d-md-block" 
                         style="flex: 0 0 45px; background-color: var(--meta-olive); height: auto;" aria-hidden="true">
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# SECTION 3 : PRESTATIONS #}
    <section class="container py-5 mt-5 mb-5" aria-labelledby="heading-espaces">
        
        {# Le conteneur header gère maintenant le centrage de toute la section #}
        <header class="mb-5 text-center">
            <h2 id="heading-espaces" class="fw-light mb-2" style="color: var(--meta-gold, #B89A63); font-size: 2.5rem;">
                Les espaces d'accompagnement
            </h2>
            
            <p class="mx-auto" style="color: var(--meta-gold, #B89A63); font-size: 1.1rem; max-width: 600px;">
                Différentes modalités pour répondre à vos besoins spécifiques.
            </p>
        </header>

        {% set nb_prestations = prestations|length %}

        <div class="prestation-slider-container position-relative {% if nb_prestations > 5 %}px-5{% else %}px-5 px-lg-0{% endif %}">
            
            {% if nb_prestations > 1 %}
                <button class="slider-btn position-absolute start-0 {% if nb_prestations <= 5 %}d-lg-none{% endif %}" id="btn-prev" aria-label="Précédent" style="top: 50%; transform: translateY(-50%); z-index: 10; background-color: var(--meta-black);">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
            {% endif %}

            <div class="prestation-track {% if nb_prestations <= 5 %}justify-content-lg-center{% endif %}" id="slider-track" role="region" aria-label="Carrousel des accompagnements">
                
                {% for prestation in prestations %}
                    <article class="prestation-card-item">
                        {% include 'prestation/_card.html.twig' with {'prestation': prestation} %}
                    </article>
                {% endfor %}
                
            </div>

            {% if nb_prestations > 1 %}
                <button class="slider-btn position-absolute end-0 {% if nb_prestations <= 5 %}d-lg-none{% endif %}" id="btn-next" aria-label="Suivant" style="top: 50%; transform: translateY(-50%); z-index: 10; background-color: var(--meta-black);">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            {% endif %}
        </div>

        <aside class="d-flex flex-column flex-md-row align-items-md-center gap-4 p-4 mt-5" 
             style="background: var(--grad-subtle); border: 1px solid rgba(184, 154, 99, 0.3); border-radius: 0;">
            
            <div class="border border-gold rounded-0 d-flex align-items-center justify-content-center p-2" 
                 style="width: 50px; height: 50px; flex-shrink: 0; background-color: rgba(10, 10, 9, 0.2);">
                <i class="bi bi-flower1 text-gold fs-4" aria-hidden="true"></i>
            </div>
            
            <p class="small mb-0 flex-grow-1 text-center text-md-start" style="color: #FFFFF0; opacity: 0.9;">
                Le rythme et la durée de l'accompagnement sont définis ensemble lors de la première rencontre, en fonction de vos besoins et de vos objectifs.
            </p>
            
            <a href="{{ path('app_prestation_index') }}" class="text-gold small text-decoration-none text-uppercase ms-md-auto text-nowrap transition-hover" 
               style="letter-spacing: 1px; font-weight: 500;">
                En savoir plus <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
            </a>
        </aside>
        
        <footer class="text-center mt-5">
            <small class="text-uppercase" style="color: #FFFFF0; opacity: 0.5; font-size: 0.65rem; letter-spacing: 1px;">
                Les séances ne sont pas remboursées par la sécurité sociale.
            </small>
        </footer>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const track = document.getElementById('slider-track');
            const btnPrev = document.getElementById('btn-prev');
            const btnNext = document.getElementById('btn-next');

            if (track && btnPrev && btnNext) {
                btnNext.addEventListener('click', () => {
                    const card = document.querySelector('.prestation-card-item');
                    if(card) {
                        const scrollAmount = card.offsetWidth + 15; 
                        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                    }
                });

                btnPrev.addEventListener('click', () => {
                    const card = document.querySelector('.prestation-card-item');
                    if(card) {
                        const scrollAmount = card.offsetWidth + 15;
                        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                    }
                });
            }
        });
    </script>
{% endblock %}