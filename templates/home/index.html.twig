{% extends 'base.html.twig' %}

{% block title %}Accueil - Metamorphysis{% endblock %}

{% block body %}
<div class="d-flex justify-content-center align-items-center vh-100 bg-black overflow-hidden">    
    <a href="{{ path('app_prestation_index') }}" class="logo-link" style="display: block; width: 100%; text-decoration: none;">{# On inclut le fichier contenant le logo SVG #}
{{ include('partials/beta.html.twig') }}
