{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
<style>
    /* Le Vitrail : On colorie les 10 morceaux du nouveau fichier */
    .libellule-logo path:nth-child(1) { fill: red !important; }
    .libellule-logo path:nth-child(2) { fill: blue !important; }
    .libellule-logo path:nth-child(3) { fill: lime !important; }
    .libellule-logo path:nth-child(4) { fill: orange !important; }
    .libellule-logo path:nth-child(5) { fill: purple !important; }
    .libellule-logo path:nth-child(6) { fill: cyan !important; }
    .libellule-logo path:nth-child(7) { fill: pink !important; }
    .libellule-logo path:nth-child(8) { fill: brown !important; }
    .libellule-logo path:nth-child(9) { fill: yellow !important; }
    .libellule-logo path:nth-child(10) { fill: white !important; }
</style>
<div class="logo-container text-center mb-5">
    
    {{ include('partials/logo.html.twig') }}
    
</div>
<section class="container mt-5 pt-5">
    <h2 class="text-center text-or mb-5 fw-bold">Nos Prestations</h2>
    
    <div class="row g-4">
        {# On boucle sur chaque prestation trouvée dans la base de données #}
        {% for prestation in prestations %}
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 bg-dark border-secondary text-light shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title text-or fw-bold">{{ prestation.nom }}</h4>
                        
                        <p class="card-text mt-3 flex-grow-1">
                            {{ prestation.description }}
                        </p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary">
                            <span class="fs-5 fw-bold">{{ prestation.prix }} €</span>
                            <span class="text-muted small"><i class="fas fa-clock"></i> {{ prestation.duree }} min</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 text-center">
                        <a href="#" class="btn btn-outline-warning w-100">Réserver cette séance</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center text-muted">
                <p>Aucune prestation n'est disponible pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</section>

</div>

{% endblock %}
