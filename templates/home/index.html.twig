{% extends 'base.html.twig' %}

{% block title %}Metamorphysis - Consulting en Relation Humaines{% endblock %}

{% block body %}
<main class="d-flex flex-column justify-content-center align-items-center min-vh-100 py-5 text-center overflow-hidden position-relative z-1">
    
    {# Le grand Logo animé connecté à la navigation #}
    <a href="{{ path('app_accueil') }}" class="logo-link mb-3" title="Accéder au site Metamorphysis">
        {{ include('partials/logo2.html.twig') }}
    </a>

    {# Titre METAMORPHYSIS généré plus bas sous le symbole #}
    <h1 class="text-gold typo-titre text-uppercase fw-normal mb-3" style="font-size: 2.2rem; letter-spacing: 7px; color: var(--meta-gold);">
        METAMORPHYSIS
    </h1>

    {# Textes d'ouverture conformes à la capture V1 client #}
    <header class="intro-text-container px-4" style="max-width: 650px;">
        
        {# Sous-titre officiel #}
        <div class="text-gold text-uppercase fw-bold mb-3" style="font-size: 0.8rem; letter-spacing: 3px;">
            ◆ CONSULTING EN RELATION HUMAINES ◆
        </div>

        {# Séparateur vertical #}
        <div class="d-flex justify-content-center my-3" aria-hidden="true">
            <div style="width: 1px; height: 20px; background-color: var(--meta-gold); opacity: 0.5;"></div>
        </div>
        
        {# Citation grecque #}
        <div class="typo-symbolic text-gold fs-5 mb-1" style="letter-spacing: 3px;">
            - γνῶθι σεαυτόν -
        </div>
        
        <div class="text-gold text-uppercase fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 3px;">
            CONNAIS-TOI TOI-MÊME
        </div>

        {# Ornement vertical et diamant étincelant #}
        <div class="d-flex flex-column align-items-center my-3" aria-hidden="true">
            <div style="width: 1px; height: 16px; background-color: var(--meta-gold); opacity: 0.5;"></div>
            <div class="text-gold" style="font-size: 0.55rem; margin: -2px 0;">◆</div>
            <div style="width: 1px; height: 16px; background-color: var(--meta-gold); opacity: 0.5;"></div>
        </div>

        {# Phrase d'impact officielle V1 #}
        <p class="text-ivory typo-titre fst-italic h5 fw-light mb-4" style="font-size: 1.25rem; line-height: 1.7; letter-spacing: 1px;">
            Certains schémas ne disparaissent pas.<br>
            Ils se répètent jusqu'à être compris.
        </p>

        {# Bouton ENTRER #}
        <div class="my-4">
            <a href="{{ path('app_accueil') }}" class="btn btn-outline-gold px-5 py-2 text-uppercase rounded-0 transition-hover" style="letter-spacing: 3px; font-size: 0.85rem; font-weight: 500;">
                ENTRER
            </a>
        </div>

        {# Flèche vers le bas #}
        <div class="mt-1">
            <a href="{{ path('app_accueil') }}" class="text-gold text-decoration-none fs-4 opacity-75 d-inline-block" style="transition: transform 0.3s ease;" title="Découvrir la suite">
                ↓
            </a>
        </div>

        {# Texte sous la flèche #}
        <div class="text-gold text-uppercase mt-2 typo-titre" style="font-size: 0.95rem; letter-spacing: 3px; opacity: 0.95;">
            Se reconnecter à sa nature profonde
        </div>

    </header>

</main>

<style>
    .logo-link {
        display: block; 
        width: 100%; 
        max-width: 480px;
        text-decoration: none;
        transition: transform 0.5s ease-in-out, filter 0.5s ease-in-out;
        cursor: pointer;
    }

    .logo-link:hover {
        transform: scale(1.03);
        filter: drop-shadow(0 0 30px rgba(184, 154, 99, 0.4)); 
    }

    .intro-text-container {
        animation: fadeInText 1.5s ease-in-out;
    }

    @keyframes fadeInText {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}