{% extends 'base.html.twig' %}

{% block title %}Accueil - Metamorphysis{% endblock %}

{% block body %}
{# On a retiré "bg-black" pour laisser apparaître le sublime dégradé organique défini dans app.css #}
<div class="d-flex justify-content-center align-items-center vh-100 overflow-hidden">    
    <a href="{{ path('app_prestation_index') }}" class="logo-link">
        {# On inclut le fichier contenant le logo SVG #}
        {{ include('partials/logo2.html.twig') }}
    </a>
</div>

<style>
    .logo-link {
        display: block; 
        width: 100%; 
        text-decoration: none;
        transition: transform 0.5s ease-in-out, filter 0.5s ease-in-out;
        cursor: pointer;
    }

    .logo-link:hover {
        transform: scale(1.03); /* Un léger zoom plus doux (0.5s) pour le côté organique */
        /* On remplace le vieux jaune par l'Or Antique Premium avec tes valeurs RGB exactes */
        filter: drop-shadow(0 0 30px rgba(184, 154, 99, 0.3)); 
    }
</style>
{% endblock %}